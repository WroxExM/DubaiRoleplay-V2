		case THREAD_LOAD_GGARAGE:
		{
			new loaded;

			for(new row = 0; row < rows && loaded < MAX_GGARAGE; row++)
			{
				new slot = -1;

				for(new i = 0; i < MAX_GGARAGE; i++)
				{
					if(!GGInfo[i][ggExists])
					{
						slot = i;
						break;
					}
				}

				if(slot == -1)
				{
					break;
				}

				cache_get_value_name_int(row, "id", GGInfo[slot][ggID]);
				cache_get_value_name_int(row, "gangid", GGInfo[slot][ggGang]);
				cache_get_value_name_float(row, "pos_x", GGInfo[slot][ggPosX]);

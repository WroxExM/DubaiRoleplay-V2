				PlayerTextDrawSetString(playerid, PHONEGPAYMAINSCREEN[playerid][67], str);
				PlayerTextDrawShow(playerid, PHONEGPAYMAINSCREEN[playerid][67]);

				SCMf(playerid, COLOR_GREEN, "Amount set to %s.", FormatNumber(amount));
			}
		}

	if(playertextid == ATMWITHDRAW[playerid][45]) // WITHDRAW AMOUNT
	{
		new string[144];
		format(string, sizeof(string), "How much would you like to withdraw? (Your account balance is %s.)", FormatNumber(PlayerInfo[playerid][pBank]));
		ShowPlayerDialog(playerid, DIALOG_ATMWITHDRAWAMOUNT, DIALOG_STYLE_INPUT, ""SVRCLR"Withdraw Amount", string, "Enter", "Cancel");

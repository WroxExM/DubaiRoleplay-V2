	switch(dialogid)
	{
	    case DIALOG_TCONFIGURE_MAIN:
		{
			if(!response) return 1;
			new turfid = GetAdvancedTurfByListIndex(listitem);
			if(turfid == -1) return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid turf selection.");
			pConfiguringTurf[playerid] = turfid;
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
		case DIALOG_TCONFIGURE_MODE:
		{
			new turfid = pConfiguringTurf[playerid];
			if(!response) return ShowAdvTurfConfigList(playerid);
			if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid turf.");

			if(TurfInfo[turfid][tConfigMode] == 0)
			{
				switch(listitem)
				{
					case 0: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_SELECTMODE, DIALOG_STYLE_LIST, "Turf Mode", "Influence Turf\nOpen Turf", "Select", "Back");
					case 1:
					{
						ResetAdvancedTurfConfiguration(turfid);
						return ShowAdvancedTurfConfigureMenu(playerid, turfid);
					}
				}
			}
			else if(TurfInfo[turfid][tConfigMode] == 2)
			{
				switch(listitem)
				{
					case 0: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_SELECTMODE, DIALOG_STYLE_LIST, "Turf Mode", "Influence Turf\nOpen Turf", "Select", "Back");
					case 1: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_DURATION, DIALOG_STYLE_INPUT, "Turf Duration", "Enter turf duration in minutes.", "Set", "Back");
					case 2:
					{
						FinalizeAdvTurfConfig(playerid, turfid);
						return ShowAdvancedTurfConfigureMenu(playerid, turfid);
					}
					case 3:
					{
						ResetAdvancedTurfConfiguration(turfid);
						return ShowAdvancedTurfConfigureMenu(playerid, turfid);
					}
				}
			}
			else if(TurfInfo[turfid][tConfigMode] == 1)
			{
				switch(listitem)
				{
					case 0: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_SELECTMODE, DIALOG_STYLE_LIST, "Turf Mode", "Influence Turf\nOpen Turf", "Select", "Back");
					case 1: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_DEFENDER, DIALOG_STYLE_INPUT, "Defender Gang", "Enter defender gang ID.", "Set", "Back");
					case 2: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_ATTACKER, DIALOG_STYLE_INPUT, "Attacker Gang", "Enter attacker gang ID.", "Set", "Back");
					case 3: return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_DURATION, DIALOG_STYLE_INPUT, "Turf Duration", "Enter turf duration in minutes.", "Set", "Back");
					case 4:
					{
						FinalizeAdvTurfConfig(playerid, turfid);
						return ShowAdvancedTurfConfigureMenu(playerid, turfid);
					}
					case 5:
					{
						ResetAdvancedTurfConfiguration(turfid);
						return ShowAdvancedTurfConfigureMenu(playerid, turfid);
					}
				}
			}
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
		case DIALOG_TCONFIGURE_SELECTMODE:
		{
			new turfid = pConfiguringTurf[playerid];
			if(!response) return ShowAdvancedTurfConfigureMenu(playerid, turfid);
			if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid turf.");

			TurfInfo[turfid][tConfigMode] = (listitem == 0) ? 1 : 2;
			TurfInfo[turfid][tConfigStatus] = 0;
			TurfInfo[turfid][tActive] = 0;
			TurfInfo[turfid][tPaused] = 0;
			TurfInfo[turfid][tLocked] = 0;
			ClearAdvancedTurfLockState(turfid);
			if(TurfInfo[turfid][tConfigMode] == 2)
			{
				TurfInfo[turfid][tDefenderGang] = -1;
				TurfInfo[turfid][tAttackerGang] = -1;
			}
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
		case DIALOG_TCONFIGURE_DEFENDER:
		{
			new turfid = pConfiguringTurf[playerid], gangid;
			if(!response) return ShowAdvancedTurfConfigureMenu(playerid, turfid);
			if(sscanf(inputtext, "i", gangid)) return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_DEFENDER, DIALOG_STYLE_INPUT, "Defender Gang", "Enter defender gang ID.", "Set", "Back");
			if(!IsValidAdvancedTurfGang(gangid)) return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid defender gang.");
			if(gangid == TurfInfo[turfid][tAttackerGang]) return SendClientMessage(playerid, COLOR_SYNTAX, "Defender and attacker gangs cannot be identical.");
			TurfInfo[turfid][tDefenderGang] = gangid;
			TurfInfo[turfid][tConfigStatus] = 0;
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
		case DIALOG_TCONFIGURE_ATTACKER:
		{
			new turfid = pConfiguringTurf[playerid], gangid;
			if(!response) return ShowAdvancedTurfConfigureMenu(playerid, turfid);
			if(sscanf(inputtext, "i", gangid)) return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_ATTACKER, DIALOG_STYLE_INPUT, "Attacker Gang", "Enter attacker gang ID.", "Set", "Back");
			if(!IsValidAdvancedTurfGang(gangid)) return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid attacker gang.");
			if(gangid == TurfInfo[turfid][tDefenderGang]) return SendClientMessage(playerid, COLOR_SYNTAX, "Defender and attacker gangs cannot be identical.");
			TurfInfo[turfid][tAttackerGang] = gangid;
			TurfInfo[turfid][tConfigStatus] = 0;
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
		case DIALOG_TCONFIGURE_DURATION:
		{
			new turfid = pConfiguringTurf[playerid], minutes;
			if(!response) return ShowAdvancedTurfConfigureMenu(playerid, turfid);
			if(sscanf(inputtext, "i", minutes) || !(1 <= minutes <= 180))
			{
				return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_DURATION, DIALOG_STYLE_INPUT, "Turf Duration", "Enter turf duration in minutes (1-180).", "Set", "Back");
			}
			TurfInfo[turfid][tDuration] = minutes * 60;
			TurfInfo[turfid][tWarTime] = TurfInfo[turfid][tDuration];
			TurfInfo[turfid][tInfluenceTime] = TurfInfo[turfid][tDuration];
			TurfInfo[turfid][tConfigStatus] = 0;
			return ShowAdvancedTurfConfigureMenu(playerid, turfid);
		}
	    case DIALOG_CARSTORAGE:
		{
		    if(response)
		    {
				if(listitem != -1)
		        {
		        	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id FROM vehicles WHERE ownerid = %i LIMIT %i, 1", PlayerInfo[playerid][pID], listitem);
		        	mysql_tquery(connectionID, queryBuffer, "OnPlayerUseCarStorage", "i", playerid);
				}
			}

		}
	    case DIALOG_VOTE:
		{
		    if(response)
		    {
		        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id FROM factions WHERE type = 4 LIMIT %i, 1", listitem);
		        mysql_tquery(connectionID, queryBuffer, "OnPlayerUseVote", "i", playerid);
			}
		}
		case DIALOG_GCARSTORAGE:
		{
		    if(response)
		    {
		        if(0 <= listitem < GangStorageVehicleCount[playerid])
		        {
		            UseGangStorageVehicle(playerid, GangStorageVehicleID[playerid][listitem]);
		        }
			}
		}
		case DIALOG_VALLEY:
		{
		    if(response)
		    {
				if(listitem != -1)
		        {
					mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id FROM vehicles WHERE ownerid = %i LIMIT %i, 1", PlayerInfo[playerid][pID], listitem);
		        	mysql_tquery(connectionID, queryBuffer, "OnPlayerUseCarValley", "i", playerid);
				}
			}
		}
		case DIALOG_DMVRELEASE:
		{
			if(response)
		    {
		        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, tickets, modelid FROM vehicles WHERE ownerid = %i AND impounded = 1 LIMIT %i, 1", PlayerInfo[playerid][pID], listitem);
		        mysql_tquery(connectionID, queryBuffer, "OnPlayerDMVRelease", "i", playerid);
			}
		}
		case DIALOG_PAYCHECK:
		{
			if(!response)
			{
				return 1;
			}
			if(PayCheckCode[playerid] == 0)
			{
				return SendClientMessage(playerid, COLOR_SYNTAX, "You don't have a pending paycheck to sign.");
			}

			new szMessage[150];
			if(strlen(inputtext) < 1)
			{
				format(szMessage, sizeof(szMessage), "You must enter the check code before signing.\n\nCheck code: %d\n\nEnter your check code to receive your paycheck:", PayCheckCode[playerid]);
				ShowPlayerDialog(playerid, DIALOG_PAYCHECK, DIALOG_STYLE_INPUT, SERVER_DIALOG, szMessage, "Paycheck", "Cancel");
				return 1;
			}
			if(!IsNumeric(inputtext))
			{
				format(szMessage, sizeof(szMessage), "Wrong check code. The check code consists out of numbers only.\n\nCheck code: %d\n\nEnter your check code to receive your paycheck:", PayCheckCode[playerid]);
				ShowPlayerDialog(playerid, DIALOG_PAYCHECK, DIALOG_STYLE_INPUT, SERVER_DIALOG, szMessage, "Paycheck", "Cancel");
				return 1;
			}
			if(strlen(inputtext) != 2)
			{
				format(szMessage, sizeof(szMessage), "Wrong check code. The check code consists out of 2 digits.\n\nCheck code: %d\n\nEnter your check code to receive your paycheck:", PayCheckCode[playerid]);
				ShowPlayerDialog(playerid, DIALOG_PAYCHECK, DIALOG_STYLE_INPUT, SERVER_DIALOG, szMessage, "Paycheck", "Cancel");
				return 1;
			}

			new code = strval(inputtext);
			if(code == PayCheckCode[playerid])
			{
				SendPaycheck(playerid);
				PayCheckCode[playerid] = 0;
			}
			else
			{
				SendClientMessage(playerid, COLOR_WHITE, "Wrong check code.");
			}
		}
		case DIALOG_PAINTBALL:
		{
		    if(response)
		    {
			    SendProximityMessage(playerid, 20.0, COLOR_LE, "** %s has entered the paintball arena.", GetRPName(playerid));
				SetPlayerInPaintball(playerid, listitem+1);

				foreach(new i : Player)
				{
				    if(PlayerInfo[playerid][pPaintball] == PlayerInfo[i][pPaintball])
				    {
				        SM(i, COLOR_WHITE, "[Paintball Arena] %s has joined the Paintball Arena!", GetRPName(playerid));
					}
			    }
		    }
		}

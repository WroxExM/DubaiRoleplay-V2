		case DIALOG_HOSPITAL:
		{
			if(response)
			{
				switch(listitem)
				{
					case 0:
					{
						if(PlayerInfo[playerid][pCash] < 500)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You don't have enough cash to purchase a Bandage.");
						}

						if(PlayerInfo[playerid][pBandage] >= 10)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You already have the maximum amount of Bandages.");
						}

						PlayerInfo[playerid][pBandage]++;
						PlayerInfo[playerid][pCash] -= 500;

						mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
						"UPDATE users SET bandage = %i, cash = %i WHERE uid = %i",
						PlayerInfo[playerid][pBandage],
						PlayerInfo[playerid][pCash],
						PlayerInfo[playerid][pID]);

						mysql_tquery(connectionID, queryBuffer);

						SCMf(playerid, COLOR_GREEN,
						"[HOSPITAL] You have purchased a Bandage for $500.");

						Inventory_Set(playerid, "Bandage", 1279, PlayerInfo[playerid][pBandage]);
					}
					case 1:
					{
						if(PlayerInfo[playerid][pCash] < 1000)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You don't have enough cash to purchase Painkillers.");
						}

						if(PlayerInfo[playerid][pPainkillers] >= 10)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You already have the maximum amount of Painkillers.");
						}
						SCMf(playerid, COLOR_RED, "CMG SOON");
					}
					case 2:
					{
						if(PlayerInfo[playerid][pCash] < 4000)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You don't have enough cash to purchase a Medkit.");
						}

						if(PlayerInfo[playerid][pMedkit] >= 5)
						{
							return SendClientMessage(playerid, COLOR_SYNTAX,
							"[HOSPITAL] {FFFFFF}You already have the maximum amount of Medkits.");
						}

						PlayerInfo[playerid][pMedkit]++;
						PlayerInfo[playerid][pCash] -= 4000;

						mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
						"UPDATE users SET medkit = %i, cash = %i WHERE uid = %i",
						PlayerInfo[playerid][pMedkit],
						PlayerInfo[playerid][pCash],
						PlayerInfo[playerid][pID]);

						mysql_tquery(connectionID, queryBuffer);

						SCMf(playerid, COLOR_GREEN,
						"[HOSPITAL] You have purchased a Medkit for $4,000.");

						Inventory_Set(playerid, "Medkit", 11738, PlayerInfo[playerid][pMedkit]);
					}
				}
			}

			return 1;
		}
		case DIALOG_GUNSHOP:
		{
			if(response)
			{
				if(IsPlayerWeaponAccessRestricted(playerid))
				{
				    ShowWeaponLockMessage(playerid);
				    return 1;
				}

				if(listitem == 0) // Silenced Pistol
				{

					if(GetPlayerWeapon(playerid) == 23)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You already own a Silenced Pistol.");
					}
					if(PlayerInfo[playerid][pWeaponLicense] != 1)
					{
						return SCMf(playerid, COLOR_RED, "You don't have a weapon license. Go to the PD and get one.");
					}
					if(PlayerInfo[playerid][pCash] < 55000)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You don't have enough cash to purchase a Silenced Pistol.");
					}

					PlayerInfo[playerid][pCash] -= 55000;
					GiveWeapon(playerid, 23);
					SavePlayerWeapons(playerid);
					SCMf(playerid, COLOR_GREEN, "[GUN-SHOP] You have successfully purchased a Silenced Pistol for $55,000.");
				}
				else if(listitem == 1) // 9MM
				{
					if(GetPlayerWeapon(playerid) == 22)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You already own a 9MM.");
					}
					if(PlayerInfo[playerid][pWeaponLicense] != 1)
					{
						return SCMf(playerid, COLOR_RED, "You don't have a weapon license. Go to the PD and get one.");
					}
					if(PlayerInfo[playerid][pCash] < 35000)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You don't have enough cash to purchase a 9MM.");
					}

					PlayerInfo[playerid][pCash] -= 35000;
					GiveWeapon(playerid, 22);
					SavePlayerWeapons(playerid);
					SCMf(playerid, COLOR_GREEN, "[GUN-SHOP] You have successfully purchased a 9MM for $35,000.");
				}
				else if(listitem == 2) // MP5
				{
					if(GetPlayerWeapon(playerid) == 29)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You already own an MP5.");
					}
					if(PlayerInfo[playerid][pWeaponLicense] != 1)
					{
						return SCMf(playerid, COLOR_RED, "You don't have a weapon license. Go to the PD and get one.");
					}
					if(PlayerInfo[playerid][pCash] < 150000)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You don't have enough cash to purchase an MP5.");
					}

					PlayerInfo[playerid][pCash] -= 150000;
					GiveWeapon(playerid, 29);
					SavePlayerWeapons(playerid);
					SCMf(playerid, COLOR_GREEN, "[GUN-SHOP] You have successfully purchased an MP5 for $150,000.");
				}
				else if(listitem == 3) // Vest
				{
					if(PlayerInfo[playerid][pCash] < 5000)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You don't have enough cash to purchase a Vest.");
					}
					if(PlayerInfo[playerid][pVest] >= 5)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}Maximum vest limit reached.");
					}

					PlayerInfo[playerid][pVest] += 1;
					PlayerInfo[playerid][pCash] -= 5000;

					mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
						"UPDATE users SET vest = %i, cash = %i WHERE uid = %i",
						PlayerInfo[playerid][pVest], PlayerInfo[playerid][pCash], PlayerInfo[playerid][pID]);
					mysql_tquery(connectionID, queryBuffer);

					SCMf(playerid, COLOR_GREEN, "[GUN-SHOP] You have successfully purchased a Vest for $5,000.");
					Inventory_Update(playerid);
				}

				else if(listitem == 4) // Helmet
				{
					if(PlayerInfo[playerid][pCash] < 8000)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You don't have enough cash to purchase a Helmet.");
					}
					if(PlayerInfo[playerid][pHelmet1] >= 5)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}Maximum helmet limit reached.");
					}

					PlayerInfo[playerid][pHelmet1] += 1;
					PlayerInfo[playerid][pCash] -= 8000;

					mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET helmetp = %i WHERE uid = %i", PlayerInfo[playerid][pHelmet1], PlayerInfo[playerid][pID]);
					mysql_tquery(connectionID, queryBuffer);

					SCMf(playerid, COLOR_GREEN,"[GUN-SHOP] Helmet purchased for $8,000. Use /usehelmet. Bullet protection is coming soon.");
				}

				else if(listitem == 5) // Parachute
				{
					if(GetPlayerWeapon(playerid) == WEAPON_PARACHUTE)
					{
						return SendClientMessage(playerid, COLOR_SYNTAX, "[GUN-SHOP] {FFFFFF}You already own a Parachute.");
					}
					if(PlayerInfo[playerid][pCash] < 50000)

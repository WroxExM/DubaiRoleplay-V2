enum FactoryWeaponDataEnum
{
	wModel,
	wName[16],
	wFrameName[8]
};

new const WeaponData[][FactoryWeaponDataEnum] =
{
	{FACTORY_WEAPON_DEAGLE, "Desert Eagle", "Pistol"},
	{FACTORY_WEAPON_M4,     "M4 Rifle",     "Rifle"}
};

stock WeaponName(weapon, dest[], size)
{
	new idx = (weapon == FACTORY_WEAPON_M4);
	format(dest, size, WeaponData[idx][wName]);
	return 1;
}

stock FrameName(weapon, dest[], size)
{
	new idx = (weapon == FACTORY_WEAPON_M4);
	format(dest, size, WeaponData[idx][wFrameName]);
	return 1;
}


	if(playertextid == ATMWITHDRAW[playerid][47]) // MEMO
	{
		SCMf(playerid, COLOR_YELLOW2, "CMG SOON");
	}
	if(playertextid == ATMDEPOSIT[playerid][18]) // OVERVIEW
	{
		for(new i = 0; i < 57; i++)

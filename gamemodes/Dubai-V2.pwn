			return SCMf(playerid, COLOR_GREY, "First choose the person.");
		}
		ShowPlayerDialog(playerid, DIALOG_GPAY_AMOUNT, DIALOG_STYLE_INPUT, "{4285F4}GPay {FFFFFF}- Amount", "{FFFFFF}Enter amount to transfer.", "Set", "Cancel");
	}
	if(playertextid == PHONEGPAYMAINSCREEN[playerid][68]) // SEND MONEY
	{
		new target = GetPVarInt(playerid, "transfer_id");
		new amount = GetPVarInt(playerid, "transfer_amount");

		if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
		{
			return SCMf(playerid, COLOR_GREY, "Selected player is offline.");
		}
		if(amount < 1)
		{
			return SCMf(playerid, COLOR_GREY, "No amount selected.");
		}
		if(amount > PlayerInfo[playerid][pBank])
		{
			return SCMf(playerid, COLOR_RED, "Insufficient bank balance.");
		}

		PlayerInfo[playerid][pBank] -= amount;
		PlayerInfo[target][pBank] += amount;

		new query[256];

		mysql_format(connectionID, query, sizeof(query), "UPDATE users SET bank = %i WHERE uid = %i", PlayerInfo[playerid][pBank], PlayerInfo[playerid][pID]);
		mysql_tquery(connectionID, query);

		mysql_format(connectionID, query, sizeof(query), "UPDATE users SET bank = %i WHERE uid = %i", PlayerInfo[target][pBank], PlayerInfo[target][pID]);
		mysql_tquery(connectionID, query);

		new str[128];

		format(str, sizeof(str), "TRANSFERRED %s", FormatNumber(amount));
		AddBankLog(playerid, str, COLOR_RED);

		format(str, sizeof(str), "RECEIVED %s", FormatNumber(amount));
		AddBankLog(target, str, COLOR_GREEN);

		SCMf(playerid, COLOR_GREEN, "You sent %s to %s.", FormatNumber(amount), GetRPName(target));

		SCMf(target, COLOR_GREEN, "%s sent you %s through GPay.", GetRPName(playerid), FormatNumber(amount));

		PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		PlayerPlaySound(target, 1052, 0.0, 0.0, 0.0);

		format(str, sizeof(str), "%s", FormatNumber(PlayerInfo[playerid][pBank]));
		PlayerTextDrawSetString(playerid, PHONEGPAYMAINSCREEN[playerid][50], str);

		PlayerTextDrawSetString(playerid, PHONEGPAYMAINSCREEN[playerid][58], "NO PLAYER");
		PlayerTextDrawSetString(playerid, PHONEGPAYMAINSCREEN[playerid][67], "0");

		PlayerTextDrawShow(playerid, PHONEGPAYMAINSCREEN[playerid][58]);
		PlayerTextDrawShow(playerid, PHONEGPAYMAINSCREEN[playerid][67]);


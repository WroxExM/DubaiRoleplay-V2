			PlayerInfo[playerid][pBirthMonth] = DOBData[playerid][dob_month];
			PlayerInfo[playerid][pBirthYear] = DOBData[playerid][dob_year];

			PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][16], 0x00FF00FF, 1500, EASE_OUT_QUAD);
			PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][17], 0x00FF00FF, 1500, EASE_OUT_QUAD);
			PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][19], 0x00FF00FF, 1500, EASE_OUT_QUAD);
			PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][20], 0x00FF00FF, 1500, EASE_OUT_QUAD);

			new age = 2026 - PlayerInfo[playerid][pBirthYear], agestr[12];
			format(agestr, sizeof(agestr), "%d", age);
			PlayerInfo[playerid][pAge] = age;
			DynamicPlayerTextDrawSetString(playerid, REGISTERTD[playerid][20], agestr);

			new dobstring[32];
			format(dobstring, sizeof(dobstring), "%02d/%02d/%04d", PlayerInfo[playerid][pBirthDay], PlayerInfo[playerid][pBirthMonth], PlayerInfo[playerid][pBirthYear]);
			format(PlayerInfo[playerid][pDateOfBirth], 32, "%s", dobstring);
			DynamicPlayerTextDrawSetString(playerid, REGISTERTD[playerid][17], dobstring);

			new finalmsg[256];
			format(finalmsg, sizeof(finalmsg), "Your Character OC Date Of Birth Is Successfully Set!\nDate Of Birth: %02d/%02d/%04d",
				PlayerInfo[playerid][pBirthDay],
				PlayerInfo[playerid][pBirthMonth],
				PlayerInfo[playerid][pBirthYear]);

			ShowPlayerDialog(playerid,  DIALOG_DATE_CONFIRM,  DIALOG_STYLE_MSGBOX, "Date Of Birth Completed", finalmsg, "Okay", "");

			new query[500];
			mysql_format(connectionID, query, sizeof(query), "UPDATE users SET birth_day = %i, birth_month = %i, birth_year = %i, age = %i, date_of_birth = '%e' WHERE uid = %i", PlayerInfo[playerid][pBirthDay], PlayerInfo[playerid][pBirthMonth], PlayerInfo[playerid][pBirthYear], PlayerInfo[playerid][pAge], PlayerInfo[playerid][pDateOfBirth], PlayerInfo[playerid][pID]);
			mysql_tquery(connectionID, query);
			
			SCMf(playerid, COLOR_DARKGREEN, "DATE OF BIRTH UPDATED");
			PlayerRegisterStep[playerid] = REGISTER_STEP_EMAIL;
			
			return 1;
		}

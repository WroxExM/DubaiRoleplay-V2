                cache_get_value_name_int(0, "gunframe", PlayerInfo[extraid][pGunFrame]);
                cache_get_value_name_int(0, "pistolframe", PlayerInfo[extraid][pPistolFrame]);
                cache_get_value_name_int(0, "rifleframe", PlayerInfo[extraid][pRifleFrame]);

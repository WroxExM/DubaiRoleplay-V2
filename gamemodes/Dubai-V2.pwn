					return SCMf(playerid, COLOR_GREY, "Player not found.");
				}
				if(id == INVALID_PLAYER_ID || !IsPlayerConnected(id))
				{
					return SCMf(playerid, COLOR_GREY, "Player not connected.");
				}
				if(id == playerid)
				{
					return SCMf(playerid, COLOR_GREY, "You cannot send money to yourself.");
				}

				SetPVarInt(playerid, "transfer_id", id);

				new str[64];

				format(str, sizeof(str), "%s", GetRPName(id));
				PlayerTextDrawSetString(playerid, PHONEGPAYMAINSCREEN[playerid][58], str);
				PlayerTextDrawShow(playerid, PHONEGPAYMAINSCREEN[playerid][58]);

				SCMf(playerid, COLOR_GREEN, "Selected player: %s.", GetRPName(id));
			}
		}
		case DIALOG_GPAY_AMOUNT:

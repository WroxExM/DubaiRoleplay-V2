				if(InventoryData[playerid][i][invAmount] <= 0)
				{
					InventoryData[playerid][i][invAmount] = 1;
				}

				printf("[INV DEBUG] Slot: %d | Item: %s | Amount: %d", i, name, InventoryData[playerid][i][invAmount]);

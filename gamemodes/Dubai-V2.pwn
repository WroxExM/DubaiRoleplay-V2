public OnClientCheckResponse(playerid, actionid, memaddr, retndata)
{
    new string[256];


    switch (retndata)
    {
        case 0xA0:
		{
            SendClientMessage(playerid, COLOR_SYNTAX, "DUBAI X| ANTI-EXPLOIT] Your game files have been verified and are clean.");
            format(string, sizeof(string), "Player %s (ID: %d) has clean game files. No modification detected.", GetRPName(playerid), playerid);
            SendDiscordMessage(2, string);

		}
        default:
		{
            SendClientMessage(playerid, COLOR_SYNTAX, "DUBAI - X| ANTI-EXPLOIT]{ed0023} Modified game files detected!");
            //SetTimerEx("SendDelayMessage", 6000, false, "i", playerid);
	    }
    }


    return 1;
}
stock stamp2datetime(timestamp, &year, &month, &day, &hour, &minute, &second)
{
    new
        timestamp2 = timestamp / 86400,
        julian = timestamp2 + 2440588,
        temp,
        jalpha,
        ja,
        jb,
        jc,
        jd,
        je;

    temp = ((julian - 1867216) - 0.25) / 36524.25;
    jalpha = floatround(temp, floatround_floor);

    ja = julian + 1 + jalpha - (jalpha / 4);
    jb = ja + 1524;
    jc = floatround(6680.0 + ((jb - 2439870) - 122.1) / 365.25, floatround_floor);
    jd = 365 * jc + (jc / 4);
    je = floatround((jb - jd) / 30.6001, floatround_floor);

    day = jb - jd - floatround(30.6001 * je, floatround_floor);
    month = je - 1;

    if(month > 12)
        month -= 12;

    year = jc - 4715;

    if(month > 2)
        year--;

    temp = timestamp % 86400;

    hour = temp / 3600;
    minute = (temp % 3600) / 60;
    second = temp % 60;

	return 1;
}


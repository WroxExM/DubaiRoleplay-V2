				FactoryRefreshFactory(row);
			}
			printf("[Script] Loaded %d factories.", rows);
		}
		case THREAD_LOAD_WEAPON_PRODUCTIONS:
		{
			for (new row; row < rows; row++)
			{
				new sqlid;
				cache_get_value_name_int(row, "factory_sql_id", sqlid);
				new fid = FactoryGetFactoryBySQL(sqlid);
				if (fid == -1) continue;

				cache_get_value_name_int(row, "weapon_type", WeaponFactory[fid][wfProdWeapon]);
				cache_get_value_name_int(row, "amount", WeaponFactory[fid][wfProdAmount]);
				cache_get_value_name_int(row, "progress", WeaponFactory[fid][wfProdProgress]);
				cache_get_value_name_int(row, "start_time", WeaponFactory[fid][wfProdStartTime]);
				cache_get_value_name_int(row, "last_crate", WeaponFactory[fid][wfLastCrate]);
				WeaponFactory[fid][wfStatus]      = STATUS_MANUFACTURING;
				FactoryRefreshFactory(fid);
			}
			printf("[Script] Loaded %d active productions.", rows);
		}

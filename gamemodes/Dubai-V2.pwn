	Streamer_ApplyHighLoadSettings();
	new databaseConnectStarted = GetTickCount();
	connectionID = mysql_connect_file("mysql.ini");
	printf("[Database] Connection attempt finished in %d ms.", GetTickCount() - databaseConnectStarted);
	if(mysql_errno(connectionID))
	{
	    print("Unable to establish a connection with the MySQL server...");
	    SendRconCommand("exit");
	    return 0;
	}

	// Queue every database-backed system before any heavy deferred world work.
	// Schema migrations belong in databases/latest.sql; runtime DDL can block
	// startup on metadata locks and must not run on every host restart.

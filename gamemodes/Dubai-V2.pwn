public LoadNextStartupDatabaseQuery()
{
	while(
		gStartupDatabaseNextQuery < sizeof(gStartupDatabaseQueries) &&
		gStartupDatabasePendingQueries < STARTUP_DATABASE_BATCH_SIZE
	)
	{
		new queryIndex = gStartupDatabaseNextQuery++;
		++gStartupDatabasePendingQueries;

		mysql_tquery(
			connectionID,
			gStartupDatabaseQueries[queryIndex][sdqQuery],
			"OnStartupDatabaseQueryLoaded",
			"iii",
			gStartupDatabaseQueries[queryIndex][sdqCallback],
			gStartupDatabaseQueries[queryIndex][sdqThread],
			gStartupDatabaseQueries[queryIndex][sdqExtra]
		);
	}

	if(
		!gDatabaseStartupReady &&
		gStartupDatabaseCompleted >= sizeof(gStartupDatabaseQueries) &&
		gStartupDatabasePendingQueries == 0
	)
	{
		gDatabaseStartupReady = true;
		printf(
			"[Database] Startup load complete (%d queries, batch size %d).",
			sizeof(gStartupDatabaseQueries),
			STARTUP_DATABASE_BATCH_SIZE
		);

		// Do not let map creation or ColAndreas starve the threaded MySQL
		// callbacks. Start those heavy jobs only after all DB loaders finish.
		DrugFarmSyncAllTurfs();
		LoadMappings();
		Tactical_Init();
	}
	return 1;
}

forward OnStartupDatabaseQueryLoaded(callback, threadid, extraid);

stock FinishStartupDatabaseQuery()
{
	if(gStartupDatabasePendingQueries > 0)
	{
		--gStartupDatabasePendingQueries;
	}
	++gStartupDatabaseCompleted;
	return LoadNextStartupDatabaseQuery();
}

forward ProcessStartupVehicleChunk();
public ProcessStartupVehicleChunk()
{
	if(gStartupVehicleCache == MYSQL_INVALID_CACHE)
	{
		return FinishStartupDatabaseQuery();
	}

	cache_set_active(gStartupVehicleCache);
	gStartupVehicleChunkActive = true;
	OnQueryFinished(THREAD_LOAD_VEHICLES, 0);
	gStartupVehicleChunkActive = false;

	if(gStartupVehicleRow < gStartupVehicleRows)
	{
		SetTimer("ProcessStartupVehicleChunk", 1, false);
		return 1;
	}

	cache_delete(gStartupVehicleCache);
	gStartupVehicleCache = MYSQL_INVALID_CACHE;
	return FinishStartupDatabaseQuery();
}

public OnStartupDatabaseQueryLoaded(callback, threadid, extraid)
{
	// Vehicle creation, component restoration and object rebuilding are too
	// expensive to perform for every row in one MySQL callback. Keep this cache
	// alive and spread the work across server ticks so open.mp's watchdog and
	// player networking are never starved by a large startup vehicle table.
	if(callback == STARTUP_CALLBACK_QUERY_FINISHED && threadid == THREAD_LOAD_VEHICLES)
	{
		gStartupVehicleCache = cache_save();
		gStartupVehicleRow = 0;
		cache_get_row_count(gStartupVehicleRows);
		SetTimer("ProcessStartupVehicleChunk", 1, false);
		return 1;
	}

	switch(callback)
	{
		case STARTUP_CALLBACK_QUERY_FINISHED: OnQueryFinished(threadid, extraid);
		case STARTUP_CALLBACK_DEALERSHIPS: OnLoadDealerships();
		case STARTUP_CALLBACK_GRAFFITI: Graffiti_Load();
		case STARTUP_CALLBACK_GATES: Gate_Load();
		case STARTUP_CALLBACK_VENDORS: Vendor_Load();
		case STARTUP_CALLBACK_OBJECTS: Object_Load();
		case STARTUP_CALLBACK_DROPPED: Dropped_Load();
	}

	return FinishStartupDatabaseQuery();
}

stock StartDatabaseStartupLoad()
{
	gStartupDatabaseNextQuery = 0;
	gStartupDatabasePendingQueries = 0;
	gStartupDatabaseCompleted = 0;
	gDatabaseStartupReady = false;
	return LoadNextStartupDatabaseQuery();
}


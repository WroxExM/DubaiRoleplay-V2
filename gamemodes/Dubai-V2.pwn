public InitPlayerTextDrawBatch2(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	INCOMINGCALL[playerid][0] = CreatePlayerTextDraw(playerid, 401.000, 114.000, "ld_bum:blkdot");
	PlayerTextDrawLetterSize(playerid, INCOMINGCALL[playerid][0], 0.600, 2.000);
	PlayerTextDrawTextSize(playerid, INCOMINGCALL[playerid][0], 122.500, 293.000);
	PlayerTextDrawAlignment(playerid, INCOMINGCALL[playerid][0], TEXT_DRAW_ALIGN_LEFT);
	PlayerTextDrawColour(playerid, INCOMINGCALL[playerid][0], -1094795521);

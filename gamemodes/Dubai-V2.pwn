	}
	else
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "That player is not registered.");
	}

	return 1;
}

forward LoadNextStartupDatabaseQuery();

public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	new File:file = fopen("mysql_error.txt", io_append);
	static message[2048];

	if(file)
	{
		format(message, sizeof(message), "[%s]\r\nError ID: %i\r\nCallback: %s\r\nQuery: %s\r\n[!] %s\r\n\r\n", GetDate(), errorid, callback, query, error);
		fwrite(file, message);
		fclose(file);
	}

    new DCC_Channel:channel = DCC_FindChannelById("1500743186275106860");
    format(message, sizeof(message), "```ini\n[MYSQL ERROR LOG]\n\nError ID : %d\nCallback : %s\nQuery : %s\nError : %s\n```", errorid, callback, query, error);
    DCC_SendChannelMessage(channel, message);

	// Release a startup queue slot even if an optional table is unavailable.
	// The error remains recorded above and the remaining loads can continue.
	if(!strcmp(callback, "OnStartupDatabaseQueryLoaded"))
	{
		if(gStartupDatabasePendingQueries > 0)
		{
			--gStartupDatabasePendingQueries;
		}
		++gStartupDatabaseCompleted;
		LoadNextStartupDatabaseQuery();
	}

	// If the initial account lookup query fails at the MySQL level,
	// OnInitialAccountLookup is never called. We cannot recover per-player
	// here because OnQueryError does not carry the playerid. The watchdog
	// in SecondTimer handles stuck players instead.

	//SAM(COLOR_LIGHTRED, "AdmCmd: A MySQL error occurred (error %i). Details written to mysql_error.txt.", errorid);
	return 1;
}

stock ShowPlayerAccountLookup(playerid, bool:registered)
{
	if(!IsPlayerConnected(playerid) || PlayerAccountLookupShown[playerid])
	{
		return 1;
	}
	PlayerAccountLookupShown[playerid] = true;

	if(registered)
	{
		new string[44];
		format(string, sizeof(string), "%s", GetRPName(playerid));

		for(new i = 0; i < 34; i++)
		{
			PlayerTextDrawShow(playerid, LOGINTD[playerid][i]);
		}

		DynamicPlayerTextDrawSetString(playerid, LOGINTD[playerid][29], string);
		SelectTextDraw(playerid, 0x33AA33AA);
	}
	else if(strfind(GetPlayerNameEx(playerid), "_") == -1)
	{
		ShowPlayerDialog(playerid, DIALOG_FREENAMECHANGE, DIALOG_STYLE_INPUT, "Non-Roleplay Name", "An administrator has concluded that your name is non-RP.\nTherefore, you have been given this free name change to correct it.\n\nEnter a name in the Firstname_Lastname format in the box below:", "Submit", "");
	}
	else
	{
		new string[44];
		format(string, sizeof(string), "%s", GetRPName(playerid));
		DynamicPlayerTextDrawSetString(playerid, REGISTERTD[playerid][15], string);

		PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][15], 0x00FF00FF, 1500, EASE_OUT_QUAD);
		PlayerText_InterpolateColor(playerid, REGISTERTD[playerid][14], 0x00FF00FF, 1500, EASE_OUT_QUAD);
		PlayerRegisterStep[playerid] = REGISTER_STEP_DOB;

		for(new i = 0; i < 34; i++)
		{
			PlayerTextDrawShow(playerid, REGISTERTD[playerid][i]);
		}

		SelectTextDraw(playerid, COLOR_BLUE);
		SCMf(playerid, COLOR_CYAN, "WELCOME TO DUBAI ROLEPLAY V2, COMPLETE YOUR CHARACTER SECTION");
	}
	return 1;
}

stock MarkPlayerAuthTextDrawPartReady(playerid, generation, part)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 0;
	}

	PlayerAuthTextDrawPartsReady[playerid] |= part;
	if(PlayerAuthTextDrawPartsReady[playerid] == 3)
	{
		PlayerAuthTextDrawReady[playerid] = true;
		if(PlayerAccountLookupPending[playerid])
		{
			PlayerAccountLookupPending[playerid] = false;
			ShowPlayerAccountLookup(playerid, PlayerAccountLookupRegistered[playerid]);
		}
	}
	return 1;
}

forward OnInitialAccountLookup(playerid, generation);
public OnInitialAccountLookup(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	// Query returned no rows — likely a MySQL error or timeout under load.
	// Reset pending flag and schedule a retry with backoff instead of silently
	// abandoning the player on a blank screen.
	if(!cache_num_rows())
	{
		PlayerInitialLookupPending[playerid] = false;

		if(PlayerInitialLookupRetries[playerid] < 3)
		{
			PlayerInitialLookupRetries[playerid]++;
			SetTimerEx("ShowMainMenuCamera", 1000, false, "ii", playerid, generation);
		}
		return 1;
	}

	PlayerInitialLookupPending[playerid] = false;
	PlayerInitialLookupRetries[playerid] = 0;

	new banned, registered;
	cache_get_value_name_int(0, "banned", banned);
	cache_get_value_name_int(0, "registered", registered);

	if(banned)
	{
		Dyuze(playerid, "Notice", "You are banned!", 999999);
		SM(playerid, COLOR_YELLOW, "You are banned from this server. You can appeal your ban at ("SERVER_URL")");
		KickPlayer(playerid);
		return 1;
	}

	// The database can answer before the deferred login/register textdraw batch
	// has been created. Remember the result and display it when that batch is ready.
	if(!PlayerAuthTextDrawReady[playerid])
	{
		PlayerAccountLookupPending[playerid] = true;
		PlayerAccountLookupRegistered[playerid] = bool:registered;
		return 1;
	}

	ShowPlayerAccountLookup(playerid, bool:registered);
	return 1;
}

forward OnQueryFinished(threadid, extraid);
public OnQueryFinished(threadid, extraid)
{
	new rows = cache_num_rows();

	switch(threadid)
	{
	    case THREAD_LOOKUP_BANS:
	    {
	        if(rows)
        	{
	            new bannedby[24], date[24], reason[128], ip[32], name[64];

	            cache_get_value_name(0, "name", name);
	            cache_get_value_name(0, "ip", ip);
	            cache_get_value_name(0, "bannedby", bannedby);
	            cache_get_value_name(0, "date", date);
	            cache_get_value_name(0, "reason", reason);

				Dyuze(extraid, "Notice", "You are banned!", 999999);

				new permanent;
				if(permanent)
				    SM(extraid, COLOR_YELLOW, "You are permanently banned from this server.");
				else
					SM(extraid, COLOR_YELLOW, "You are banned from this server. You can appeal your ban at ("SERVER_URL")");

				KickPlayer(extraid);
	        }
	        else
	        {
				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT uid FROM users WHERE username = '%e'", GetPlayerNameEx(extraid));
				mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_LOOKUP_ACCOUNT, extraid);
	        }
		}
		case THREAD_LOOKUP_ACCOUNT:
		{
			if(IsPlayerConnected(extraid))
			{
				ShowPlayerAccountLookup(extraid, bool:rows);
			}
		}
	    case THREAD_VALET_CARS:
		{
		    if(!rows)
		    {
		        SM(extraid, COLOR_SYNTAX, "You own no vehicles which you can spawn.");
		    }
		    else
		    {
		        new string[2084], vehicleid;

		        string = "#\tModel\tStatus\tLocation";

		        for(new i = 0; i < rows; i ++)
		        {
		            new id, impounded, modelid, world;
		            new Float:posX, Float:posY, Float:posZ;
		            cache_get_value_name_int(i, "id", id);
		            cache_get_value_name_int(i, "impounded", impounded);
		            cache_get_value_name_int(i, "modelid", modelid);
		            cache_get_value_name_int(i, "world", world);
		            cache_get_value_name_float(i, "pos_x", posX);
		            cache_get_value_name_float(i, "pos_y", posY);
		            cache_get_value_name_float(i, "pos_z", posZ);

		            if((vehicleid = GetVehicleLinkedID(id)) != INVALID_VEHICLE_ID)
		                format(string, sizeof(string), "%s\n%i\t%s\t"GREEN"Spawned"WHITE"\t%s", string, i + 1, vehicleNames[GetVehicleModel(vehicleid) - 400], GetVehicleZoneName(vehicleid));
					else if(impounded)
						format(string, sizeof(string), "%s\n%i\t%s\t{FF0000}Impounded{FFFFFF}\tDMV", string, i + 1, vehicleNames[modelid - 400]);
					else
						format(string, sizeof(string), "%s\n%i\t%s\t"RED"Despawned"WHITE"\t%s", string, i + 1, vehicleNames[modelid - 400], world ? ("Garage") : (GetZoneName(posX, posY, posZ)));
				}

				ShowPlayerDialog(extraid, DIALOG_VALETSTORAGE, DIALOG_STYLE_TABLIST_HEADERS, "Choose a vehicle to (de)spawn.", string, "Select", "Cancel");

		    }
		}
	    case THREAD_ACCOUNT_REGISTER:
	    {
	        new
	            id = cache_insert_id();

			if(id)
	        {
	        	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM users WHERE uid = %i", id);
	        	mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_PROCESS_LOGIN, extraid);
	        }
	    }
	    case THREAD_PROCESS_MUSIC:
        {
           new loginmusic[128];
		   if(!rows)
		   {
			  SendClientMessage(extraid,COLOR_SYNTAX,"Login music URL is null or empty. Cannot play audio stream.");
		   }
           else if(cache_get_value_name(0, "loginurl", loginmusic, sizeof(loginmusic)))
           {
                PlayerInfo[extraid][pLoginmusic] = loginmusic;

                if (strlen(PlayerInfo[extraid][pLoginmusic]) > 0)
                {
                     PlayAudioStreamForPlayer(extraid, PlayerInfo[extraid][pLoginmusic]);
                }
                else
                {
                     SendClientMessage(extraid,COLOR_SYNTAX,"Login music URL is null or empty. Cannot play audio stream.");
                }
            }

      	}
		case THREAD_PROCESS_LOGIN:
	    {	// OnPlayerLogin
	     	if(!rows)
			{
				PlayerInfo[extraid][pLoginTries]++;

				if(PlayerInfo[extraid][pLoginTries] < 8)
				{
					new string[44];
					format(string, sizeof(string), "%s", GetRPName(extraid));
					DynamicPlayerTextDrawSetString(extraid, LOGINTD[extraid][29], string);

					PlayerText_InterpolateColor(extraid, LOGINTD[extraid][30], 0xFF0000FF, 800, EASE_OUT_QUAD);
					SetTimerEx("ResetLoginTDColor", 400, false, "i", extraid);
					SM(extraid, COLOR_LIGHTRED, "Incorrect password. You have %i more attempts before you are kicked.", 8 - PlayerInfo[extraid][pLoginTries]);
				}
				else
				{
					Kick(extraid);
				}
			}
	        else
	        {
	            new locked;
	            cache_get_value_name_int(0, "locked", locked);
	            PlayerInfo[extraid][pPassword] = 0;
	            if(!locked)
	            {
	                SendClientMessage(extraid, COLOR_ROYALBLUE, "Your Account Sucessfully registered in Dubai Database, You can freely Apply For Whitelist in Discord.");
	                SendClientMessage(extraid, COLOR_DARKGREEN, " "SERVER_URL" ");
	                SAM(COLOR_YELLOW, "AdmWarning: %s tried to login with not whitelist.", GetRPName(extraid));
	            }
	            else
	            {
	            new date[64];
                for(new i = 0; i < 34; i ++)
                {
			       PlayerTextDrawDestroy(extraid,LOGINTD[extraid][i]);
                }
                CancelSelectTextDraw(extraid);
               	
	            cache_get_value_name(0, "login_date", date, 64);
	            cache_get_value_name(0, "accent", PlayerInfo[extraid][pAccent], 16);
	            cache_get_value_name(0, "adminname", PlayerInfo[extraid][pAdminName], MAX_PLAYER_NAME);
	            cache_get_value_name(0, "contractby", PlayerInfo[extraid][pContractBy], MAX_PLAYER_NAME);
	            cache_get_value_name(0, "prisonedby", PlayerInfo[extraid][pPrisonedBy], MAX_PLAYER_NAME);
	            cache_get_value_name(0, "prisonreason", PlayerInfo[extraid][pPrisonReason], 128);
	            cache_get_value_name_int(0, "donateweapon", PlayerInfo[extraid][pDonateWeapon]);
	            cache_get_value_name(0, "passportname", PlayerInfo[extraid][pPassportName], MAX_PLAYER_NAME);

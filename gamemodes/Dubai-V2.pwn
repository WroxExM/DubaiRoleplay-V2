CMD:accent(playerid, params[])
{
	new type;

	if(sscanf(params, "i", type))
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "Usage: /accent [type]");
	    SendClientMessage(playerid, COLOR_GREY2, "List of accents: (0) None - (1) Tagalog - (2) Cebuano - (3) Bikol - (4) English - (5) Japanese - (6) Chinese");
		SendClientMessage(playerid, SERVER_COLOR, "More accent contact developers.");
		return 1;
	}

	switch(type)
	{
		case 0: strcpy(PlayerInfo[playerid][pAccent], "None", 16);
		case 1: strcpy(PlayerInfo[playerid][pAccent], "Tagalog", 16);
		case 2: strcpy(PlayerInfo[playerid][pAccent], "Cebuano", 16);
		case 3: strcpy(PlayerInfo[playerid][pAccent], "Bikol", 16);
		case 4: strcpy(PlayerInfo[playerid][pAccent], "English", 16);
		case 5: strcpy(PlayerInfo[playerid][pAccent], "Japanese", 16);
		case 6: strcpy(PlayerInfo[playerid][pAccent], "Chinese", 16);

		default: SendClientMessage(playerid, COLOR_SYNTAX, "Invalid accent. Valid types range from 0 to 53.");
	}

	SM(playerid, COLOR_WHITE, "** You set your accent to '%s'.", PlayerInfo[playerid][pAccent]);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET accent = '%e' WHERE uid = %i", PlayerInfo[playerid][pAccent], PlayerInfo[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer);

	return 1;
}
CMD:dice(playerid, params[])
{
	SendProximityMessage(playerid, 20.0, COLOR_WHITE, "** %s rolls a dice which lands on the number %i.", GetRPName(playerid), random(6) + 1);
	return 1;
}

CMD:flipcoin(playerid, params[])
{
	SendProximityMessage(playerid, 20.0, COLOR_WHITE, "** %s flips a coin which lands on %s.", GetRPName(playerid), (random(2)) ? ("Heads") : ("Tails"));
	return 1;
}

CMD:time(playerid, params[])
{
	new
	    string[128],
		date[6];

	getdate(date[0], date[1], date[2]);
	gettime(date[3], date[4], date[5]);

	switch(date[1])
	{
	    case 1: string = "January";
	    case 2: string = "February";
	    case 3: string = "March";
	    case 4: string = "April";
	    case 5: string = "May";
	    case 6: string = "June";
	    case 7: string = "July";
	    case 8: string = "August";
	    case 9: string = "September";
	    case 10: string = "October";
	    case 11: string = "November";
	    case 12: string = "December";
	}

	format(string, sizeof(string), "%s %02d, %i %02d:%02d:%02d", string, date[2], date[0], date[3], date[4], date[5]);

	if(PlayerInfo[playerid][pJailTime] > 0)
	{
	    format(string, sizeof(string), "%s Jail Time: %i seconds", string, PlayerInfo[playerid][pJailTime]);
	}

    ApplyAnimationEx(playerid, "COP_AMBIENT", "Coplook_watch", 4.1, 0, 0, 0, 0, 0);
	Dyuze(playerid, "Time", string, 5000);
	SM(playerid, COLOR_WHITE, "** Paychecks occur at every hour. The next paycheck is at %02d:00 which is in %i minutes.", date[3]+1, (60 - date[4]));

	if(PlayerInfo[playerid][pGang] >= 0)
	{
	    new pointid = GetGangOwnedPoint(PlayerInfo[playerid][pGang]);

	    if(pointid >= 0)
	    {
	        new remaining = POINT_CARD_ACTIVITY_SECONDS - PlayerPointCardActivity[playerid];
	        new timeLeft[16];

	        if(remaining < 0)
	        {
	            remaining = 0;
	        }

	        FormatPointWarTime(remaining, timeLeft, sizeof(timeLeft));

	        if(IsPointCardActive(playerid, PlayerInfo[playerid][pGang]))
	        {
	            SM(playerid, COLOR_YELLOW, "[POINT WAR] Your gang owns %s. Next Point Card in %s (%i / 45 minutes).", PointInfo[pointid][pName], timeLeft, PlayerPointCardActivity[playerid] / 60);
	        }
	        else
	        {
	            SM(playerid, COLOR_YELLOW, "[POINT WAR] Your gang owns %s. Point Card timer is paused until you are active.", PointInfo[pointid][pName]);
	        }
	    }
	}
	return 1;
}

CMD:reportdm(playerid, params[]) return callcmd::rdm(playerid, params);
CMD:rdm(playerid, params[])
{
	if(isnull(params))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "Usage: /rdm [playerid]");
	}
	if(!enabledReports)
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "The report channel is disabled at the moment.");
	}
	if(PlayerInfo[playerid][pReportMuted])
	{
	    if(PlayerInfo[playerid][pReportMuted] > 1000) {
     		return SM(playerid, COLOR_SYNTAX, "You are indefinitely muted from submitting reports.");
		} else {
			return SM(playerid, COLOR_SYNTAX, "You are muted from submitting reports. Your mute is lifted in %i hours.", PlayerInfo[playerid][pReportMuted]);
		}
	}
	if(gettime() - PlayerInfo[playerid][pLastReport] < 50)
	{
	    return SM(playerid, COLOR_SYNTAX, "You can only submit one report every 50 seconds. Please wait %i more seconds.", 50 - (gettime() - PlayerInfo[playerid][pLastReport]));
	}
	if(PlayerInfo[playerid][pActiveReport] >= 0)
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You have an active report which needs to be closed first. Use /cr to close it.");
	}
	if(!AddDMReportToQueue(playerid, params))
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "The report queue is currently full. Please try again later.");
	}

	SendClientMessage(playerid, COLOR_YELLOW, "Your DM report was sent to all online admins. Please wait for a response.");
	return 1;
}

CMD:report(playerid, params[])
{
	if(isnull(params))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "Usage: /report [playerid (optional)] [text]");
	}
	if(!enabledReports)
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "The report channel is disabled at the moment.");
	}
	if(PlayerInfo[playerid][pReportMuted])
	{
	    if(PlayerInfo[playerid][pReportMuted] > 1000) {
     		return SM(playerid, COLOR_SYNTAX, "You are indefinitely muted from submitting reports.");
		} else {
			return SM(playerid, COLOR_SYNTAX, "You are muted from submitting reports. Your mute is lifted in %i hours.", PlayerInfo[playerid][pReportMuted]);
		}
	}
	if(gettime() - PlayerInfo[playerid][pLastReport] < 50)
	{
	    return SM(playerid, COLOR_SYNTAX, "You can only submit one report every 50 seconds. Please wait %i more seconds.", 50 - (gettime() - PlayerInfo[playerid][pLastReport]));
	}
	if(PlayerInfo[playerid][pActiveReport] >= 0)
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You have an active report which needs to be closed first. Use /cr to close it.");
	}
	if(!AddReportToQueue(playerid, params))
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "The report queue is currently full. Please try again later.");
	}

	SendClientMessage(playerid, COLOR_YELLOW, "Your report was sent to all online admins. Please wait for a response.");
	return 1;
}


/// showroom wrox

CMD:buyvehicle(playerid, params[])
{
    #pragma unused params

    new sid = GetNearbyShowroom(playerid);
    if(sid == DEALERSHIP_INVALID)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not in range of any dealership.");
    }
    if(PlayerInfo[playerid][pAdminDuty] > 0)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You can't use this command while on admin duty.");
    }
    if(pDealershipViewing[playerid] || pTestDealership[playerid])
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are already using a dealership.");
    }

    return OpenDealershipShowroom(playerid, sid);
}

CMD:createshowroom(playerid, params[])
{
    #pragma unused params

    if(PlayerInfo[playerid][pAdmin] < 5)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not authorised to use this command.");
    }

    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    new Float:vx = x + 5.0, Float:vy = y, Float:vz = z, Float:va = a;
    new Float:cx = x - 7.5, Float:cy = y - 7.5, Float:cz = z + 3.0;
    new Float:lx = vx, Float:ly = vy, Float:lz = vz + 1.0;
    new world = GetPlayerVirtualWorld(playerid);

    for(new i = 0; i < MAX_SHOWROOMS; i++)
    {
        if(!ShowRoomInfo[i][sExists])
        {
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "INSERT INTO dealerships \
                (ownerid, owner, posx, posy, posz, posa, vehx, vehy, vehz, veha, camx, camy, camz, lookx, looky, lookz, world, vault, `exists`) \
                VALUES (0, 'Nobody', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', %i, 0, 1)",
                x, y, z, a, vx, vy, vz, va, cx, cy, cz, lx, ly, lz, world);
            mysql_tquery(connectionID, queryBuffer, "OnAdminCreateShowroom", "iiffffffffffffffi",
                playerid, i, x, y, z, a, vx, vy, vz, va, cx, cy, cz, lx, ly, lz, world);
            return 1;
        }
    }

    return SCMf(playerid, COLOR_SYNTAX, "Dealership slots are full.");
}

CMD:editshowroom(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] < 5)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not authorised to use this command.");
    }

    new sid, option[16], param[32];
    if(sscanf(params, "is[16]S()[32]", sid, option, param))
    {
        SCMf(playerid, COLOR_SYNTAX, "Usage: /editshowroom [id] [owner | pos | vehiclepos | camerapos | lookat]");
        return 1;
    }
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists])
    {
        return SCMf(playerid, COLOR_SYNTAX, "Invalid dealership.");
    }

    if(!strcmp(option, "owner", true))
    {
        new targetid;
        if(sscanf(param, "u", targetid))
        {
            return SCMf(playerid, COLOR_SYNTAX, "Usage: /editshowroom [id] owner [playerid]");
        }
        if(!IsPlayerConnected(targetid) || !PlayerInfo[targetid][pLogged])
        {
            return SCMf(playerid, COLOR_SYNTAX, "That player is not connected or logged in.");
        }

        SetShowroomOwner(sid, targetid);
        SM(playerid, COLOR_AQUA, "You changed dealership %i owner to %s.", sid, GetRPName(targetid));
    }
    else if(!strcmp(option, "pos", true))
    {
        GetPlayerPos(playerid, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ]);
        GetPlayerFacingAngle(playerid, ShowRoomInfo[sid][sPosA]);
        ShowRoomInfo[sid][sWorld] = GetPlayerVirtualWorld(playerid);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "UPDATE dealerships SET posx = '%f', posy = '%f', posz = '%f', posa = '%f', world = %i WHERE id = %i",
            ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ], ShowRoomInfo[sid][sPosA], ShowRoomInfo[sid][sWorld], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        ReloadShowroom(sid);
        SM(playerid, COLOR_AQUA, "Dealership entrance position updated.");
    }
    else if(!strcmp(option, "vehiclepos", true))
    {
        GetPlayerPos(playerid, ShowRoomInfo[sid][sVehX], ShowRoomInfo[sid][sVehY], ShowRoomInfo[sid][sVehZ]);
        GetPlayerFacingAngle(playerid, ShowRoomInfo[sid][sVehA]);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "UPDATE dealerships SET vehx = '%f', vehy = '%f', vehz = '%f', veha = '%f' WHERE id = %i",
            ShowRoomInfo[sid][sVehX], ShowRoomInfo[sid][sVehY], ShowRoomInfo[sid][sVehZ], ShowRoomInfo[sid][sVehA], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        SM(playerid, COLOR_AQUA, "Dealership preview vehicle position updated.");
    }
    else if(!strcmp(option, "camerapos", true))
    {
        GetPlayerPos(playerid, ShowRoomInfo[sid][sCamX], ShowRoomInfo[sid][sCamY], ShowRoomInfo[sid][sCamZ]);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "UPDATE dealerships SET camx = '%f', camy = '%f', camz = '%f' WHERE id = %i",
            ShowRoomInfo[sid][sCamX], ShowRoomInfo[sid][sCamY], ShowRoomInfo[sid][sCamZ], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        SM(playerid, COLOR_AQUA, "Dealership camera position updated.");
    }
    else if(!strcmp(option, "lookat", true))
    {
        GetPlayerPos(playerid, ShowRoomInfo[sid][sLookX], ShowRoomInfo[sid][sLookY], ShowRoomInfo[sid][sLookZ]);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "UPDATE dealerships SET lookx = '%f', looky = '%f', lookz = '%f' WHERE id = %i",
            ShowRoomInfo[sid][sLookX], ShowRoomInfo[sid][sLookY], ShowRoomInfo[sid][sLookZ], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        SM(playerid, COLOR_AQUA, "Dealership camera look-at position updated.");
    }
    else
    {
        SCMf(playerid, COLOR_SYNTAX, "Available options: owner, pos, vehiclepos, camerapos, lookat.");
    }
    return 1;
}

CMD:removeshowroom(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] < 5)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not authorised to use this command.");
    }

    new sid;
    if(sscanf(params, "i", sid))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /removeshowroom [id]");
    }
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists])
    {
        return SCMf(playerid, COLOR_SYNTAX, "Invalid dealership.");
    }

    if(ShowRoomInfo[sid][sText] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(ShowRoomInfo[sid][sText]);
    }
    if(ShowRoomInfo[sid][sPickup] != -1)
    {
        DestroyDynamicPickup(ShowRoomInfo[sid][sPickup]);
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE dealerships SET `exists` = 0 WHERE id = %i", ShowRoomInfo[sid][sID]);
    mysql_tquery(connectionID, queryBuffer);

    ShowRoomInfo[sid][sExists] = 0;
    ShowRoomInfo[sid][sOwnerID] = 0;
    ShowRoomInfo[sid][sID] = 0;

    SM(playerid, COLOR_AQUA, "Dealership %i removed.", sid);
    return 1;
}

CMD:gotoshowroom(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] < 5)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }

    new sid;
    if(sscanf(params, "i", sid))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /gotshowroom [id]");
    }
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists])
    {
        return SCMf(playerid, COLOR_SYNTAX, "Invalid dealership.");
    }

    SetPlayerPos(playerid, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ]);
    SetPlayerFacingAngle(playerid, ShowRoomInfo[sid][sPosA]);
    SetPlayerVirtualWorld(playerid, ShowRoomInfo[sid][sWorld]);
    SetCameraBehindPlayer(playerid);
    return 1;
}

CMD:svault(playerid, params[])
{
    new sid = GetNearbyShowroom(playerid);
    if(sid == DEALERSHIP_INVALID)
    {
        return SCMf(playerid, COLOR_SYNTAX, "You are not near a dealership.");
    }
    if(!IsShowroomOwner(playerid, sid))
    {
        return SCMf(playerid, COLOR_SYNTAX, "You don't own this dealership.");
    }

    new option[14], param[32];
    if(sscanf(params, "s[14]S()[32]", option, param))
    {
        return SCMf(playerid, COLOR_SYNTAX, "USAGE: /vault [withdraw | deposit | balance]");
    }

    if(!strcmp(option, "balance", true))
    {
        return SM(playerid, COLOR_WHITE, "Dealership Vault Balance: $%s", AddCommas(ShowRoomInfo[sid][sVault]));
    }
    else if(!strcmp(option, "withdraw", true))
    {
        new amount;
        if(sscanf(param, "i", amount))
        {
            return SCMf(playerid, COLOR_SYNTAX, "Usage: /vault withdraw [amount]");
        }
        if(amount < 1 || amount > ShowRoomInfo[sid][sVault])
        {
            return SCMf(playerid, COLOR_SYNTAX, "Insufficient vault amount.");
        }

        ShowRoomInfo[sid][sVault] -= amount;
        GivePlayerCash(playerid, amount);
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE dealerships SET vault = %i WHERE id = %i", ShowRoomInfo[sid][sVault], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        return SM(playerid, COLOR_AQUA, "You withdrew $%s from the dealership vault.", AddCommas(amount));
    }
    else if(!strcmp(option, "deposit", true))
    {
        new amount;
        if(sscanf(param, "i", amount))
        {
            return SCMf(playerid, COLOR_SYNTAX, "Usage: /vault deposit [amount]");
        }
        if(amount < 1 || amount > PlayerInfo[playerid][pCash])
        {
            return SCMf(playerid, COLOR_SYNTAX, "Insufficient cash amount.");
        }

        ShowRoomInfo[sid][sVault] += amount;
        GivePlayerCash(playerid, -amount);
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE dealerships SET vault = %i WHERE id = %i", ShowRoomInfo[sid][sVault], ShowRoomInfo[sid][sID]);
        mysql_tquery(connectionID, queryBuffer);
        return SM(playerid, COLOR_AQUA, "You deposited $%s into the dealership vault.", AddCommas(amount));
    }

    return SCMf(playerid, COLOR_SYNTAX, "USAGE: /vault [withdraw | deposit | balance]");
}


stock OnDealershipNameChange(oldname[], newname[])
{
    for(new i = 0; i < MAX_SHOWROOMS; i++)
    {
        if(ShowRoomInfo[i][sExists] && !strcmp(ShowRoomInfo[i][sOwner], oldname, false))
        {
            strcpy(ShowRoomInfo[i][sOwner], newname, MAX_PLAYER_NAME);
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE dealerships SET owner = '%e' WHERE id = %i",
                ShowRoomInfo[i][sOwner], ShowRoomInfo[i][sID]);
            mysql_tquery(connectionID, queryBuffer);
            ReloadShowroom(i);
        }
    }
    return 1;
}



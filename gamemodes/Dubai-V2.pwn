// faction garage 

stock ReloadFG(fgid)
{
    if(!FGInfo[fgid][fgExists])
        return 0;

    DestroyDynamic3DTextLabel(FGInfo[fgid][fgText]);
    DestroyDynamicObject(FGInfo[fgid][fgObject]);

    new facname[32];

    switch(FGInfo[fgid][fgFaction])
    {
        case 1: facname = "Police";
        case 2: facname = "Medic";
        case 3: facname = "Mechanic";
        default: facname = "Unknown";
    }

    new string[256];

    format(string, sizeof(string), ""BLUE"["WHITE"Faction Garage"BLUE"]\n"GREEN"Faction: "WHITE"%s\n"WHITE"Press Y "BLUE"to spawn\n"WHITE"Press Horn "BLUE"or use "WHITE"/fd "BLUE"to despawn.", facname);
    FGInfo[fgid][fgText] = CreateDynamic3DTextLabel(string, COLOR_TEAL, FGInfo[fgid][fgPosX], FGInfo[fgid][fgPosY], FGInfo[fgid][fgPosZ] + 0.4, 20.0);
    FGInfo[fgid][fgObject] = CreateDynamicObject(1316, FGInfo[fgid][fgPosX], FGInfo[fgid][fgPosY], FGInfo[fgid][fgPosZ], 0.0, 0.0, FGInfo[fgid][fgPosA]);

    return 1;
}


		{
			return 1;
		}

		new targetid = PlayerInfo[playerid][pCallLine];

		for(new x = 0; x < 53; x++)
		{
			PlayerTextDrawHide(playerid, PHONECALLING[playerid][x]);
		}
		for(new x = 0; x < 53; x++)
		{
			PlayerTextDrawHide(targetid, PHONECALLING[targetid][x]);
		}

		CancelSelectTextDraw(playerid);
		CancelSelectTextDraw(targetid);

		PlayerInfo[playerid][pLoad] -= 1;
    	PlayerInfo[targetid][pLoad] -= 1;

		HangupCall(playerid, HANGUP_USER);

		return 1;
	}

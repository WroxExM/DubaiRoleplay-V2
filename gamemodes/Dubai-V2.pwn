}

// After registration
forward PlayerSpawn(playerid);
public PlayerSpawn(playerid)
{
	if(PlayerInfo[playerid][pLogged] && PlayerInfo[playerid][pTutorial])
	{
		if(PlayerInfo[playerid][pLogged] && PlayerInfo[playerid][pTutorial])
		{

			for (new i = 0; i < 41; i ++) 
			{
				PlayerTextDrawDestroy(playerid, SKINSETUP[playerid][i]);
				CancelSelectTextDraw(playerid);
			}

  	        InsideTut[playerid] = 0;
			PlayerInfo[playerid][pTutorial] = 0;
			PlayerInfo[playerid][pSetup] = 0;

			SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
			SetPlayerPos(playerid, 307.505340, -1796.986694, 11.975377);

			SetPlayerFacingAngle(playerid, 318.04);
			SetPlayerVirtualWorld(playerid, 0);
			SetPlayerInterior(playerid, 0);
			CancelSelectTextDraw(playerid);

			SetCameraBehindPlayer(playerid);
			StopAudioStreamForPlayer(playerid);
			TogglePlayerControllable(playerid, true);

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET setup = 0, gender = %i, age = %i, skin = %i WHERE uid = %i", PlayerInfo[playerid][pGender], PlayerInfo[playerid][pAge], PlayerInfo[playerid][pSkin], PlayerInfo[playerid][pID]);
			mysql_tquery(connectionID, queryBuffer);

            // Refund
			SendClientMessage(playerid, COLOR_BLUE, "[Welcome to "SERVER_NAME". Use the {FFFF90}/requesthelp{FFFFFF} command to guide you around the server.]");
			SendClientMessage(playerid, COLOR_BLUE, "[Use the {FFFF90}/locate{FFFFFF} command to point to locations of jobs, businesses, and common places.]");
			SendClientMessage(playerid, COLOR_BLUE, "[We are well aware of the script in use, please get to know our community before you pass on any judgement.]");

			SendClientMessage(playerid, COLOR_YELLOW, "And also you're a poor guy, You need to find a job just type /findjob");
			SMA(COLOR_LIGHTRED, "DURP AIRLINES: [%s(%d)] has just arrived to the city, welcome him/her through [/g]", GetRPName(playerid), playerid);
		}
	}
}


forward ShowMainMenuCamera(playerid, generation);
public ShowMainMenuCamera(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	if(PlayerInitialLookupPending[playerid])
	{
		return 1;
	}

	// Account authentication only depends on the users and bans tables. Do not
	// wait for vehicles, objects and the rest of the world startup queue: a slow
	// or failed optional loader must never leave connecting players on a blank
	// screen. Still spread simultaneous joins across a short window.
	if(!PlayerLookupStaggerQueued[playerid])
	{
		PlayerLookupStaggerQueued[playerid] = true;
		new staggerDelay = (playerid % 20) * 75;
		if(staggerDelay > 0)
		{
			SetTimerEx("ShowMainMenuCamera", staggerDelay, false, "ii", playerid, generation);
			return 1;
		}
	}

	PlayerInitialLookupPending[playerid] = true;
	PlayerInitialLookupTime[playerid] = gettime();

	// Use a local buffer so rapid concurrent lookups from different players
	// cannot overwrite each other through the shared global queryBuffer.
	new lookupQuery[512];
	mysql_format(connectionID, lookupQuery, sizeof(lookupQuery),
		"SELECT EXISTS(SELECT 1 FROM bans WHERE username = '%e' OR ip = '%e' OR ip = '%e' LIMIT 1) AS banned, EXISTS(SELECT 1 FROM users WHERE username = '%e' LIMIT 1) AS registered",
		GetPlayerNameEx(playerid), GetPlayerIP(playerid), GetPlayerIPRange(playerid), GetPlayerNameEx(playerid));
	mysql_tquery(connectionID, lookupQuery, "OnInitialAccountLookup", "ii", playerid, PlayerTextDrawInitGeneration[playerid]);

	PlayAudioStreamForPlayer(playerid, "https://g.top4top.io/m_3782stoq01.mp3");
	return 1;
}

stock SetVehicleSpeed(vehicleid, Float:speed,
	E_TDW_MATH_VEHICLE_SPEED_TYPE:type = EI_MATH_SPEED_KMPH)
{
	new
		Float:x,
		Float:y,
		Float:z;

	if (GetVehicleVelocity(vehicleid, x, y, z))
	{
		new
			Float:angle;

		GetVehicleVelocity(vehicleid, x, y, z);
		GetVehicleZAngle(vehicleid, angle);

		switch (type)
		{
			case EI_MATH_SPEED_KMPH:
				speed = floatdiv(speed, 180.0);
			case EI_MATH_SPEED_MPH:
				speed = floatdiv(speed, 111.846814);
		}

		x = floatmul(speed, floatsin(-angle, degrees));
		y = floatmul(speed, floatcos(-angle, degrees));

		SetVehicleVelocity(vehicleid, x, y, z);
	}
	return 0;
}

stock Dyuze(playerid, const title[], const string[], time = 5000)
{
	if(PlayerInfo[playerid][pDyuze])

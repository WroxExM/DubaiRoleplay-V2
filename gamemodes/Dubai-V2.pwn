				}
				
				cache_get_value_name_int(row, "health", WeaponFactory[row][wfHealth]);
				cache_get_value_name_int(row, "status", WeaponFactory[row][wfStatus]);
				cache_get_value_name_int(row, "cooldown_end", WeaponFactory[row][wfCooldownEnd]);

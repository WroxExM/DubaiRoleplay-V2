	PlayerTextDrawColour(playerid, PHONECALC[playerid][90], -1);
	PlayerTextDrawSetShadow(playerid, PHONECALC[playerid][90], 1);
	PlayerTextDrawSetOutline(playerid, PHONECALC[playerid][90], 1);
	PlayerTextDrawBackgroundColour(playerid, PHONECALC[playerid][90], 0);
	PlayerTextDrawFont(playerid, PHONECALC[playerid][90], TEXT_DRAW_FONT_1);
	PlayerTextDrawSetProportional(playerid, PHONECALC[playerid][90], true);

	SetTimerEx("InitPlayerTextDrawBatch3", 100, false, "ii", playerid, generation);
	return 1;
}

stock GetTurfKillLogColour(playerid)
{
	new gangid = PlayerInfo[playerid][pGang];

	if(0 <= gangid < MAX_GANGS && GangInfo[gangid][gSetup])
	{
		return (GangInfo[gangid][gColor] & ~0xFF) | 0xFF;
	}
	return 0xFFFFFFFF;
}

stock ClearTurfKillLogEntry(slot)
{
	TurfKillLog[slot][tklActive] = false;
	TurfKillLog[slot][tklSerial] = 0;
	TurfKillLog[slot][tklVictimName][0] = EOS;
	TurfKillLog[slot][tklKillerName][0] = EOS;
	TurfKillLog[slot][tklVictimColour] = 0xFFFFFFFF;
	TurfKillLog[slot][tklKillerColour] = 0xFFFFFFFF;
	return 1;
}

stock StopTurfKillLogAnimator(playerid, slot, animPart)
{
	new animator = TurfKillLogAnimator[playerid][slot][animPart];

	if(
		0 <= animator < MAX_ANIMATORS &&
		TurfKillAnimatorPlayer[animator] == playerid &&
		TurfKillAnimatorSlot[animator] == slot &&
		TurfKillAnimatorPart[animator] == animPart
	)
	{
		TurfKillAnimatorPlayer[animator] = -1;
		TurfKillAnimatorSlot[animator] = -1;
		TurfKillAnimatorPart[animator] = -1;
		Animator_Destroy(animator);
	}

	TurfKillLogAnimator[playerid][slot][animPart] = -1;
	return 1;
}

stock StopTurfKillLogAnimators(playerid)
{
	for(new slot = 0; slot < 5; slot++)
	{
		for(new part = 0; part < 2; part++)
		{
			StopTurfKillLogAnimator(playerid, slot, part);
		}
	}
	return 1;
}

public Animator_OnFinish(playerid, animator, type)
{
	#pragma unused type

	if(0 <= animator < MAX_ANIMATORS && TurfKillAnimatorPlayer[animator] == playerid)
	{
		new slot = TurfKillAnimatorSlot[animator];
		new animPart = TurfKillAnimatorPart[animator];

		if(
			0 <= slot < 5 &&
			0 <= animPart < 2 &&
			TurfKillLogAnimator[playerid][slot][animPart] == animator
		)
		{
			TurfKillLogAnimator[playerid][slot][animPart] = -1;
		}

		TurfKillAnimatorPlayer[animator] = -1;
		TurfKillAnimatorSlot[animator] = -1;
		TurfKillAnimatorPart[animator] = -1;
	}
	return 1;
}

stock RenderTurfKillLogForPlayer(playerid)
{
	if(!IsPlayerConnected(playerid) || !TurfKillLogTDReady[playerid])
	{
		return 0;
	}

	for(new slot = 0; slot < 5; slot++)
	{
		for(new animPart = 0; animPart < 2; animPart++)
		{
			StopTurfKillLogAnimator(playerid, slot, animPart);
		}

		for(new part = 0; part < 5; part++)
		{
			PlayerTextDrawHide(playerid, TURFKILLLOGTD[playerid][slot][part]);
		}

		if(!TurfKillLog[slot][tklActive])
		{
			continue;
		}

		PlayerTextDrawSetString(playerid, TURFKILLLOGTD[playerid][slot][1], TurfKillLog[slot][tklVictimName]);
		PlayerTextDrawSetString(playerid, TURFKILLLOGTD[playerid][slot][3], TurfKillLog[slot][tklKillerName]);
		PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][1], TurfKillLog[slot][tklVictimColour]);
		PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][3], TurfKillLog[slot][tklKillerColour]);

		for(new part = 0; part < 5; part++)
		{
			PlayerTextDrawShow(playerid, TURFKILLLOGTD[playerid][slot][part]);
		}
	}
	return 1;
}

stock RenderTurfKillLogSlotForPlayer(playerid, slot)
{
	if(!IsPlayerConnected(playerid) || !TurfKillLogTDReady[playerid] || !(0 <= slot < TURF_KILL_LOG_SLOTS))
	{
		return 0;
	}

	for(new animPart = 0; animPart < 2; animPart++)
	{
		StopTurfKillLogAnimator(playerid, slot, animPart);
	}
	for(new part = 0; part < 5; part++)
	{
		PlayerTextDrawHide(playerid, TURFKILLLOGTD[playerid][slot][part]);
	}
	if(!TurfKillLog[slot][tklActive]) return 1;

	PlayerTextDrawSetString(playerid, TURFKILLLOGTD[playerid][slot][1], TurfKillLog[slot][tklVictimName]);
	PlayerTextDrawSetString(playerid, TURFKILLLOGTD[playerid][slot][3], TurfKillLog[slot][tklKillerName]);
	PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][1], TurfKillLog[slot][tklVictimColour]);
	PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][3], TurfKillLog[slot][tklKillerColour]);
	for(new part = 0; part < 5; part++)
	{
		PlayerTextDrawShow(playerid, TURFKILLLOGTD[playerid][slot][part]);
	}
	return 1;
}

stock RenderTurfKillLogSlotForAll(slot)
{
	foreach(new playerid : Player)
	{
		RenderTurfKillLogSlotForPlayer(playerid, slot);
	}
	return 1;
}

stock AnimateTurfKillLogNames(playerid, slot, bool:fadeOut)
{
	if(
		!IsPlayerConnected(playerid) ||
		!TurfKillLogTDReady[playerid] ||
		!(0 <= slot < TURF_KILL_LOG_SLOTS) ||
		!TurfKillLog[slot][tklActive]
	)
	{
		return 0;
	}

	for(new animPart = 0; animPart < 2; animPart++)
	{
		new textPart = (animPart == 0) ? (1) : (3);
		new targetColour = (animPart == 0) ? TurfKillLog[slot][tklVictimColour] : TurfKillLog[slot][tklKillerColour];

		StopTurfKillLogAnimator(playerid, slot, animPart);

		if(!fadeOut)
		{
			PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][textPart], targetColour & ~0xFF);
			PlayerTextDrawShow(playerid, TURFKILLLOGTD[playerid][slot][textPart]);
		}

		new animator = PlayerText_InterpolateColor(
			playerid,
			TURFKILLLOGTD[playerid][slot][textPart],
			fadeOut ? (targetColour & ~0xFF) : targetColour,
			fadeOut ? TURF_KILL_LOG_EXIT_MS : 420,
			fadeOut ? EASE_IN_QUAD : EASE_OUT_QUART
		);

		if(animator == -1)
		{
			// Animator pool exhaustion must never leave a name invisible.
			PlayerTextDrawColour(playerid, TURFKILLLOGTD[playerid][slot][textPart], targetColour);
			PlayerTextDrawShow(playerid, TURFKILLLOGTD[playerid][slot][textPart]);
			continue;
		}

		TurfKillLogAnimator[playerid][slot][animPart] = animator;
		TurfKillAnimatorPlayer[animator] = playerid;
		TurfKillAnimatorSlot[animator] = slot;
		TurfKillAnimatorPart[animator] = animPart;
	}
	return 1;
}

stock AnimateTurfKillLogNamesForAll(slot, bool:fadeOut)
{
	foreach(new playerid : Player)
	{
		AnimateTurfKillLogNames(playerid, slot, fadeOut);
	}
	return 1;
}

stock RenderTurfKillLogForAll()
{
	foreach(new playerid : Player)
	{
		RenderTurfKillLogForPlayer(playerid);
	}
	return 1;
}

forward BeginTurfKillLogExit(serial);
public BeginTurfKillLogExit(serial)
{
	for(new slot = 0; slot < TURF_KILL_LOG_SLOTS; slot++)
	{
		if(TurfKillLog[slot][tklActive] && TurfKillLog[slot][tklSerial] == serial)
		{
			AnimateTurfKillLogNamesForAll(slot, true);
			break;
		}
	}
	return 1;
}

forward ExpireTurfKillLog(serial);
public ExpireTurfKillLog(serial)
{
	new expiredSlot = -1;

	for(new slot = 0; slot < TURF_KILL_LOG_SLOTS; slot++)
	{
		if(TurfKillLog[slot][tklActive] && TurfKillLog[slot][tklSerial] == serial)
		{
			expiredSlot = slot;
			break;
		}
	}

	// The entry may already have been pushed out by five newer kills.
	if(expiredSlot == -1)
	{
		return 1;
	}

	ClearTurfKillLogEntry(expiredSlot);
	if(TurfKillLogCount > 0) TurfKillLogCount--;
	RenderTurfKillLogSlotForAll(expiredSlot);
	return 1;
}

stock AddTurfKillLog(victimid, killerid)
{
	if(!IsPlayerConnected(victimid) || !IsPlayerConnected(killerid) || victimid == killerid)
	{
		return 0;
	}

	new selectedSlot = -1, oldestSerial = cellmax;
	for(new slot = 0; slot < TURF_KILL_LOG_SLOTS; slot++)
	{
		if(!TurfKillLog[slot][tklActive])
		{
			selectedSlot = slot;
			break;
		}
		if(TurfKillLog[slot][tklSerial] < oldestSerial)
		{
			oldestSerial = TurfKillLog[slot][tklSerial];
			selectedSlot = slot;
		}
	}
	if(selectedSlot == -1) return 0;

	if(!TurfKillLog[selectedSlot][tklActive]) TurfKillLogCount++;

	TurfKillLogSerial++;
	if(TurfKillLogSerial <= 0)
	{
		TurfKillLogSerial = 1;
	}

	TurfKillLog[selectedSlot][tklActive] = true;
	TurfKillLog[selectedSlot][tklSerial] = TurfKillLogSerial;
	TurfKillLog[selectedSlot][tklVictimColour] = GetTurfKillLogColour(victimid);
	TurfKillLog[selectedSlot][tklKillerColour] = GetTurfKillLogColour(killerid);
	format(TurfKillLog[selectedSlot][tklVictimName], MAX_PLAYER_NAME + 1, "%s", GetRPName(victimid));
	format(TurfKillLog[selectedSlot][tklKillerName], MAX_PLAYER_NAME + 1, "%s", GetRPName(killerid));

	RenderTurfKillLogSlotForAll(selectedSlot);
	AnimateTurfKillLogNamesForAll(selectedSlot, false);

	new lifetime = TURF_KILL_LOG_LIFETIME_MS + (selectedSlot * TURF_KILL_LOG_SLOT_STAGGER_MS);
	SetTimerEx("BeginTurfKillLogExit", lifetime - TURF_KILL_LOG_EXIT_MS, false, "i", TurfKillLog[selectedSlot][tklSerial]);
	SetTimerEx("ExpireTurfKillLog", lifetime, false, "i", TurfKillLog[selectedSlot][tklSerial]);
	return 1;
}


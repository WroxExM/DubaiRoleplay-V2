			}
		}
		case DIALOG_ATMWITHDRAWAMOUNT:
		{
			if(response)
			{
				new amount, str[32], string[144];

				if(sscanf(inputtext, "i", amount))
				{
					format(string, sizeof(string), "How much would you like to withdraw? (Your account balance is %s.)", FormatNumber(PlayerInfo[playerid][pBank]));
					return ShowPlayerDialog(playerid, DIALOG_ATMWITHDRAWAMOUNT, DIALOG_STYLE_INPUT,""SVRCLR"Withdraw Amount", string, "Enter", "Cancel");
				}
				if(amount < 1 || amount > PlayerInfo[playerid][pBank])
				{
					format(string, sizeof(string), "How much would you like to withdraw? (Your account balance is %s.)", FormatNumber(PlayerInfo[playerid][pBank]));
					SCMf(playerid, COLOR_REALRED, "Athreem Money Illallo Monee... Please try again.");
					return ShowPlayerDialog(playerid, DIALOG_ATMWITHDRAWAMOUNT, DIALOG_STYLE_INPUT, ""SVRCLR"Withdraw Amount", string, "Enter", "Cancel");
				}

				ATMWithdrawAmount[playerid] = amount;
				format(str, sizeof(str), "%s", FormatNumber(amount));

				PlayerTextDrawSetString(playerid, ATMWITHDRAW[playerid][46], str);
				PlayerTextDrawShow(playerid, ATMWITHDRAW[playerid][46]);
				SCMf(playerid, COLOR_GREEN, "Withdraw amount set to %s.", FormatNumber(amount));
			}
		}
		case DIALOG_ATMDEPOSIT:
		{
			if(response)
			{
				new amount = ATMDepositAmount[playerid];

				if(amount < 1)
				{
					return SCMf(playerid, COLOR_GREY, "You have not entered any deposit amount.");
				}
				if(amount > PlayerInfo[playerid][pCash])
				{
					return SCMf(playerid, COLOR_REALRED, "You do not have enough cash.");
				}

				GivePlayerCash(playerid, -amount);
				PlayerInfo[playerid][pBank] += amount;

				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET bank = %i WHERE uid = %i", PlayerInfo[playerid][pBank],  PlayerInfo[playerid][pID]);
				mysql_tquery(connectionID, queryBuffer);

				SendProximityMessage(playerid, 20.0, COLOR_GLOBAL, "**{C2A2DA} %s presses a button and deposits some cash into the ATM.", GetRPName(playerid));

				SCMf(playerid, COLOR_WHITE, "You have deposited %s into your account. Your new balance is %s.", FormatNumber(amount), FormatNumber(PlayerInfo[playerid][pBank]));

				ATMDepositAmount[playerid] = 0;
				PlayerTextDrawSetString(playerid, ATMDEPOSIT[playerid][46], "0");
				PlayerTextDrawShow(playerid, ATMDEPOSIT[playerid][46]);
			}
		}
		case DIALOG_ATMWITHDRAW:
		{
			if(response)
			{
				new amount = ATMWithdrawAmount[playerid], fee;

				if(amount < 1)
				{
					return SCMf(playerid, COLOR_GREY, "You have not entered any withdraw amount.");
				}
				if(amount > PlayerInfo[playerid][pBank])
				{
					return SCMf(playerid, COLOR_REALRED, "You do not have enough bank balance.");
				}

				PlayerInfo[playerid][pBank] -= amount;
				GivePlayerCash(playerid, amount);

				if(PlayerInfo[playerid][pDonator] == 0)
				{
					fee = percent(amount, 3);
					PlayerInfo[playerid][pBank] -= fee;
					AddToTaxVault(fee);
				}

				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET bank = %i WHERE uid = %i", PlayerInfo[playerid][pBank], PlayerInfo[playerid][pID]);
				mysql_tquery(connectionID, queryBuffer);

				SendProximityMessage(playerid, 20.0, COLOR_GLOBAL, "**{C2A2DA} %s presses a button and withdraws some cash from the ATM.", GetRPName(playerid));
				SCMf(playerid, COLOR_WHITE, "You have withdrawn %s from your account. Your new balance is %s.", FormatNumber(amount), FormatNumber(PlayerInfo[playerid][pBank]));

				if(fee)
				{
					SCMf(playerid, COLOR_WHITE, "A 3 percent convenience fee of %s was deducted from your bank account.", FormatNumber(fee));
				}
				else if(PlayerInfo[playerid][pDonator] > 0)
				{
					SCMf(playerid, COLOR_VIP, "DONATOR Perk: You do not pay the 3 percent convenience fee as you are a Donator!");
				}

				ATMWithdrawAmount[playerid] = 0;
				PlayerTextDrawSetString(playerid, ATMWITHDRAW[playerid][46], "0");
				PlayerTextDrawShow(playerid, ATMWITHDRAW[playerid][46]);
			}
		}
		case DIALOG_BANKDEPOSIT:

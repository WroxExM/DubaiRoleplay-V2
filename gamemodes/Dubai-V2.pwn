stock DisabledDCMD_lookup(DCC_User:user, DCC_Channel:channel, params[])
{
    #pragma unused user

    new DCC_Channel:allowed_channel;

    allowed_channel = DCC_FindChannelById("1500743186618781838");

    // AUTHORIZED CHANNEL CHECK
    if(channel != allowed_channel)
    {
        DCC_SendChannelMessage(channel,
        "`This command can only be used in the authorized channel.`");
        return 1;
    }

    // EMPTY PARAMS CHECK
    if(isnull(params))
    {
        DCC_SendChannelMessage(channel,
        "**Usage:** `!lookup [USERNAME/IP]`");
        return 1;
    }

    new query[256];

    // USERNAME OR IP SEARCH
    mysql_format(connectionID, query, sizeof(query),
    "SELECT username, ip FROM users WHERE username = '%e' OR ip = '%e' LIMIT 1",
    params,
    params
    );

    mysql_tquery(connectionID, query,
    "OnDiscordLookup",
    "is",
    _:channel,
    params);

    return 1;
}

forward OnDiscordLookup(channel, search[]);
public OnDiscordLookup(channel, search[])
{
    if(cache_num_rows())
    {
        new
            username[MAX_PLAYER_NAME],
            ip[32];

        cache_get_value_name(0, "username", username);
        cache_get_value_name(0, "ip", ip);

        new str[512];

        format(str, sizeof(str),
        "??????????????????????\n\
LOOKUP RESULT\n\
??????????????????????\n\n\
Username : %s\n\
IP       : %s\n\n\
??????????????????????",
        username,
        ip
        );

        DCC_SendChannelMessage(DCC_Channel:channel, str);
    }
    else
    {
        new failed[512];

        format(failed, sizeof(failed),
        "??????????????????????\n\
LOOKUP RESULT\n\
??????????????????????\n\n\
Status : FAILED\n\
Reason : No account found\n\
Search : %s\n\n\
??????????????????????",
        search);

        DCC_SendChannelMessage(DCC_Channel:channel, failed);
    }

    return 1;
}


					return 1;
				}

				new targetid = INVALID_PLAYER_ID;
				new count;

				foreach(new i : Player)
				{
					if(i == playerid)
						continue;

					if(!IsPlayerInRangeOfPlayer(playerid, i, 5.0))
						continue;

					if(count == listitem)
					{
						targetid = i;
						break;
					}

					count++;
				}

				if(targetid == INVALID_PLAYER_ID)
				{
					SCMf(playerid, COLOR_LIGHTRED, "Invalid player selected.");
					return 1;
				}

				if(PlayerInfo[targetid][pVehicleKeys] == vehicleid)

forward OnAdminCreatePG(playerid, Garageid, Float:minx, Float:miny, Float:maxx, Float:maxy);
public OnAdminCreatePG(playerid, Garageid, Float:minx, Float:miny, Float:maxx, Float:maxy)
{
	PGInfo[Garageid][pgExists] = 1;
	PGInfo[Garageid][pgMinX] = minx;
	PGInfo[Garageid][pgMinY] = miny;
	PGInfo[Garageid][pgMaxX] = maxx;
	PGInfo[Garageid][pgMaxY] = maxy;
	PGInfo[Garageid][pgGangZone] = -1;
	PGInfo[Garageid][pgArea] = -1;
	

	new Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);

	PGInfo[Garageid][pgPosX] = (minx + maxx) / 2.0;
	PGInfo[Garageid][pgPosY] = (miny + maxy) / 2.0;
	PGInfo[Garageid][pgPosZ] = pz;

	ReloadPG(Garageid);
	SM(playerid, COLOR_YELLOW, "** Garage %i created successfully.", Garageid);
}



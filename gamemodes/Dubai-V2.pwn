public InitPlayerTextDrawBatch6(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	INFOTD[playerid][0] = CreatePlayerTextDraw(playerid, 562.000, 171.000, "_");
    PlayerTextDrawLetterSize(playerid, INFOTD[playerid][0], 0.300, 2.598);
    PlayerTextDrawTextSize(playerid, INFOTD[playerid][0], 0.000, 149.000);
    PlayerTextDrawAlignment(playerid, INFOTD[playerid][0], TEXT_DRAW_ALIGN_CENTER);
    PlayerTextDrawColour(playerid, INFOTD[playerid][0], -1);
    PlayerTextDrawUseBox(playerid, INFOTD[playerid][0], true);
    PlayerTextDrawBoxColour(playerid, INFOTD[playerid][0], 255);
    PlayerTextDrawSetShadow(playerid, INFOTD[playerid][0], 1);
    PlayerTextDrawSetOutline(playerid, INFOTD[playerid][0], 1);
    PlayerTextDrawBackgroundColour(playerid, INFOTD[playerid][0], 150);
    PlayerTextDrawFont(playerid, INFOTD[playerid][0], TEXT_DRAW_FONT_1);
    PlayerTextDrawSetProportional(playerid, INFOTD[playerid][0], true);

    INFOTD[playerid][1] = CreatePlayerTextDraw(playerid, 563.000, 198.000, "_");
    PlayerTextDrawLetterSize(playerid, INFOTD[playerid][1], 0.300, 0.097);
    PlayerTextDrawTextSize(playerid, INFOTD[playerid][1], -26.000, 148.000);
    PlayerTextDrawAlignment(playerid, INFOTD[playerid][1], TEXT_DRAW_ALIGN_CENTER);
    PlayerTextDrawColour(playerid, INFOTD[playerid][1], -1);
    PlayerTextDrawUseBox(playerid, INFOTD[playerid][1], true);
    PlayerTextDrawBoxColour(playerid, INFOTD[playerid][1], 255);

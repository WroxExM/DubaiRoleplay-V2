CMD:selfie(playerid)
{
	if(takingselfie[playerid] == 0)
	{
	    GetPlayerPos(playerid,TX[playerid],TY[playerid],TZ[playerid]);
		static Float: nTX, Float: nTY;
		if(Degree[playerid] >= 360) Degree[playerid] = 0;
		Degree[playerid] += Speed;
		nTX = TX[playerid] + Radius * floatcos(Degree[playerid], degrees);
		nTY = TY[playerid] + Radius * floatsin(Degree[playerid], degrees);
		SetPlayerCameraPos(playerid, nTX, nTY, TZ[playerid] + Height);
		SetPlayerCameraLookAt(playerid, TX[playerid], TY[playerid], TZ[playerid]+1);
		SetPlayerFacingAngle(playerid, Degree[playerid] - 90.0);
		takingselfie[playerid] = 1;
		ApplyAnimationEx(playerid, "PED", "gang_gunstand", 4.1, 1, 1, 1, 1, 1);
		return 1;
	}
    if(takingselfie[playerid] == 1)
	{
	    TogglePlayerControllable(playerid,1);
		SetCameraBehindPlayer(playerid);
	    takingselfie[playerid] = 0;
	    ApplyAnimationEx(playerid, "PED", "ATM", 4.1, 0, 1, 1, 0, 1);
	    return 1;
	}
    return 1;
}
CMD:ph(playerid)
{
	return callcmd::phone(playerid);
}
CMD:phone(playerid)
{
	if(PlayerInfo[playerid][pTogglePhone])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You can't use your mobile phone right now as you have it toggled ((/tog phone)).");
	}
	if(!PlayerInfo[playerid][pPhone])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You don't have a cellphone and therefore can't use this command.");
	}
    if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_WHITE, "Cannot use this command while in-jail.");
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CUFFED || PlayerInfo[playerid][pTazedTime] > 0 || PlayerInfo[playerid][pCuffed] > 0 || PlayerInfo[playerid][pLootTime] > 0)
	    return SendClientMessage(playerid, COLOR_GREY, "You're currently unable to use phone at this moment.");

	SendClientMessage(playerid, COLOR_BLUE, "[TIP] {FFFFFF}Use /cursor to get your cursor back active.");
    SelectTextDraw(playerid,0x33AA33AA);
    for(new i = 0; i < 44; i++) {
	    PlayerTextDrawShow(playerid, LOCKSCREEN[playerid][i]);
		Hideallhuds(playerid);
	}

	SCMf(playerid, COLOR_BLUE, "Check Your Recharge Balance [/balance]");
	return 1;
}

CMD:openhomescreen(playerid)
{

	if(PlayerInfo[playerid][pTogglePhone])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You can't use your mobile phone right now as you have it toggled ((/tog phone)).");
	}
	if(!PlayerInfo[playerid][pPhone])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You don't have a cellphone and therefore can't use this command.");
	}
    if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_WHITE, "Cannot use this command while in-jail.");
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CUFFED || PlayerInfo[playerid][pTazedTime] > 0 || PlayerInfo[playerid][pCuffed] > 0 || PlayerInfo[playerid][pLootTime] > 0)
	    return SendClientMessage(playerid, COLOR_GREY, "You're currently unable to use phone at this moment.");

    for(new i = 0; i < 44; i++) 
	{
		PlayerTextDrawHide(playerid, LOCKSCREEN[playerid][i]);
	}

	SetTimerEx("ShowPhone", 200, false, "i", playerid);
	return 1;

}


CMD:hidesettings(playerid)
{
	for(new i =0; i < 111; i++)
	{
        PlayerTextDrawHide(playerid, SETTINGS[playerid][i]);
    }
	Hideallhuds(playerid);
	SetTimerEx("ShowPhone", 200, false, "i", playerid);
}



CMD:showweaponlic(playerid, params[])
{
    new targetid;

    if(sscanf(params, "u", targetid))
    {
        SCMf(playerid, COLOR_YELLOW, "Usage: /showweaponlic [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(targetid) || !IsPlayerInRangeOfPlayer(playerid, targetid, 5.0))
    {
        SCMf(playerid, COLOR_SYNTAX, "The player specified is disconnected or out of range.");
        return 1;
    }
    if(PlayerInfo[playerid][pWeaponLicense] == 0)
    {
        SCMf(playerid, COLOR_RED, "You don't have a weapon license to show.");
        return 1;
    }

    new string[32];
    format(string, sizeof(string), "%s", PlayerInfo[playerid][pIDCard]);
    PlayerTextDrawSetString(targetid, WEAPONLIC[targetid][10], string);

    PlayerTextDrawSetString(targetid, WEAPONLIC[targetid][9], GetRPName(playerid));

    for(new i = 0; i < 21; i++)
    {
        PlayerTextDrawShow(targetid, WEAPONLIC[playerid][i]);
    }
    SelectTextDraw(targetid, COLOR_RED);



    SCMf(playerid, COLOR_GREEN, "You showed your weapon license to %s.", GetRPName(targetid));
    SCMf(targetid, COLOR_GREEN, "%s has shown you their weapon license.", GetRPName(playerid));

    return 1;
}

CMD:showid(playerid, params[])
{
    new targetid;

    if(sscanf(params, "u", targetid))
    {
        SCMf(playerid, COLOR_YELLOW, "Usage: /showid [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(targetid) || !IsPlayerInRangeOfPlayer(playerid, targetid, 5.0))
    {
        SCMf(playerid, COLOR_SYNTAX, "The player specified is disconnected or out of range.");
        return 1;
    }
	if(PlayerInfo[playerid][pIDCard1] == 0)
	{
		SCMf(playerid, COLOR_RED, "You don't own an ID Card.");
		return 1;
	}

    new string[1024], status[32];

    // Full ID Card Dialog
    format(string, sizeof(string),
    "{FFFFFF}========== ID CARD ==========\n\n\
{Name:} %s\n\
Gender: %s\n\
Age: %d Years Old\n\
ID Card Number: %s\n\
Issued Date: %s\n\
Drivers License: %s\n\
Weapon License: %s\n\
Citizenship: %s",
    GetRPName(playerid),
    (PlayerInfo[playerid][pGender] == 2) ? ("Female") : ("Male"),
    PlayerInfo[playerid][pAge],
    PlayerInfo[playerid][pIDCard],
    PlayerInfo[playerid][pIDCardDate],
    (PlayerInfo[playerid][pCarLicense]) ? ("{00FF00}Yes") : ("{FF0000}No"),
    (PlayerInfo[playerid][pWeaponLicense]) ? ("{00FF00}Yes") : ("{FF0000}No"),
    status);


    if(targetid != playerid)
    {
        SendProximityMessage(playerid, 20.0, SERVER_COLOR, "** {C2A2DA}%s shows their ID card to %s.", GetRPName(playerid), GetRPName(targetid));
    }

    ShowPlayerDialog(targetid, 9999, DIALOG_STYLE_MSGBOX, "Citizen ID Card", string, "Okay", "");
    SCMf(playerid, COLOR_GREEN, "You showed your ID Card.");

    return 1;
}



stock ShowPublicLockerRentDialog(playerid)
{
	new string[256], daysleft = PublicLockerRentDaysLeft(playerid);

	if(daysleft > 0)
	{
		format(string, sizeof(string), "Current rent: %i day(s) left\n\n7 days\t$%i\n15 days\t$%i\n30 days\t$%i", daysleft, PUBLIC_LOCKER_RENT_7DAYS, PUBLIC_LOCKER_RENT_15DAYS, PUBLIC_LOCKER_RENT_30DAYS);
	}
	else if(PlayerInfo[playerid][pPublicLockerExpire] > 0)
	{
		format(string, sizeof(string),
			"Your public locker rent has expired. Your items are still inside.\nRenew to access it again.\n\n7 days\t$%i\n15 days\t$%i\n30 days\t$%i",
			PUBLIC_LOCKER_RENT_7DAYS, PUBLIC_LOCKER_RENT_15DAYS, PUBLIC_LOCKER_RENT_30DAYS);
	}
	else
	{
		format(string, sizeof(string),
			"You need to rent a public locker before you can use it.\n\n7 days\t$%i\n15 days\t$%i\n30 days\t$%i",
			PUBLIC_LOCKER_RENT_7DAYS, PUBLIC_LOCKER_RENT_15DAYS, PUBLIC_LOCKER_RENT_30DAYS);
	}

	ShowPlayerDialog(playerid, DIALOG_RENTPUBLICLOCKER, DIALOG_STYLE_TABLIST, "Public Locker Rent", string, "Select", "Close");
	return 1;
}

stock ShowPublicLockerMenu(playerid, lockerid)
{
	if(lockerid == playerid)
	{
		SendClientMessage(playerid, COLOR_GREY2, "This public locker is monitored by the government. Keep it clean; illegal items can be seized by police.");
	}

	new string[128];
	format(string, sizeof(string), "Cash(%i/100000000)\nDirty Cash(%i/100000000)\nWeapons\nDrugs", PlayerInfo[lockerid][pPSCash], PlayerInfo[lockerid][pPSDCash]);
	ShowPlayerDialog(playerid, DIALOG_PSTASH, DIALOG_STYLE_LIST, "Public Locker", string, "Select", "Close");
	return 1;
}

stock ShowPublicLocker(playerid)
{
	new lockerid = GetPublicLockerOwner(playerid);

	if(lockerid == INVALID_PLAYER_ID)
	{
	    return 1;
	}

	if(lockerid != playerid)
	{
		return ShowPublicLockerMenu(playerid, lockerid);
	}

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT expiredate FROM publiclocker WHERE uid = %i LIMIT 1", PlayerInfo[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer, "OnPublicLockerRentLoaded", "ii", playerid, PlayerInfo[playerid][pID]);
	return 1;
}


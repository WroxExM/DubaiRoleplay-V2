CMD:editatm(playerid, params[])
{
    new atmid, option[32];

    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCMf(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
    }

    if(sscanf(params, "is[32]", atmid, option))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /editatm [atmid] [pos]");
    }

    if(!(0 <= atmid < MAX_ATMS) || !AtmInfo[atmid][aExists])
    {
        return SCMf(playerid, COLOR_GREY, "Invalid ATM ID.");
    }

    if(!strcmp(option, "pos", true))
    {
        pEditAtm[playerid] = atmid;
        PlayerInfo[playerid][pEditType] = 10;

        EditDynamicObject(playerid, AtmInfo[atmid][aObject]);

        SCMf(playerid, COLOR_WHITE, "You are now adjusting the ATM position.");
    }
    return 1;
}

CMD:createatm(playerid, params[])
{
    new Float:x, Float:y, Float:z, Float:a;
	if(PlayerInfo[playerid][pAdmin] < 6)
	{
	    return SCMf(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
	}
    if(sscanf(params, "s[32]", "confirm"))
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "USAGE: /createatm [confirm]");
		SendClientMessage(playerid, COLOR_WHITE, "** NOTE: The ATM will be created at the coordinates you are standing on.");
		return 1;
	}
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "Your virtual world & interior must be 0!");
	}
    GetPlayerPos(playerid, x, y, z);
 	GetPlayerFacingAngle(playerid, a);
    for(new i = 0; i < MAX_ATMS; i ++)
	{
		if(!AtmInfo[i][aExists])
		{
		    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO atms VALUES(null, '%f', '%f', '%f', '%f')", x, y, z, a);
		    mysql_tquery(connectionID, queryBuffer, "OnAdminCreateAtm", "iiffff", playerid, i, x, y, z, a);
		    return 1;
		}
	}

	SendClientMessage(playerid, COLOR_GREY, "ATM slots are currently full. Ask developers to increase the internal limit.");
	return 1;
}


CMD:removeatm(playerid, params[])
{
	new loc;

	if(PlayerInfo[playerid][pAdmin] < 6)
	{
	    return SCMf(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
	}
	if(sscanf(params, "i", loc))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "USAGE: /removeatm [atmid] (/nearest)");
	}
	if(!(0 <= loc < MAX_ATMS) || !AtmInfo[loc][aExists])
	{
	    return SendClientMessage(playerid, COLOR_GREY, "Invalid ATM or Static.");
	}
    DestroyDynamic3DTextLabel(AtmInfo[loc][aText]);
    DestroyDynamicObject(AtmInfo[loc][aObject]);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "DELETE FROM atms WHERE id = %i", AtmInfo[loc][aID]);
	mysql_tquery(connectionID, queryBuffer);
	AtmInfo[loc][aExists] = false;
	AtmInfo[loc][aID] = 0;

	SCMf(playerid, COLOR_WHITE, "** You have removed ATM %i.", loc);
	return 1;
}
CMD:gotoatm(playerid, params[])
{
	new loc;

	if(PlayerInfo[playerid][pAdmin] < 7)
	{
	    return SCMf(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pAdmin] < 7)
	{
	    return SCMf(playerid, COLOR_SYNTAX, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
	if(sscanf(params, "i", loc))
	{
	    return SCMf(playerid, COLOR_SYNTAX, "Usage: /gotoatm [id]");
	}
	if(!(0 <= loc < MAX_ATMS) || !AtmInfo[loc][aExists])
	{
	    return SendClientMessage(playerid, COLOR_GREY, "Invalid ATM or Static.");
	}

	GameTextForPlayer(playerid, "~w~Teleported", 5000, 1);

	SetPlayerPos(playerid, AtmInfo[loc][aPosX], AtmInfo[loc][aPosY], AtmInfo[loc][aPosZ]);
	SetPlayerFacingAngle(playerid, AtmInfo[loc][aPosA]);
	SetCameraBehindPlayer(playerid);
	return 1;
}

// faction garage

CMD:createfg(playerid, params[])
{
    new factionid;

    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCMf(playerid, -1, "Not authorized.");
    }

    if(sscanf(params, "i", factionid))
    {
        return SCMf(playerid, -1, "/createfg [1-3]");
    }

    new Float:x, Float:y, Float:z, Float:a;

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    for(new i; i < MAX_FGARAGE; i++)
    {
        if(!FGInfo[i][fgExists])
        {
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO factiongarages (faction, pos_x, pos_y, pos_z, pos_a) VALUES (%d, '%f', '%f', '%f', '%f')", factionid, x, y, z, a);
            mysql_tquery(connectionID, queryBuffer, "OnFactionGarageCreated", "iiffffi", playerid, i, x, y, z, a, factionid);

            return 1;
        }
    }

    return SCMf(playerid, -1, "FG slots full.");
}


CMD:removefg(playerid, params[])
{
    new id;

    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCMf(playerid, -1, "Not authorized.");
    }

    if(sscanf(params, "i", id))
    {
        return SCMf(playerid, -1, "/removefg [id]");
    }

    if(!(0 <= id < MAX_FGARAGE))
    {
        return SCMf(playerid, -1, "Invalid ID.");
    }

    if(!FGInfo[id][fgExists])
    {
        return SCMf(playerid, -1, "FG doesn't exist.");
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "DELETE FROM factiongarages WHERE id = %d", FGInfo[id][fgID]);
    mysql_tquery(connectionID, queryBuffer);

    DestroyDynamic3DTextLabel(FGInfo[id][fgText]);
    DestroyDynamicObject(FGInfo[id][fgObject]);
    FGInfo[id][fgExists] = false;
    SCMf(playerid, -1, "Faction Garage %d removed.", id);

    return 1;
}

// gang garage
CMD:creategg(playerid, params[])
{
    new gangid, Float:size;

    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCMf(playerid, -1, "Not authorized.");
    }

    if(sscanf(params, "if", gangid, size))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /creategg [gangid] [radius]");
    }

    if(!(0 <= gangid < MAX_GANGS) || (gangid >= 0 && !GangInfo[gangid][gSetup]))
    {
        return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid gang.");
    }

    if(size <= 0.0 || size > 100.0)
    {
        return SCMf(playerid, COLOR_SYNTAX, "Radius must be between 0.1 and 100.0.");
    }

    new Float:x, Float:y, Float:z, Float:a;

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    for(new i; i < MAX_GGARAGE; i++)
    {
        if(!GGInfo[i][ggExists])
        {
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO ganggarage (gangid, pos_x, pos_y, pos_z, pos_r, area) VALUES (%d, '%f', '%f', '%f', '%f', '%f')", gangid, x, y, z, a, size);
            mysql_tquery(connectionID, queryBuffer, "OnCreateGG", "iiifffff", playerid, i, gangid, x, y, z, a, size);
            return 1;
        }
    }

    return SCMf(playerid, COLOR_SYNTAX, "Gang garage slots are full.");
}

CMD:removegg(playerid, params[])
{
    new id;

    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCMf(playerid, -1, "Not authorized.");
    }

    if(sscanf(params, "i", id))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /removegg [garageid]");
    }

    if(!(0 <= id < MAX_GGARAGE) || !GGInfo[id][ggExists])
    {
        return SCMf(playerid, COLOR_SYNTAX, "Invalid gang garage.");

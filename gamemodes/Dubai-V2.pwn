        strcat(str, "\n{E0B9FF} /explode, /event, /gplay, /gplayurl, /gstop, /sethpall, /setarmorall, /settime, /addtoevent");
    }
    if(PlayerInfo[playerid][pAdmin] >= 5)
    {
        strcat(str, "\n{FFB347}[EXE-5] Executive Administrator:");
        strcat(str, "\n{FFE2A8} /givemoneyall, /givejacketall, /setdonator, /forcepayday, /givebackpack, /clearreports");
        strcat(str, "\n{FFE2A8} /removedonator, /rangeban, /doublexp, /previewint, /nearest, /dynamichelp, /setscore, /resetbackpack");

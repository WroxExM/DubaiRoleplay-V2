CMD:gotopg(playerid, params[])
{
    new Garageid;

    if(PlayerInfo[playerid][pAdmin] < 1)
    {
        return SCMf(playerid, COLOR_RED, "You are not authorized to use this command.");
    }
    if(sscanf(params, "d", Garageid))
    {
        return SCMf(playerid, COLOR_SYNTAX, "Usage: /gotopg [Garage ID]");
    }
    if(!(0 <= Garageid < MAX_PGARAGE) || !PGInfo[Garageid][pgExists])
    {
        return SCMf(playerid, COLOR_RED, "Invalid Public Garage ID.");
    }

    SetPlayerPos(playerid, PGInfo[Garageid][pgPosX], PGInfo[Garageid][pgPosY], PGInfo[Garageid][pgPosZ] + 1.0);

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);

    SCMf(playerid, COLOR_GREEN, "You have teleported to Public Garage ID %d.", Garageid);

    return 1;
}


GetVehicleModelByName(const string[])
{
	new
	    modelid = strval(string);

	if(400 <= modelid <= 611)
	{
	    return modelid;
	}

	for(new i = 0; i < sizeof(vehicleNames); i ++)
	{
		if(strfind(vehicleNames[i], string, true) != -1)
  		{
			return i + 400;
		}
	}

	return 0;
}

AnticheatCheck(playerid)
{
	// Nex-AC handles: AirBreak, Teleport, SpeedHack, FlyHack, Health/Armour hack, Weapon hack, etc.
	// This function only handles checks that Nex-AC does NOT cover or needs custom logic.
	// Exempt: not logged, kicked, in tutorial, admin, event, paintball, duel, spectating, jail, injured
	if(IsPlayerACExempt(playerid)) return 1;

	// Speedhacking (custom threshold for vehicles - Nex-AC has its own, but this catches extreme cases)
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetVehicleSpeed(GetPlayerVehicleID(playerid)) > 400)
	{
	    AC_HandleWarning(playerid, "Extreme Speed Hack (vehicle > 400 km/h)", 10);
	    return 1;
	}

	// Jetpack (Nex-AC code 18, but custom check for unauthorized jetpack use)
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK && !PlayerInfo[playerid][pJetpack])
	{
	    AC_HandleWarning(playerid, "Unauthorized Jetpack", 18);
	    return 1;
	}

	// Armor hacks (custom check with proper exemptions)
	if(!PlayerInfo[playerid][pJoinedEvent] && PlayerInfo[playerid][pPaintball] == 0 && PlayerInfo[playerid][pDueling] == INVALID_PLAYER_ID)
	{
	    new Float:armor;
	    GetPlayerArmour(playerid, armor);

	    if(!(gettime() - PlayerInfo[playerid][pLastUpdate] > 5))
	    {
	        if(floatround(armor) > floatround(PlayerInfo[playerid][pArmor]) && gettime() > PlayerInfo[playerid][pACTime] && gettime() > PlayerInfo[playerid][pArmorTime])
	        {
	            PlayerInfo[playerid][pACWarns]++;
	            PlayerInfo[playerid][pArmorTime] = gettime() + 10;

	            if(PlayerInfo[playerid][pACWarns] < MAX_ANTICHEAT_WARNINGS)
	            {
	                SAM(COLOR_YELLOW, "AdmWarning: %s[%i] is possibly armor hacking. (old: %.2f, new: %.2f)", GetRPName(playerid), playerid, PlayerInfo[playerid][pArmor], armor);
	            }
	            else
	            {
	                AC_HandleWarning(playerid, "Armor Hack", 13);
	            }
	        }
	    }
	    PlayerInfo[playerid][pArmor] = armor;
	}

	// Ammo hacks - remove grenades with 0 ammo (custom, Nex-AC doesn't cover this)
	if(!PlayerInfo[playerid][pJoinedEvent] && PlayerInfo[playerid][pDueling] == INVALID_PLAYER_ID && !(PlayerInfo[playerid][pTazer] && GetPlayerWeapon(playerid) == 23))
	{
	    new weapon, ammo;
	    GetPlayerWeaponData(playerid, 8, weapon, ammo);

	    if((16 <= weapon <= 18) && ammo <= 0)
	    {
	        RemovePlayerWeaponEx(playerid, weapon);
	    }
	}

	return 1;
}

IsAnIP(const ip[])
{
	new part[4];

	if(!sscanf(ip, "p<.>iiii", part[0], part[1], part[2], part[3]))
	{
	    return (0 <= part[0] <= 255) && (0 <= part[1] <= 255) && (0 <= part[2] <= 255) && (0 <= part[3] <= 255);
	}
	else if(!sscanf(ip, "p<.>iicc", part[0], part[1], part[2], part[3]))
	{
	    return (0 <= part[0] <= 255) && (0 <= part[1] <= 255) && (part[2] == '*' && part[3] == '*');
	}

	return 0;
}

IsValidName(const name[])
{
	for(new i = 0, j = strlen(name); i < j; i ++)
	{
	    if(!(3 <= j <= MAX_PLAYER_NAME))
	        return 0;

	    switch(name[i])
	    {
	        case 'A'..'Z', 'a'..'z', '0'..'9', '_', '.', '[', ']', '(', ')', '=', '@':
	        {
	            continue;
			}
			default:
			{
			    return 0;
			}
		}
	}

	return 1;
}


CMD:gmark(playerid, params[])
{
    new Float:x, Float:y, Float:z, Float:a;
    if(PlayerInfo[playerid][pGang] == -1)
    {
        return SendClientMessage(playerid, COLOR_SYNTAX, "You are not apart of any gang at the moment.");
    }
    if(PlayerInfo[playerid][pInjured])
    {
        return SendClientMessage(playerid, COLOR_SYNTAX, "You cannot call for backup when you are dead.");
    }
    if(PlayerInfo[playerid][pCuffed])
    {
         return SendClientMessage(playerid, COLOR_SYNTAX, "You cannot use this command while cuffed.");
    }
    if(PlayerInfo[playerid][pTied])
    {
        return SendClientMessage(playerid, COLOR_SYNTAX, "You cannot use this command while tied.");
    }
    if(PlayerInfo[playerid][pToggleGmark])
    {
        return SendClientMessage(playerid, COLOR_SYNTAX, "You can't speak in the gang war chat as you have it toggled.");
    }
    if(PlayerInfo[playerid][pLocCooldown] > 0)
    {
        return SM(playerid, COLOR_SYNTAX, "You need to wait %i more seconds before you can send gmark.", PlayerInfo[playerid][pLocCooldown]);
    }
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    PlayerInfo[playerid][pLocCooldown] = 0;

    foreach(new i : Player)
    {
        if(PlayerInfo[i][pGang] == PlayerInfo[playerid][pGang] && !PlayerInfo[i][pToggleGmark])
        {
            SM(i, COLOR_RED, "** %s %s Marked Gmark in map at %s **", GangRanks[PlayerInfo[playerid][pGang]][PlayerInfo[playerid][pGangRank]], GetRPName(playerid), GetPlayerZoneName(playerid));
            //SetPlayerRaceCheckpoint(i, x, y, z, 3.0);
            SetPlayerRaceCheckpoint(i, 1, x + 3 , y + 3, z, 0.0,0.0,0.0, 5.0);
            SetTimerEx("ClearGmarkCheckpoint", 5000, false, "i", i);
        }
    }
    return 1;
}

forward ClearGmarkCheckpoint(playerid);
public ClearGmarkCheckpoint(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        DisablePlayerRaceCheckpoint(playerid);
    }
    return 1;
}


CMD:prio(playerid, params[])
{
	new text[128];
	if(GetFactionType(playerid) != FACTION_POLICE && PlayerInfo[playerid][pAdmin] < 2)
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "You must be a Police Officer or Admin Level 2+ to use this command.");
	}
	if(sscanf(params, "s[128]", text))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "Usage: /prio [text]");
	}
	foreach(new i : Player)
	{
		DynamicTextDrawSetString(Textdraw2, text);
		for(new f = 0; f < 3; f ++)
		{
          TextDrawShowForPlayer(playerid, Textdraw2);
		}
		SetTimerEx("Textdraw2Hide", 453845128, false, "i", i);
		PlayerPlaySound(i,1150,0.0,0.0,0.0);
	}
	return 1;
}



CMD:craftweapon(playerid, params[])
{
	new fid = GetNearbyFactory(playerid);
	if (fid == -1) return SM(playerid, COLOR_ERROR, "[Factory] You are not near a weapon factory.");
	if (!FactoryHasGangAccess(playerid, fid)) return SM(playerid, COLOR_ERROR, "[Factory] Your gang does not own this factory.");
	WeaponFactoryPlayer[playerid][wfpFactory] = fid;
	ShowPlayerDialog(playerid, DIALOG_WF_WEAPON, DIALOG_STYLE_LIST,
		"Select Weapon", "Desert Eagle\nM4 Rifle", "Select", "Cancel");
	return 1;
}

CMD:factoryinfo(playerid, params[])
{
	new fid = GetNearbyFactory(playerid);
	if (fid == -1) fid = FactoryGetNearbyLocker(playerid);
	if (fid == -1) return SM(playerid, COLOR_ERROR, "[Factory] You are not near a weapon factory.");
	FactoryRefreshFactory(fid);
	new status[24], weapon[24], nextCrate[24], cooldown[32], text[768];
	FactoryGetStatusText(fid, status, sizeof status);
	if (WeaponFactory[fid][wfProdWeapon]) WeaponName(WeaponFactory[fid][wfProdWeapon], weapon, sizeof weapon);
	else format(weapon, sizeof weapon, "None");

	new nextTime = FactoryGetNextCrateTime(fid);
	if (nextTime == -1) format(nextCrate, sizeof nextCrate, "None");
	else FactoryFormatClock(nextTime, nextCrate, sizeof nextCrate);

	format(cooldown, sizeof cooldown, "None");
	if (WeaponFactory[fid][wfCooldownEnd] > gettime())
	{
		new left = WeaponFactory[fid][wfCooldownEnd] - gettime();
		format(cooldown, sizeof cooldown, "%dh %dm", left / 3600, (left % 3600) / 60);
	}

	format(text, sizeof text,
		"Factory ID: %d\nOwner: %s\nHealth: %d%%\nStatus: %s\n\nProduction Weapon: %s\nProgress: %d/%d\nNext Crate: %s\nCooldown: %s\n\nLocker M4: %d/100\nLocker Deagle: %d/100\n\nCrates Spawned: %d\nCrates Lost: %d",
		fid, WeaponFactory[fid][wfOwnerName], WeaponFactory[fid][wfHealth], status,
		weapon, WeaponFactory[fid][wfProdProgress], WeaponFactory[fid][wfProdAmount],
		nextCrate, cooldown, WeaponFactory[fid][wfLockerM4], WeaponFactory[fid][wfLockerDeagle],
		WeaponFactory[fid][wfCratesSpawned], WeaponFactory[fid][wfCratesLost]);
	ShowPlayerDialog(playerid, DIALOG_WF_INFO, DIALOG_STYLE_MSGBOX, "Weapon Factory Information", text, "Close", "");
	return 1;
}


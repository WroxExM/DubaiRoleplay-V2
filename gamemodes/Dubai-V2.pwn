stock ResetDealershipPlayer(playerid, bool:destroyVehicle)
{
    if(destroyVehicle)
    {
        if(IsValidVehicle(pDealershipPreviewVehicle[playerid]))
        {
            DestroyVehicle(pDealershipPreviewVehicle[playerid]);
        }
        if(IsValidVehicle(pDealershipVehicle[playerid]))
        {
            DestroyVehicle(pDealershipVehicle[playerid]);
        }
    }

    pDealershipViewing[playerid] = false;
    pDealershipID[playerid] = DEALERSHIP_INVALID;
    pDealershipVehicle[playerid] = INVALID_VEHICLE_ID;
    pDealershipSelected[playerid] = 0;
    pDealershipColor1[playerid] = 1;
    pDealershipColor2[playerid] = 1;
    pTestDealership[playerid] = false;
    pTestDealershipTime[playerid] = 0;
    pDealershipPreviewVehicle[playerid] = INVALID_VEHICLE_ID;
    pDealershipBuying[playerid] = false;
    return 1;
}

stock GetNearbyShowroom(playerid)
{
    for(new i = 0; i < MAX_SHOWROOMS; i++)
    {
        if(ShowRoomInfo[i][sExists] &&
            GetPlayerVirtualWorld(playerid) == ShowRoomInfo[i][sWorld] &&
            IsPlayerInRangeOfPoint(playerid, 10.0, ShowRoomInfo[i][sPosX], ShowRoomInfo[i][sPosY], ShowRoomInfo[i][sPosZ]))
        {
            return i;
        }
    }
    return DEALERSHIP_INVALID;
}

stock bool:IsShowroomOwner(playerid, sid)
{
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return false;
    return (ShowRoomInfo[sid][sOwnerID] == PlayerInfo[playerid][pID]) || (ShowRoomInfo[sid][sOwnerID] > 0 && PlayerInfo[playerid][pAdminDuty]);
}

stock ReloadShowroom(sid)
{
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return 0;

    new string[192];

    if(ShowRoomInfo[sid][sText] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(ShowRoomInfo[sid][sText]);
    }
    if(ShowRoomInfo[sid][sPickup] != -1)
    {
        DestroyDynamicPickup(ShowRoomInfo[sid][sPickup]);
    }

    format(string, sizeof(string), "{00BFFF}Vehicle Dealership (%i)\nOwner: %s\n{FFFFFF}/buyvehicle", sid, ShowRoomInfo[sid][sOwner]);
    ShowRoomInfo[sid][sText] = CreateDynamic3DTextLabel(string, COLOR_WHITE, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ] + 0.25, 12.0, .worldid = ShowRoomInfo[sid][sWorld], .interiorid = 0);
    ShowRoomInfo[sid][sPickup] = CreateDynamicPickup(1239, 1, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ], .worldid = ShowRoomInfo[sid][sWorld]);
    return 1;
}

stock SetShowroomOwner(sid, playerid)
{
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return 0;

    if(playerid == INVALID_PLAYER_ID)
    {
        ShowRoomInfo[sid][sOwnerID] = 0;
        strcpy(ShowRoomInfo[sid][sOwner], "Nobody", MAX_PLAYER_NAME);
    }
    else
    {
        ShowRoomInfo[sid][sOwnerID] = PlayerInfo[playerid][pID];
        GetPlayerName(playerid, ShowRoomInfo[sid][sOwner], MAX_PLAYER_NAME);
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE dealerships SET ownerid = %i, owner = '%e' WHERE id = %i", ShowRoomInfo[sid][sOwnerID], ShowRoomInfo[sid][sOwner], ShowRoomInfo[sid][sID]);
    mysql_tquery(connectionID, queryBuffer);

    ReloadShowroom(sid);
    return 1;
}

stock UpdateShowroomVehicleTD(playerid)
{
    new sid = pDealershipID[playerid];
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return 0;

    new selected = pDealershipSelected[playerid];
    new modelid = vehicleArray[selected][carModel];
    new string[96];

    PlayerTextDrawSetPreviewModel(playerid, SHOWROOMTD[playerid][32], modelid);
    PlayerTextDrawSetPreviewVehicleColours(playerid, SHOWROOMTD[playerid][32], pDealershipColor1[playerid], pDealershipColor2[playerid]);

    PlayerTextDrawSetString(playerid, SHOWROOMTD[playerid][33], vehicleNames[modelid - 400]);

    format(string, sizeof(string), "$%s", AddCommas(vehicleArray[selected][carPrice]));
    PlayerTextDrawSetString(playerid, SHOWROOMTD[playerid][36], string);

    PlayerTextDrawSetString(playerid, SHOWROOMTD[playerid][40], ShowRoomInfo[sid][sOwner]);
    return 1;
}

stock SpawnShowroomPreviewVehicle(playerid)
{
    new sid = pDealershipID[playerid];
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return 0;

    if(IsValidVehicle(pDealershipPreviewVehicle[playerid]))
    {
        DestroyVehicle(pDealershipPreviewVehicle[playerid]);
    }

    new modelid = vehicleArray[pDealershipSelected[playerid]][carModel];
    pDealershipPreviewVehicle[playerid] = CreateVehicle(modelid,
        ShowRoomInfo[sid][sVehX],
        ShowRoomInfo[sid][sVehY],
        ShowRoomInfo[sid][sVehZ],
        ShowRoomInfo[sid][sVehA],
        pDealershipColor1[playerid],
        pDealershipColor2[playerid],
        -1);

    SetVehicleVirtualWorld(pDealershipPreviewVehicle[playerid], playerid + 5000);
    LinkVehicleToInterior(pDealershipPreviewVehicle[playerid], GetPlayerInterior(playerid));
    return 1;
}

stock OpenDealershipShowroom(playerid, sid)
{
    ResetDealershipPlayer(playerid, true);

    pDealershipViewing[playerid] = true;
    pDealershipID[playerid] = sid;
    pDealershipSelected[playerid] = 0;
    pDealershipColor1[playerid] = 1;
    pDealershipColor2[playerid] = 1;

    TogglePlayerControllable(playerid, 0);
    SetPlayerVirtualWorld(playerid, playerid + 5000);
    SetPlayerCameraPos(playerid, ShowRoomInfo[sid][sCamX], ShowRoomInfo[sid][sCamY], ShowRoomInfo[sid][sCamZ]);
    SetPlayerCameraLookAt(playerid, ShowRoomInfo[sid][sLookX], ShowRoomInfo[sid][sLookY], ShowRoomInfo[sid][sLookZ]);

    SpawnShowroomPreviewVehicle(playerid);
    UpdateShowroomVehicleTD(playerid);
    ShowShowroomTextDraws(playerid);
    return 1;
}

stock ExitDealershipShowroom(playerid, bool:teleportBack)
{
    new sid = pDealershipID[playerid];

    HideShowroomTextDraws(playerid);

    if(IsValidVehicle(pDealershipPreviewVehicle[playerid]))
    {
        DestroyVehicle(pDealershipPreviewVehicle[playerid]);
    }
    if(IsValidVehicle(pDealershipVehicle[playerid]))
    {
        DestroyVehicle(pDealershipVehicle[playerid]);
    }

    if(teleportBack && 0 <= sid < MAX_SHOWROOMS && ShowRoomInfo[sid][sExists])
    {
        SetPlayerPos(playerid, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ]);
        SetPlayerFacingAngle(playerid, ShowRoomInfo[sid][sPosA]);
        SetPlayerVirtualWorld(playerid, ShowRoomInfo[sid][sWorld]);
    }

    SetCameraBehindPlayer(playerid);
    TogglePlayerControllable(playerid, 1);
    ResetDealershipPlayer(playerid, false);
    return 1;
}

stock SelectDealershipVehicle(playerid, direction)
{
    if(!pDealershipViewing[playerid]) return 0;

    pDealershipSelected[playerid] += direction;
    if(pDealershipSelected[playerid] < 0)
    {
        pDealershipSelected[playerid] = sizeof(vehicleArray) - 1;
    }
    else if(pDealershipSelected[playerid] >= sizeof(vehicleArray))
    {
        pDealershipSelected[playerid] = 0;
    }

    SpawnShowroomPreviewVehicle(playerid);
    UpdateShowroomVehicleTD(playerid);
    return 1;
}

stock SetDealershipColor(playerid, color)
{
    if(!pDealershipViewing[playerid]) return 0;

    pDealershipColor1[playerid] = color;
    pDealershipColor2[playerid] = color;

    if(IsValidVehicle(pDealershipPreviewVehicle[playerid]))
    {
        ChangeVehicleColor(pDealershipPreviewVehicle[playerid], color, color);
    }

    UpdateShowroomVehicleTD(playerid);
    return 1;
}

stock StartDealershipTestDrive(playerid)
{
    if(!pDealershipViewing[playerid]) return 0;

    new sid = pDealershipID[playerid];
    if(!(0 <= sid < MAX_SHOWROOMS) || !ShowRoomInfo[sid][sExists]) return 0;

    HideShowroomTextDraws(playerid);

    if(IsValidVehicle(pDealershipPreviewVehicle[playerid]))
    {
        DestroyVehicle(pDealershipPreviewVehicle[playerid]);
        pDealershipPreviewVehicle[playerid] = INVALID_VEHICLE_ID;
    }

    pDealershipVehicle[playerid] = CreateVehicle(vehicleArray[pDealershipSelected[playerid]][carModel],
        ShowRoomInfo[sid][sPosX] + 4.0,
        ShowRoomInfo[sid][sPosY],
        ShowRoomInfo[sid][sPosZ],
        ShowRoomInfo[sid][sPosA],
        pDealershipColor1[playerid],
        pDealershipColor2[playerid],
        -1);

    SetVehicleVirtualWorld(pDealershipVehicle[playerid], ShowRoomInfo[sid][sWorld]);
    LinkVehicleToInterior(pDealershipVehicle[playerid], GetPlayerInterior(playerid));
    SetPlayerVirtualWorld(playerid, ShowRoomInfo[sid][sWorld]);
    TogglePlayerControllable(playerid, 1);
    SetCameraBehindPlayer(playerid);
    PutPlayerInVehicle(playerid, pDealershipVehicle[playerid], 0);

    pTestDealership[playerid] = true;
    pTestDealershipTime[playerid] = 30;
    return 1;
}

stock EndDealershipTestDrive(playerid)
{
    new sid = pDealershipID[playerid];
    new bool:freezeReturn = false;

    if(IsValidVehicle(pDealershipVehicle[playerid]))
    {
        DestroyVehicle(pDealershipVehicle[playerid]);
    }

    if(0 <= sid < MAX_SHOWROOMS && ShowRoomInfo[sid][sExists])
    {
        SetPlayerPos(playerid, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ] + 0.75);
        SetPlayerFacingAngle(playerid, ShowRoomInfo[sid][sPosA]);
        SetPlayerVirtualWorld(playerid, ShowRoomInfo[sid][sWorld]);
        Streamer_UpdateEx(playerid, ShowRoomInfo[sid][sPosX], ShowRoomInfo[sid][sPosY], ShowRoomInfo[sid][sPosZ]);
        TogglePlayerControllable(playerid, 0);
        SetTimerEx("Dealership_ReturnUnfreeze", 3000, false, "i", playerid);
        freezeReturn = true;
    }

    SetCameraBehindPlayer(playerid);
    if(!freezeReturn)
    {
        TogglePlayerControllable(playerid, 1);
    }
    ResetDealershipPlayer(playerid, false);
    return 1;
}

stock ProcessDealershipTestDrives()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !pTestDealership[i]) continue;

        pTestDealershipTime[i]--;
        if(pTestDealershipTime[i] <= 0)
        {
            ShowTDN(i, "Your dealership test drive has ended.");
            EndDealershipTestDrive(i);
        }
    }
    return 1;
}

stock Dealership_OnPlayerExitVehicle(playerid, vehicleid)
{
    if(pTestDealership[playerid] && vehicleid == pDealershipVehicle[playerid])
    {
        ShowTDN(playerid, "You left the test drive vehicle. Test drive cancelled.");
        EndDealershipTestDrive(playerid);
        return 1;
    }
    return 0;
}

forward Dealership_ReturnUnfreeze(playerid);
public Dealership_ReturnUnfreeze(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        TogglePlayerControllable(playerid, 1);
        SetCameraBehindPlayer(playerid);
    }
    return 1;
}

stock InitLeaveSystem()
{
    LeaveActiveCount = 0;
    LeaveSearchCursor = 0;

    if(LeaveTimer == -1)
    {
        LeaveTimer = SetTimer("UpdateLeaveSystem", 1000, true);
    }
    print("[Leave System] Initialized by WroxExM Successfully.");

    return 1;
}

forward ResetVehiclesStartupChunk();
public ResetVehiclesStartupChunk()
{
    new processed;

    while(StartupVehicleResetIndex < MAX_VEHICLES && processed < 75)
    {
        ResetVehicle(StartupVehicleResetIndex);
        StartupVehicleResetIndex++;
        processed++;
    }

    if(StartupVehicleResetIndex < MAX_VEHICLES)
    {
        SetTimer("ResetVehiclesStartupChunk", 25, false);
    }
    else
    {
        print("[Vehicle System] Startup vehicle reset completed.");
    }
    return 1;
}

stock InitVehicleResetStartup()
{
    StartupVehicleResetIndex = 0;
    SetTimer("ResetVehiclesStartupChunk", 50, false);
    return 1;
}

stock GetEmptyLeaveSlot()
{
    for(new checked = 0; checked < sizeof(LeaveData); checked++)
    {
        new i = (LeaveSearchCursor + checked) % sizeof(LeaveData);

        if(!LeaveData[i][leaveExists])
        {
            LeaveSearchCursor = (i + 1) % sizeof(LeaveData);
            return i;
        }
    }

    return -1;
}

stock GetLeaveReason(reason, dest[], size = sizeof(dest))
{
    switch(reason)
    {
        case 0:
        {
            format(dest, size, "Timeout / Crash");
        }
        case 1:
        {
            format(dest, size, "Left The Server");
        }
        case 2:
        {
            format(dest, size, "Kicked / Banned");
        }
        default:
        {
            format(dest, size, "Unknown");
        }
    }

    return 1;
}


stock CreateLeave(playerid, reason)
{
    new slot = GetEmptyLeaveSlot();

    if(slot == -1)
    {
        return 0;
    }

    new
        Float:x,
        Float:y,
        Float:z;

    GetPlayerPos(playerid, x, y, z);
    LeaveData[slot][leaveExists] = true;
    LeaveData[slot][leaveType] = reason;
    LeaveData[slot][leaveAccountID] = PlayerInfo[playerid][pID];
    LeaveData[slot][leaveText] = Text3D:INVALID_3DTEXT_ID;
    LeaveData[slot][leaveObject] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    LeaveData[slot][leaveTurfID] = -1;
    LeaveData[slot][leaveTurfGeneration] = 0;
    LeaveData[slot][leaveTurfRelogExpire] = 0;
    GetLeaveReason(reason, LeaveData[slot][leaveReason]);

    // Preserve a sealed-turf participant by account, never by the reusable
    // player slot. Leaving the area first still uses the normal 15-second rule.
    new turfid = -1;
    if(PlayerInfo[playerid][pLogged] && PlayerInfo[playerid][pID] > 0)
    {
        for(new i = 0; i < MAX_TURFS; i++)
        {
            if(!TurfInfo[i][tExists] || !TurfInfo[i][tLocked]) continue;
            if(gTurfPersonalUnlock[playerid][i] || !gTurfLockAccess[playerid][i] || gTurfLockout[playerid][i] || gTurfExitGrace[playerid][i]) continue;
            turfid = i;
            break;
        }
        if(turfid != -1)
        {
            LeaveData[slot][leaveTurfID] = turfid;
            LeaveData[slot][leaveTurfGeneration] = gTurfLockGeneration[turfid];
            LeaveData[slot][leaveTurfRelogExpire] = gettime() + TURF_RELOG_GRACE_SECONDS;
        }
    }

    format(LeaveData[slot][leavePlayer], MAX_PLAYER_NAME, "%s", GetRPName(playerid));

    LeaveData[slot][leavePosX] = x;
    LeaveData[slot][leavePosY] = y;
    LeaveData[slot][leavePosZ] = z;
    LeaveData[slot][leaveVW] = GetPlayerVirtualWorld(playerid);
    LeaveData[slot][leaveInterior] = GetPlayerInterior(playerid);
    LeaveData[slot][leaveExpire] = gettime() + 180;

    new label[256];
    format(label, sizeof(label), "{FF0000}Disconnected Player\n\n" "{FFFFFF}Name: {00BFFF}%s\n""{FFFFFF}Reason: {FF6666}%s\n" "{FFFFFF}Removing In: {FFD700}%d Seconds",LeaveData[slot][leavePlayer], LeaveData[slot][leaveReason], 180);
	LeaveData[slot][leaveObject] = CreateDynamicObject(18631, x, y, z + 0.5, 0.0, 0.0, 0.0, LeaveData[slot][leaveVW], LeaveData[slot][leaveInterior]);
    LeaveData[slot][leaveText] = CreateDynamic3DTextLabel(label, 0xFFFFFFFF, x, y,  z + 0.25, 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, LeaveData[slot][leaveVW], LeaveData[slot][leaveInterior]);
    LeaveActiveCount++;

    return 1;
}

stock DestroyLeave(slot)
{
    if(slot < 0 || slot >= sizeof(LeaveData))
    {
        return 0;
    }
    if(!LeaveData[slot][leaveExists])
    {
        return 0;
    }
    if(IsValidDynamic3DTextLabel(LeaveData[slot][leaveText]))
    {
        DestroyDynamic3DTextLabel(LeaveData[slot][leaveText]);
    }
    if(IsValidDynamicObject(LeaveData[slot][leaveObject]))
    {
        DestroyDynamicObject(LeaveData[slot][leaveObject]);
    }

    LeaveData[slot][leaveExists] = false;
    LeaveData[slot][leaveType] = 0;
    LeaveData[slot][leaveAccountID] = 0;
    LeaveData[slot][leavePlayer][0] = EOS;
    LeaveData[slot][leaveReason][0] = EOS;
    LeaveData[slot][leavePosX] = 0.0;
    LeaveData[slot][leavePosY] = 0.0;
    LeaveData[slot][leavePosZ] = 0.0;
    LeaveData[slot][leaveVW] = 0;
    LeaveData[slot][leaveInterior] = 0;
    LeaveData[slot][leaveExpire] = 0;
    LeaveData[slot][leaveTurfID] = -1;
    LeaveData[slot][leaveTurfGeneration] = 0;
    LeaveData[slot][leaveTurfRelogExpire] = 0;
    LeaveData[slot][leaveText] = Text3D:INVALID_3DTEXT_ID;
    LeaveData[slot][leaveObject] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    if(LeaveActiveCount > 0)
    {
        LeaveActiveCount--;
    }

    return 1;
}

forward UpdateLeaveSystem();
public UpdateLeaveSystem()
{
    if(LeaveActiveCount <= 0)
    {
        return 1;
    }

    new currentTime = gettime();

    for(new i = 0; i < sizeof(LeaveData); i++)
    {
        if(LeaveData[i][leaveExists])
        {
            new remaining = LeaveData[i][leaveExpire] - currentTime;

            if(remaining <= 0)
            {
                DestroyLeave(i);
                continue;
            }

            new text[256];
			format(text, sizeof(text),
				"{FF0000}Disconnected Player\n\n\
				{FFFFFF}Name: {00BFFF}%s\n\
				{FFFFFF}Reason: {FF6666}%s\n\
				{FFFFFF}Removing In: {FFD700}%d Seconds",
				LeaveData[i][leavePlayer],
				LeaveData[i][leaveReason],
				remaining);

            UpdateDynamic3DTextLabelText(
                LeaveData[i][leaveText],
                0xFFFFFFFF,
                text
            );
        }
    }

    return 1;
}



// repair stations
GetNearbyRS(playerid)
{
	new nearest = -1;
	new Float:nearestDistance = REPAIR_STATION_RANGE;

	for(new i = 0; i < MAX_REPAIRSTATION; i ++)
	{
		if(!RSInfo[i][rsExists])
		{
			continue;
		}

		new Float:distance = GetPlayerDistanceFromPoint(playerid, RSInfo[i][rsPosX], RSInfo[i][rsPosY], RSInfo[i][rsPosZ]);
		if(distance <= nearestDistance)
		{
			nearest = i;
			nearestDistance = distance;
		}
	}
	return nearest;
}

RepairAtNearbyStation(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetVehicleParams(vehicleid, VEHICLE_ENGINE))
	{
		SetVehicleParams(vehicleid, VEHICLE_ENGINE, VEHICLE_PARAMS_OFF);
	}

	return TimerSelfRepair(playerid);
}

ReloadRS(atmid)
{
    if(RSInfo[atmid][rsExists])
    {
        DestroyDynamic3DTextLabel(RSInfo[atmid][rsText]);
        DestroyDynamicObject(RSInfo[atmid][rsObject]);
        DestroyDynamicMapIcon(RSInfo[atmid][rsMapIcon]);

        RSInfo[atmid][rsText] = CreateDynamic3DTextLabel("{00BFFF}Repair Station\n\n{FFFFFF}Press [HORN] to repair your vehicle.", COLOR_YELLOW, RSInfo[atmid][rsPosX], RSInfo[atmid][rsPosY], RSInfo[atmid][rsPosZ] + 0.4, 20.0);
        RSInfo[atmid][rsObject] = CreateDynamicObject(19131, RSInfo[atmid][rsPosX], RSInfo[atmid][rsPosY], RSInfo[atmid][rsPosZ], 0.0, 0.0, RSInfo[atmid][rsPosA]);
        RSInfo[atmid][rsMapIcon] = CreateDynamicMapIcon(RSInfo[atmid][rsPosX], RSInfo[atmid][rsPosY], RSInfo[atmid][rsPosZ], 27, 1, -1, -1, -1, 500.0);
    }
}

GetNearbyFuelStation(playerid)
{
    for(new i = 0; i < MAX_FUEL_STATIONS; i++)
    {
        if(FuelInfo[i][feExists] && IsPlayerInRangeOfPoint(playerid, 10.0, FuelInfo[i][fePosx], FuelInfo[i][fePosy], FuelInfo[i][fePosz]))
        {
            return i;
        }
    }
    return -1;
}

SetFuelOwner(fuelid, playerid)
{
    if(playerid == INVALID_PLAYER_ID)
    {
        strcpy(FuelInfo[fuelid][feOwner], "Nobody", MAX_PLAYER_NAME);
        FuelInfo[fuelid][feOwnerID] = 0;
    }
    else
    {
        GetPlayerName(playerid, FuelInfo[fuelid][feOwner], MAX_PLAYER_NAME);
        FuelInfo[fuelid][feOwnerID] = PlayerInfo[playerid][pID];
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE fuelstations SET ownerid = %i, owner = '%e' WHERE id = %i", FuelInfo[fuelid][feOwnerID], FuelInfo[fuelid][feOwner], FuelInfo[fuelid][feID]);
    mysql_tquery(connectionID, queryBuffer);

    ReloadFuel(fuelid);
    return 1;
}

ReloadFuel(fuelid)
{
    if(FuelInfo[fuelid][feExists] == 1)
    {
        new string[256];

        if(IsValidDynamic3DTextLabel(FuelInfo[fuelid][feText])) DestroyDynamic3DTextLabel(FuelInfo[fuelid][feText]);
        if(IsValidDynamicObject(FuelInfo[fuelid][feObject])) DestroyDynamicObject(FuelInfo[fuelid][feObject]);
        if(FuelInfo[fuelid][feMapIcon] != -1) DestroyDynamicMapIcon(FuelInfo[fuelid][feMapIcon]);

        if(FuelInfo[fuelid][feOwnerID] == 0)
        {
            format(string, sizeof(string), "{FFD700}Station Owned By: Nobody\nLitres: %sL/%sL", AddCommas(FuelInfo[fuelid][feStock]), AddCommas(FuelInfo[fuelid][feCapacity]));
        }
        else
        {
            format(string, sizeof(string), "{FFFF00} Station Owned By: %s\nLitres: %sL/%sL\n [/refuel]", FuelInfo[fuelid][feOwner], AddCommas(FuelInfo[fuelid][feStock]), AddCommas(FuelInfo[fuelid][feCapacity]));
        }

        FuelInfo[fuelid][feText] = CreateDynamic3DTextLabel(string, COLOR_YELLOW, FuelInfo[fuelid][fePosx], FuelInfo[fuelid][fePosy], FuelInfo[fuelid][fePosz] - 0.2, 15.0, .worldid = FuelInfo[fuelid][feWorld], .interiorid = 0);
        FuelInfo[fuelid][feObject] = CreateDynamicObject(3465, FuelInfo[fuelid][fePosx], FuelInfo[fuelid][fePosy], FuelInfo[fuelid][fePosz], 0.0, 0.0, FuelInfo[fuelid][fePosa], .worldid = FuelInfo[fuelid][feWorld]);
        FuelInfo[fuelid][feMapIcon] = CreateDynamicMapIcon(FuelInfo[fuelid][fePosx], FuelInfo[fuelid][fePosy], FuelInfo[fuelid][fePosz], 40, 0, .style = MAPICON_GLOBAL);
    }
    return 1;
}
IsFuelStationOwner(playerid, fuelid)
{
    return (FuelInfo[fuelid][feOwnerID] == PlayerInfo[playerid][pID]) || (FuelInfo[fuelid][feOwnerID] > 0 && PlayerInfo[playerid][pAdminDuty]);
}

// ATM System
GetNearbyAtm(playerid)
{
	for(new i = 0; i < MAX_ATMS; i ++)
	{
	    if(AtmInfo[i][aExists] && IsPlayerInRangeOfPoint(playerid, 3.0, AtmInfo[i][aPosX], AtmInfo[i][aPosY], AtmInfo[i][aPosZ]))
	    {
	        return i;
	    }
	}
	return -1;
}
ReloadAtm(atmid)
{
	if(AtmInfo[atmid][aExists])
	{
	    DestroyDynamic3DTextLabel(AtmInfo[atmid][aText]);
	    DestroyDynamicObject(AtmInfo[atmid][aObject]);

		AtmInfo[atmid][aText] = CreateDynamic3DTextLabel("ATM machine\nType "WHITE"'/atm'"GREEN" to operate.", COLOR_TEAL, AtmInfo[atmid][aPosX], AtmInfo[atmid][aPosY], AtmInfo[atmid][aPosZ] + 0.4, 10.0);
        AtmInfo[atmid][aObject] = CreateDynamicObject(19324, AtmInfo[atmid][aPosX], AtmInfo[atmid][aPosY], AtmInfo[atmid][aPosZ], 0.0, 0.0, AtmInfo[atmid][aPosA]);
	}
}

ReloadPG(Garageid)
{
    if(Garageid < 0 || Garageid >= MAX_PGARAGE)
        return 0;

    if(!PGInfo[Garageid][pgExists])
        return 0;

    if(PGInfo[Garageid][pgArea] != -1)
    {
        DestroyDynamicArea(PGInfo[Garageid][pgArea]);
        PGInfo[Garageid][pgArea] = -1;
    }
    if(PGInfo[Garageid][pgGangZone] != -1)
    {
        GangZoneDestroy(PGInfo[Garageid][pgGangZone]);
        PGInfo[Garageid][pgGangZone] = -1;
    }
    if(PGInfo[Garageid][pgMapIcon] != -1)
    {
        DestroyDynamicMapIcon(PGInfo[Garageid][pgMapIcon]);
        PGInfo[Garageid][pgMapIcon] = -1;
    }

	new Float:minX, Float:maxX, Float:minY, Float:maxY;

	if(PGInfo[Garageid][pgMinX] < PGInfo[Garageid][pgMaxX])
	{
		minX = PGInfo[Garageid][pgMinX];
		maxX = PGInfo[Garageid][pgMaxX];
	}
	else
	{
		minX = PGInfo[Garageid][pgMaxX];
		maxX = PGInfo[Garageid][pgMinX];
	}

	if(PGInfo[Garageid][pgMinY] < PGInfo[Garageid][pgMaxY])
	{
		minY = PGInfo[Garageid][pgMinY];
		maxY = PGInfo[Garageid][pgMaxY];
	}
	else
	{
		minY = PGInfo[Garageid][pgMaxY];
		maxY = PGInfo[Garageid][pgMinY];
	}

	PGInfo[Garageid][pgMapIcon] = CreateDynamicMapIcon(PGInfo[Garageid][pgPosX], PGInfo[Garageid][pgPosY], PGInfo[Garageid][pgPosZ], 55, 1, -1, -1, -1, 300.0);
	PGInfo[Garageid][pgArea] = CreateDynamicRectangle(minX, minY, maxX, maxY);
	PGInfo[Garageid][pgGangZone] = GangZoneCreateEx(minX, minY, maxX, maxY);
	

    return 1;
}


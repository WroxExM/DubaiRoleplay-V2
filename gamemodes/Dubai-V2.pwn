forward InitDeferredPlayerTextDraws(playerid, generation);
public InitDeferredPlayerTextDraws(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	// These panels are not needed for the first login frame, so keep OnPlayerConnect light.
	CreateShowroomTextDraws(playerid);
	CreateAdvTurfPlayerTD(playerid);
	CreateAdvTurfAdminTD(playerid);
	SetTimerEx("InitPlayerTextDrawBatch1", 75 + ((playerid % 10) * 25), false, "ii", playerid, generation);
	return 1;
}

forward InitDeferredPlayerMapping(playerid, generation);
public InitDeferredPlayerMapping(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	RemoveMappingObject(playerid);
	return 1;
}


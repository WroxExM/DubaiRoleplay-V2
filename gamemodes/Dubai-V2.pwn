	gTurfDeathReentryArmed[playerid] = false;
	gDeathPositionValid[playerid] = false;
	gDeathInterior[playerid] = 0;
	gDeathWorld[playerid] = 0;
    ResetDealershipPlayer(playerid, false);

	// Discord connection log embed
	PlayerConnectTick[playerid] = gettime();
	{
		new connectTime[16], connectDate[16];
		new cHour, cMinute, cSecond, cYear, cMonth, cDay;
		gettime(cHour, cMinute, cSecond);
		getdate(cYear, cMonth, cDay);

		// IST offset (UTC+5:30)
		cMinute += 30;
		cHour += 5;
		if(cMinute >= 60) { cMinute -= 60; cHour++; }
		if(cHour >= 24) { cHour -= 24; cDay++; }

		new period[] = "AM";
		new dispHour = cHour;
		if(dispHour >= 12) { period = "PM"; if(dispHour > 12) dispHour -= 12; }
		if(dispHour == 0) dispHour = 12;

		format(connectTime, sizeof(connectTime), "%02d:%02d:%02d %s IST", dispHour, cMinute, cSecond, period);
		format(connectDate, sizeof(connectDate), "%02d/%02d/%d", cDay, cMonth, cYear);

		new embedDescription[256];
		format(embedDescription, sizeof(embedDescription),
			"```ansi\nServer Connection Time : %s\nConnection Date       : %s\nConnection Username   : %s\nConnection IP         : %s\n```",
			connectTime, connectDate, GetPlayerNameEx(playerid), GetPlayerIP(playerid));

		if(g_DiscordConnectLog)
		{
			new DCC_Embed:embed = DCC_CreateEmbed("", embedDescription, "", "", 0x2ECC71, "Dubai Roleplay V2", "", "https://i.imgur.com/yourlogo.png", "");
			DCC_SendChannelEmbedMessage(g_DiscordConnectLog, embed);

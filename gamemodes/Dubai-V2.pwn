			if(response)
			{
				new amount;

				if(sscanf(inputtext, "i", amount))
				{
					return SCMf(playerid, COLOR_GREY, "Invalid amount.");
				}
				if(amount < 1)
				{
					return SCMf(playerid, COLOR_GREY, "Invalid amount.");
				}
				if(amount > PlayerInfo[playerid][pBank])
				{
					return SCMf(playerid, COLOR_RED, "Insufficient bank balance.");
				}

				SetPVarInt(playerid, "transfer_amount", amount);

				new str[64];

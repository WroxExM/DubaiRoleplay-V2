				GGInfo[slot][ggText] = Text3D:INVALID_3DTEXT_ID;
				GGInfo[slot][ggPickup] = -1;
				GGInfo[slot][ggMapIcon] = -1;
				GGInfo[slot][ggExists] = true;

				ReloadGG(slot);
				loaded++;
			}

			printf("[Script] %i Gang Garages loaded.", loaded);
		}

	SetTimerEx("RandomFire", 7200000, true, "i", 1);
	SetTimer("VehicleTimer", 700, true);
	SetTimer("SaveAccount", 1000, true); // Staggered autosave: one logged-in player per second.

	// Misc
    LoadServerInfo();
    RefreshTime();
    ResetEvent();
    ResetRobbery();
	gLastSave = 0;
	gLastFix = 0;

	SendRconCommand("weburl \t"SERVER_URL"");
	SetGameModeText(REVISION);
	print(SERVER_NAME);


	new count;
	for(new i = 0; i < MAX_OBJECTS; i++)
	{
		if(IsValidObject(i))
		{
			count++;
		}
	}

	printf("%i objects loaded.", count);

	return 1;
}

public OnGameModeExit()
{
	new savedPlayers;
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(!IsPlayerConnected(i) || IsPlayerNPC(i) || !PlayerInfo[i][pLogged] || PlayerInfo[i][pAdminDuty])
		{
			continue;
		}

		// /gmx already waits for its queued saves before unloading. For an
		// external host restart, make the complete final save synchronous so
		// mysql_close cannot discard the worker-queue tail.
		if(!gGMX)
		{
			SavePlayerVariablesOptimized(i, true, true);
		}
		++savedPlayers;
	}
	printf("[Database] Saved %d connected player(s) before shutdown.", savedPlayers);

	mysql_close(connectionID);

	// Do not destroy server-owned textdraws or menus here. During an open.mp
	// host restart their components may already be shutting down, and the
	// server discards these entities with the gamemode automatically.

	if(gDoubleXP)
	{
	    gDoubleXP = 0;
	}

	if(gRobbery)
	{
		gRobbery = 0;
	}

	if(gDoubleSalary)
	{
	    gDoubleSalary = 0;
	}

	return 1;
}



forward FinishFuelLoading(playerid);
public FinishFuelLoading(playerid)
{
    if(!IsPlayerConnected(playerid))
    {
        return 1;
    }

    if(!FillingFuel[playerid])
    {
        return 1;
    }

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
    {
        CancelFuelLoading(playerid);
        return 1;
    }

    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetVehicleModel(vehicleid) != 403)
    {
        CancelFuelLoading(playerid);
        return 1;
    }
    if(!IsTrailerAttachedToVehicle(vehicleid))
    {
        CancelFuelLoading(playerid);
        return 1;
    }

    FillingFuel[playerid] = 0;
    FuelLoaded[playerid] = 1;

    TogglePlayerControllable(playerid, 1);
    SendClientMessage(playerid, COLOR_GREEN, "* Fuel tank filled successfully.");

    switch(random(4))
    {
        case 0:
        {
            FuelCheckpoint[playerid] = 0;

            SetPlayerCheckpoint(playerid, 1506.286132, -1674.358154, 13.635014, 10.0);
            StartTracing(playerid, 1506.286132, -1674.358154, 13.635014);
            SendClientMessage(playerid, COLOR_YELLOW, "* Deliver fuel to Los Santos.");
        }
        case 1:
        {
            FuelCheckpoint[playerid] = 1;

            SetPlayerCheckpoint(playerid, 985.304138, -928.557495, 41.960857, 10.0);
            StartTracing(playerid, 985.304138, -928.557495, 41.960857);
            SendClientMessage(playerid, COLOR_YELLOW, "* Deliver fuel to Gas Station.");
        }
        case 2:
        {
            FuelCheckpoint[playerid] = 2;
            SetPlayerCheckpoint(playerid, 2192.966308, 2477.448974, 10.820312,10.0);
            StartTracing(playerid, 2192.966308, 2477.448974, 10.820312);
            SendClientMessage(playerid, COLOR_YELLOW,"* Deliver fuel to Las Venturas.");
        }
        case 3:
        {
            FuelCheckpoint[playerid] = 3;
            SetPlayerCheckpoint(playerid, 656.635986, 1717.208374, 6.992187, 10.0);
            StartTracing(playerid, 656.635986, 1717.208374, 6.992187);
            SendClientMessage(playerid, COLOR_YELLOW, "* Deliver fuel to Bone County.");
        }
    }

    return 1;
}

stock CancelFuelLoading(playerid)
{
    if(FillingFuel[playerid])
    {
        FillingFuel[playerid] = 0;
        KillTimer(FuelTimer1[playerid]);
        TogglePlayerControllable(playerid, 1);
        SendClientMessage(playerid, COLOR_RED, "* Fuel loading cancelled.");
    }

    return 1;
}



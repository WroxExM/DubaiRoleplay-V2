                PlayerInfo[extraid][pLogged] = 1;
                PlayerInfo[extraid][pACTime] = gettime() + 5;
                InitNewbieWeaponLock(extraid);
                RestoreAdvancedTurfRelogAccess(extraid);
                SetTimerEx("ValidateTurfRelogPosition", 2000, false, "ii", extraid, PlayerTextDrawInitGeneration[extraid]);

                cache_get_value_name_int(0, "rarecooldown", PlayerInfo[extraid][pRareTime]);

	PlayerInfo[playerid][pGased1] = false;

	Streamer_ToggleIdleUpdate(playerid, true);
	GetPlayerName(playerid, PlayerInfo[playerid][pUsername], MAX_PLAYER_NAME);

	PlayerLabel[playerid] = CreateDynamic3DTextLabel("", -1, 0.0, 0.0, -1.5, 10, .attachedplayer = playerid, .testlos = 1);

	gConnections++;
	SaveServerInfo();
	return 1;
}

public InitPlayerTextDrawBatch1(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || generation != PlayerTextDrawInitGeneration[playerid])
	{
		return 1;
	}

	WEAPONLIC[playerid][0] = CreatePlayerTextDraw(playerid, 536.000, 133.000, "_");
	PlayerTextDrawLetterSize(playerid, WEAPONLIC[playerid][0], 0.600, 9.347);
	PlayerTextDrawTextSize(playerid, WEAPONLIC[playerid][0], 335.500, 157.000);
	PlayerTextDrawAlignment(playerid, WEAPONLIC[playerid][0], TEXT_DRAW_ALIGN_CENTER);
	PlayerTextDrawColour(playerid, WEAPONLIC[playerid][0], 255);
	PlayerTextDrawUseBox(playerid, WEAPONLIC[playerid][0], true);
	PlayerTextDrawBoxColour(playerid, WEAPONLIC[playerid][0], 255);
	PlayerTextDrawSetShadow(playerid, WEAPONLIC[playerid][0], 0);
	PlayerTextDrawSetOutline(playerid, WEAPONLIC[playerid][0], 1);
	PlayerTextDrawBackgroundColour(playerid, WEAPONLIC[playerid][0], 255);
	PlayerTextDrawFont(playerid, WEAPONLIC[playerid][0], TEXT_DRAW_FONT_1);
	PlayerTextDrawSetProportional(playerid, WEAPONLIC[playerid][0], true);

	WEAPONLIC[playerid][1] = CreatePlayerTextDraw(playerid, 536.000, 121.000, "_");
	PlayerTextDrawLetterSize(playerid, WEAPONLIC[playerid][1], 0.460, 11.848);

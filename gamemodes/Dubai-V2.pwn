stock UpdateFuelUI(playerid, fuelid)
{
    new string[64];

    format(string, sizeof(string), "%s/L", AddCommas(FuelInfo[fuelid][feFuelPrice]));
    PlayerTextDrawSetString(playerid, FUELUI[playerid][17], string);

    format(string, sizeof(string), "%s", AddCommas(PlayerInfo[playerid][pRefuelAmount]));
    PlayerTextDrawSetString(playerid, FUELUI[playerid][19], string);

    new Float:progress;
    new Float:size;

    progress = float(FuelInfo[fuelid][feStock]) / float(FuelInfo[fuelid][feCapacity]);

    if(progress < 0.0) progress = 0.0;
    if(progress > 1.0) progress = 1.0;

    size = progress * 83.0;

    if(size < 1.0 && FuelInfo[fuelid][feStock] > 0)
    {
        size = 1.0;
    }

    PlayerTextDrawTextSize(playerid, FUELUI[playerid][29], 27.0 + size, 0.0);
    PlayerTextDrawShow(playerid, FUELUI[playerid][29]);

    return 1;
}
stock ShowFuelUI(playerid, fuelid)
{
    for(new i = 0; i < 31; i++)
    {
        PlayerTextDrawShow(playerid, FUELUI[playerid][i]);
    }
    PlayerInfo[playerid][pRefuelAmount] = 0;
    SelectTextDraw(playerid, COLOR_YELLOW);
    UpdateFuelUI(playerid, fuelid);

    return 1;
}

stock HideFuelUI(playerid)
{
    for(new i = 0; i < 31; i++)
    {
        PlayerTextDrawHide(playerid, FUELUI[playerid][i]);
    }
    CancelSelectTextDraw(playerid);

    return 1;
}


ResetClotheSetup(playerid)
{
	PlayerInfo[playerid][pSkin] = g_MaleSkins[0];
	PlayerInfo[playerid][pOutfit] = 0;

	SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
	UpdateClotheSetup(playerid);
}
UpdateClotheSetup(playerid)
{
	new string[64];
	format(string, sizeof(string), "%i/%i", PlayerInfo[playerid][pOutfit] + 1, (PlayerInfo[playerid][pGender] == GENDER_MALE ? sizeof(g_MaleSkins) : sizeof(g_FemaleSkins)));
	DynamicPlayerTextDrawSetString(playerid, ClotheTD[playerid][3], string);
}
UpdateClotheSelection(playerid, index)
{
	new size;

	if (PlayerInfo[playerid][pGender] == GENDER_MALE) {
		size = sizeof(g_MaleSkins);
	} else if (PlayerInfo[playerid][pGender] == GENDER_FEMALE) {
		size = sizeof(g_FemaleSkins);
	}

	if (index < 0) {
		index = --size;
	} else if (index >= size) {
		index = 0;
	}

	PlayerInfo[playerid][pOutfit] = index;

	if (PlayerInfo[playerid][pGender] == GENDER_MALE) {
		PlayerInfo[playerid][pSkin] = g_MaleSkins[index];
	} else if (PlayerInfo[playerid][pGender] == GENDER_FEMALE) {
		PlayerInfo[playerid][pSkin] = g_FemaleSkins[index];
	}

	SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
}

ResetCharacterSetup(playerid)
{
    if(PlayerInfo[playerid][pSetup])
    {
        PlayerInfo[playerid][pSkin] = g_MaleSkins[0];
        PlayerInfo[playerid][pAge] = 13;
        PlayerInfo[playerid][pGender] = GENDER_MALE;
        PlayerInfo[playerid][pOutfit] = 0;

        GenderTick[playerid] = 0;

        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
    }

    return 1;
}



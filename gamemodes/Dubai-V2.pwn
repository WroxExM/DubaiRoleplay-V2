stock SetVehicleFuelLevel(vehicleid, fuel)
{
	if(fuel < 0) fuel = 0;
	else if(fuel > 100) fuel = 100;

	VehicleInfo[vehicleid][vFuel] = fuel;
	vehicleFuel[vehicleid] = fuel;
	return 1;
}

stock GetVehicleFuelLevel(vehicleid)
{
	return VehicleInfo[vehicleid][vFuel];
}

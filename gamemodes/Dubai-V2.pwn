		SM(targetid, COLOR_GREEN, "** %s offered to sell you %i grams of Cocaine for $%i. (/accept item)", GetRPName(playerid), amount, price);
		SM(playerid, COLOR_GREEN, "** You have offered to sell %s your %i grams of Cocaine for $%i.", GetRPName(targetid), amount, price);
	}
	else if(!strcmp(option, "meth", true))
	{

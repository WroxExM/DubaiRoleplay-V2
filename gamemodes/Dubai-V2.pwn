    PlayerTextDrawSetOutline(playerid, INFOTD[playerid][1], 1);
    PlayerTextDrawBackgroundColour(playerid, INFOTD[playerid][1], 150);
    PlayerTextDrawFont(playerid, INFOTD[playerid][1], TEXT_DRAW_FONT_1);
    PlayerTextDrawSetProportional(playerid, INFOTD[playerid][1], true);

    INFOTD[playerid][2] = CreatePlayerTextDraw(playerid, 488.000, 199.000, "_");
    PlayerTextDrawLetterSize(playerid, INFOTD[playerid][2], 0.300, 0.097);
    PlayerTextDrawTextSize(playerid, INFOTD[playerid][2], 637.000, 145.000);
    PlayerTextDrawAlignment(playerid, INFOTD[playerid][2], TEXT_DRAW_ALIGN_LEFT);
    PlayerTextDrawColour(playerid, INFOTD[playerid][2], -1);

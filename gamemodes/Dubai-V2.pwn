stock GetAdvancedTurfModeName(turfid)
{
	new name[16];
	switch(TurfInfo[turfid][tConfigMode])
	{
		case 1: name = "Influence";
		case 2: name = "Open";
		default: name = "Not Set";
	}
	return name;
}

stock GetAdvancedTurfGangName(gangid)
{
	new name[32];
	if(0 <= gangid < MAX_GANGS && GangInfo[gangid][gSetup])
	{
		format(name, sizeof(name), "%s", GangInfo[gangid][gName]);
	}
	else
	{
		format(name, sizeof(name), "None");
	}
	return name;
}

stock FormatAdvancedTurfClock(seconds)
{
	new text[12];
	if(seconds < 0) seconds = 0;
	format(text, sizeof(text), "%02d:%02d", seconds / 60, seconds % 60);
	return text;
}

stock GetISTDateTime(dateText[], dateSize, timeText[], timeSize)
{
	new unixTimestamp = gettime() + 19800;
	new days = unixTimestamp / 86400;
	new seconds = unixTimestamp % 86400;
	new hour = seconds / 3600;
	new minute = (seconds % 3600) / 60;
	new second = seconds % 60;

	new z = days + 719468;
	new era = (z >= 0 ? z : z - 146096) / 146097;
	new doe = z - era * 146097;
	new yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
	new y = yoe + era * 400;
	new doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
	new mp = (5 * doy + 2) / 153;
	new day = doy - (153 * mp + 2) / 5 + 1;
	new month = mp + (mp < 10 ? 3 : -9);
	new year = y + ((month <= 2) ? 1 : 0);
	new displayHour = hour % 12;
	new period[3];

	if(displayHour == 0) displayHour = 12;
	format(period, sizeof(period), "%s", (hour >= 12) ? ("PM") : ("AM"));
	format(dateText, dateSize, "%02d/%02d/%04d", day, month, year);
	format(timeText, timeSize, "%02d:%02d:%02d %s IST", displayHour, minute, second, period);
	return 1;
}

stock GetTurfPlayerAffiliation(playerid, affiliation[], size)
{
	if(0 <= PlayerInfo[playerid][pGang] < MAX_GANGS && GangInfo[PlayerInfo[playerid][pGang]][gSetup])
	{
		format(affiliation, size, "%s", GangInfo[PlayerInfo[playerid][pGang]][gName]);
	}
	else if(IsLawEnforcement(playerid))
	{
		format(affiliation, size, "Police");
	}
	else
	{
		format(affiliation, size, "Unaffiliated");
	}
	return 1;
}

stock GetAdvancedTurfDate()
{
	new text[16], timeText[24];
	GetISTDateTime(text, sizeof(text), timeText, sizeof(timeText));
	return text;
}

stock GetAdvancedTurfTime()
{
	new text[24], dateText[16];
	GetISTDateTime(dateText, sizeof(dateText), text, sizeof(text));
	return text;
}

stock IsValidAdvancedTurfGang(gangid)
{
	return (0 <= gangid < MAX_GANGS && GangInfo[gangid][gSetup]);
}

stock IsValidAdvancedTurfMember(playerid)
{
	if(!PlayerInfo[playerid][pLogged]) return 0;
	if(PlayerInfo[playerid][pInjured]) return 0;
	if(PlayerInfo[playerid][pAdminDuty]) return 0;
	if(!(0 <= PlayerInfo[playerid][pGang] < MAX_GANGS)) return 0;
	return GangInfo[PlayerInfo[playerid][pGang]][gSetup];
}

stock GetActiveAdvancedTurfFromArea(areaid)
{
	for(new i = 0; i < MAX_TURFS; i++)
	{
		if(TurfInfo[i][tExists] && (TurfInfo[i][tActive] || TurfInfo[i][tLocked]) && TurfInfo[i][tArea] == areaid)
		{
			return i;
		}
	}
	return -1;
}

stock IsAllowedAdvancedTurfGang(playerid, turfid)
{
	if(TurfInfo[turfid][tConfigMode] == 2) return 1;
	if(PlayerInfo[playerid][pGang] == TurfInfo[turfid][tAttackerGang]) return 1;
	if(PlayerInfo[playerid][pGang] == TurfInfo[turfid][tDefenderGang]) return 1;
	return 0;
}

stock IsPlayerInsideTurfBoundary(playerid, turfid)
{
	if(!IsPlayerConnected(playerid) || !(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return 0;
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return 0;

	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	return (TurfInfo[turfid][tMinX] <= x <= TurfInfo[turfid][tMaxX] && TurfInfo[turfid][tMinY] <= y <= TurfInfo[turfid][tMaxY]);
}

stock ResetTurfExitGrace(playerid, turfid)
{
	gTurfExitGrace[playerid][turfid] = false;
	gTurfExitGraceExpiry[playerid][turfid] = 0;
	gTurfExitGraceVehicle[playerid][turfid] = INVALID_VEHICLE_ID;
	return 1;
}

stock CanSendTurfSecurityNotice(playerid, turfid)
{
	if(gettime() < gTurfSecurityNotifyExpiry[playerid][turfid]) return 0;
	gTurfSecurityNotifyExpiry[playerid][turfid] = gettime() + TURF_SECURITY_NOTIFY_DELAY;
	return 1;
}

stock SetTurfBoundaryLockCooldown(playerid)
{
	SetPVarInt(playerid, "TurfLockCooldown", GetTickCount() + TURF_LOCK_COOLDOWN_MS);
	return 1;
}

stock IsTurfBoundaryLockCoolingDown(playerid)
{
	if(!GetPVarType(playerid, "TurfLockCooldown")) return 0;

	new remaining = GetPVarInt(playerid, "TurfLockCooldown") - GetTickCount();
	if(remaining > 0 && remaining <= TURF_LOCK_COOLDOWN_MS)
	{
		return 1;
	}

	DeletePVar(playerid, "TurfLockCooldown");
	return 0;
}

stock MovePlayerToLockedTurfSide(playerid, turfid, bool:entering)
{
	if(!IsPlayerConnected(playerid) || !(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return 0;

	new Float:x, Float:y, Float:z, Float:newX, Float:newY;
	GetPlayerPos(playerid, x, y, z);
	newX = x;
	newY = y;

	if(entering)
	{
		new Float:nearest = x - TurfInfo[turfid][tMinX], Float:edge, nearestSide;
		edge = TurfInfo[turfid][tMaxX] - x;
		if(edge < nearest)
		{
			nearest = edge;
			nearestSide = 1;
		}
		edge = y - TurfInfo[turfid][tMinY];
		if(edge < nearest)
		{
			nearest = edge;
			nearestSide = 2;
		}
		edge = TurfInfo[turfid][tMaxY] - y;
		if(edge < nearest)
		{
			nearestSide = 3;
		}

		if(nearestSide == 0)
		{
			newX = TurfInfo[turfid][tMinX] - TURF_WALL_SAFE_OFFSET;
		}
		else if(nearestSide == 1)
		{
			newX = TurfInfo[turfid][tMaxX] + TURF_WALL_SAFE_OFFSET;
		}
		else if(nearestSide == 2)
		{
			newY = TurfInfo[turfid][tMinY] - TURF_WALL_SAFE_OFFSET;
		}
		else
		{
			newY = TurfInfo[turfid][tMaxY] + TURF_WALL_SAFE_OFFSET;
		}
	}
	else
	{
		new bool:corrected;
		if(x <= TurfInfo[turfid][tMinX])
		{
			newX = TurfInfo[turfid][tMinX] + TURF_WALL_SAFE_OFFSET;
			corrected = true;
		}
		else if(x >= TurfInfo[turfid][tMaxX])
		{
			newX = TurfInfo[turfid][tMaxX] - TURF_WALL_SAFE_OFFSET;
			corrected = true;
		}
		if(y <= TurfInfo[turfid][tMinY])
		{
			newY = TurfInfo[turfid][tMinY] + TURF_WALL_SAFE_OFFSET;
			corrected = true;
		}
		else if(y >= TurfInfo[turfid][tMaxY])
		{
			newY = TurfInfo[turfid][tMaxY] - TURF_WALL_SAFE_OFFSET;
			corrected = true;
		}

		// Streamer callbacks can arrive while the player is still on the edge.
		if(!corrected)
		{
			newX = (TurfInfo[turfid][tMinX] + TurfInfo[turfid][tMaxX]) / 2.0;
			newY = (TurfInfo[turfid][tMinY] + TurfInfo[turfid][tMaxY]) / 2.0;
		}
	}

	if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsValidVehicle(vehicleid))
		{
			new Float:vehicleZ;
			GetVehiclePos(vehicleid, x, y, vehicleZ);
			foreach(new i : Player)
			{
				if(IsPlayerInAnyVehicle(i) && GetPlayerVehicleID(i) == vehicleid)
				{
					SetTurfBoundaryLockCooldown(i);
				}
			}
			SetVehiclePos(vehicleid, newX, newY, vehicleZ);
			SetVehicleVelocity(vehicleid, 0.0, 0.0, 0.0);
			return 1;
		}
	}
	else if(IsPlayerInAnyVehicle(playerid))
	{
		// Never drag an authorized driver's whole vehicle across the wall just
		// because one passenger has no access. Eject only that passenger.
		RemovePlayerFromVehicle(playerid);
	}

	SetTurfBoundaryLockCooldown(playerid);
	SetPlayerPos(playerid, newX, newY, z);
	SetPlayerVelocity(playerid, 0.0, 0.0, 0.0);
	return 1;
}

stock BeginTurfExitGrace(playerid, turfid)
{
	if(gTurfPersonalUnlock[playerid][turfid]) return 0;
	if(!TurfInfo[turfid][tLocked] || !gTurfLockAccess[playerid][turfid] || gTurfLockout[playerid][turfid]) return 0;
	if(gTurfExitGrace[playerid][turfid]) return 0;

	new vehicleid = IsPlayerInAnyVehicle(playerid) ? GetPlayerVehicleID(playerid) : INVALID_VEHICLE_ID;
	new expiry = gettime() + TURF_EXIT_GRACE_SECONDS;
	foreach(new occupantid : Player)
	{
		if(occupantid != playerid && (!IsValidVehicle(vehicleid) || !IsPlayerInAnyVehicle(occupantid) || GetPlayerVehicleID(occupantid) != vehicleid)) continue;
		if(!gTurfLockAccess[occupantid][turfid] || gTurfLockout[occupantid][turfid] || gTurfExitGrace[occupantid][turfid]) continue;

		gTurfExitGrace[occupantid][turfid] = true;
		gTurfExitGraceExpiry[occupantid][turfid] = expiry;
		gTurfExitGraceVehicle[occupantid][turfid] = vehicleid;
		SendClientMessage(occupantid, COLOR_LIGHTRED, "[Turf Lock] You exited the turf. Return within 15 seconds or you will be locked out.");
		CreateNotification(occupantid, "You left the turf. Return within 15 seconds.", 5000);
		SendTurfAdminMessage(turfid, COLOR_LIGHTRED, "[Turf Lock] %s left the sealed turf and has 15 seconds to return.", GetRPName(occupantid));
	}
	return 1;
}

stock ConfirmTurfBoundaryReturn(playerid, turfid, bool:notify = true)
{
	ResetTurfExitGrace(playerid, turfid);
	gTurfLockAccess[playerid][turfid] = true;
	gTurfLockout[playerid][turfid] = false;
	if(notify)
	{
		SendClientMessage(playerid, COLOR_GREEN, "[Turf Lock] You returned inside the turf in time.");
		CreateNotification(playerid, "Turf access restored. You returned in time.", 3000);
	}
	return 1;
}

stock ExpireTurfBoundaryAccess(playerid, turfid)
{
	new vehicleid = gTurfExitGraceVehicle[playerid][turfid];
	new bool:expireVehicle = bool:(IsValidVehicle(vehicleid) && IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) == vehicleid);

	foreach(new occupantid : Player)
	{
		if(occupantid != playerid && (!expireVehicle || !IsPlayerInAnyVehicle(occupantid) || GetPlayerVehicleID(occupantid) != vehicleid)) continue;
		if(!gTurfExitGrace[occupantid][turfid] || gettime() < gTurfExitGraceExpiry[occupantid][turfid]) continue;

		gTurfLockAccess[occupantid][turfid] = false;
		gTurfLockout[occupantid][turfid] = true;
		ResetTurfExitGrace(occupantid, turfid);
		if(CanSendTurfSecurityNotice(occupantid, turfid))
		{
			SendClientMessage(occupantid, COLOR_LIGHTRED, "[Turf Lock] Return time expired. You are now locked out of this turf.");
			CreateNotification(occupantid, "Turf return time expired. Access is now locked.", 3500);
		}
	}
	return 1;
}

stock EnforceTurfBoundaryLock(playerid, turfid, bool:entering, bool:securityPass = false)
{
	if(!IsPlayerConnected(playerid) || !PlayerInfo[playerid][pLogged]) return 0;
	if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return 0;
	if(!TurfInfo[turfid][tLocked] || PlayerInfo[playerid][pAdminDuty]) return 0;
	if(gTurfPersonalUnlock[playerid][turfid])
	{
		ResetTurfExitGrace(playerid, turfid);
		gTurfLockAccess[playerid][turfid] = true;
		gTurfLockout[playerid][turfid] = false;
		return 0;
	}
	if(!securityPass && IsTurfBoundaryLockCoolingDown(playerid)) return 1;

	if(entering)
	{
		if(gTurfExitGrace[playerid][turfid])
		{
			if(gettime() <= gTurfExitGraceExpiry[playerid][turfid])
			{
				ConfirmTurfBoundaryReturn(playerid, turfid);
				return 0;
			}
			ExpireTurfBoundaryAccess(playerid, turfid);
		}

		if(gTurfLockAccess[playerid][turfid] && !gTurfLockout[playerid][turfid]) return 0;

		MovePlayerToLockedTurfSide(playerid, turfid, true);
		if(CanSendTurfSecurityNotice(playerid, turfid))
		{
			SendTurfAdminMessage(turfid, COLOR_LIGHTRED, "[Turf Lock] %s attempted to enter the sealed boundary and was moved outside.", GetRPName(playerid));
			SendClientMessage(playerid, COLOR_LIGHTRED, "[Turf Lock] Entry denied. This turf boundary is currently sealed.");
			CreateNotification(playerid, "Turf locked: You cannot enter this sealed boundary.", 3500);
		}
	}
	else
	{
		BeginTurfExitGrace(playerid, turfid);
	}
	return entering;
}

stock RestoreAdvancedTurfRelogAccess(playerid)
{
	if(!PlayerInfo[playerid][pLogged] || PlayerInfo[playerid][pID] <= 0) return 0;

	new slot = -1, newestExpiry;
	for(new i = 0; i < sizeof(LeaveData); i++)
	{
		if(!LeaveData[i][leaveExists] || LeaveData[i][leaveAccountID] != PlayerInfo[playerid][pID]) continue;
		if(LeaveData[i][leaveTurfRelogExpire] > newestExpiry)
		{
			newestExpiry = LeaveData[i][leaveTurfRelogExpire];
			slot = i;
		}
	}

	if(slot == -1 || newestExpiry <= gettime()) return 0;

	new turfid = LeaveData[slot][leaveTurfID];
	if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists] || !TurfInfo[turfid][tLocked]) return 0;
	if(LeaveData[slot][leaveTurfGeneration] != gTurfLockGeneration[turfid]) return 0;

	gTurfLockAccess[playerid][turfid] = true;
	gTurfLockout[playerid][turfid] = false;
	gTurfExitGrace[playerid][turfid] = true;
	gTurfExitGraceExpiry[playerid][turfid] = newestExpiry;
	gTurfExitGraceVehicle[playerid][turfid] = INVALID_VEHICLE_ID;

	new remaining = newestExpiry - gettime(), message[128];
	format(message, sizeof(message), "Turf reconnect detected. Re-enter within %i seconds.", remaining);
	SendClientMessage(playerid, COLOR_GREEN, "[Turf Lock] Your disconnect was restored. Re-enter turf ID %i within %i seconds.", turfid, remaining);
	CreateNotification(playerid, message, 5000);
	DestroyLeave(slot);
	return 1;
}

forward ValidateTurfRelogPosition(playerid, generation);
public ValidateTurfRelogPosition(playerid, generation)
{
	if(!IsPlayerConnected(playerid) || !PlayerInfo[playerid][pLogged] || generation != PlayerTextDrawInitGeneration[playerid]) return 1;

	for(new turfid = 0; turfid < MAX_TURFS; turfid++)
	{
		if(!TurfInfo[turfid][tExists] || !TurfInfo[turfid][tLocked]) continue;
		if(!IsPlayerInsideTurfBoundary(playerid, turfid)) continue;

		// Run the normal entry path after login/spawn. This confirms a valid
		// reconnect allowance or ejects an expired/unauthorized reconnect.
		EnforceTurfBoundaryLock(playerid, turfid, true);
		break;
	}
	return 1;
}

stock ClearAdvancedTurfLockState(turfid)
{
	foreach(new playerid : Player)
	{
		gTurfLockAccess[playerid][turfid] = false;
		gTurfLockout[playerid][turfid] = false;
		gTurfPersonalUnlock[playerid][turfid] = false;
		ResetTurfExitGrace(playerid, turfid);
		gTurfSecurityNotifyExpiry[playerid][turfid] = 0;
		DeletePVar(playerid, "TurfLockCooldown");
	}
	return 1;
}

stock InitializeAdvancedTurfLockState(turfid)
{
	ClearAdvancedTurfLockState(turfid);
	gTurfLockGeneration[turfid]++;
	if(gTurfLockGeneration[turfid] <= 0) gTurfLockGeneration[turfid] = 1;
	foreach(new playerid : Player)
	{
		if(!PlayerInfo[playerid][pLogged] || PlayerInfo[playerid][pAdminDuty]) continue;
		if(IsPlayerInsideTurfBoundary(playerid, turfid))
		{
			gTurfLockAccess[playerid][turfid] = true;
		}
		else
		{
			gTurfLockout[playerid][turfid] = true;
		}
	}
	return 1;
}

stock ShowAdvancedTurfNotification(turfid, const text[], time = 1500)
{
	foreach(new playerid : Player)
	{
		if(!PlayerInfo[playerid][pLogged] || !(0 <= PlayerInfo[playerid][pGang] < MAX_GANGS)) continue;
		if(TurfInfo[turfid][tConfigMode] == 1 && !IsAllowedAdvancedTurfGang(playerid, turfid)) continue;
		CreateNotification(playerid, text, time);
	}
	return 1;
}

stock EjectInvalidAdvancedTurfPlayer(playerid, turfid)
{
	new gangName[32], Float:x, Float:y, Float:z;
	format(gangName, sizeof(gangName), "%s", GetAdvancedTurfGangName(PlayerInfo[playerid][pGang]));

	if(IsPlayerInAnyVehicle(playerid))
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		RemovePlayerFromVehicle(playerid);
		if(IsValidVehicle(vehicleid))
		{
			SetVehicleToRespawn(vehicleid);
		}
	}

	GetPlayerPos(playerid, x, y, z);
	SetPlayerPos(playerid, TurfInfo[turfid][tMinX] - 5.0, TurfInfo[turfid][tMinY] - 5.0, z);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SendClientMessage(playerid, COLOR_SYNTAX, "Access denied. This influence turf is restricted to the assigned attacker and defender gangs.");
	SendTurfAdminMessage(turfid, COLOR_LIGHTRED, "[Turf Boundary] %s from %s was removed from %s. Only assigned attacker and defender gangs may enter.",
		GetRPName(playerid), gangName, TurfInfo[turfid][tName]);
	new dstr[768], dateStr[16], timeStr[24];
	GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
	format(dstr, sizeof(dstr), "```ini\n[TURF SECURITY - ACCESS DENIED]\nPlayer              : %s (ID: %i)\nPlayer Gang         : %s\nTurf                : %s (ID: %i)\nTurf Mode           : %s\nAuthorized Attacker : %s\nAuthorized Defender : %s\nEnforcement Action  : Removed from restricted turf\nEvent Time          : %s\nEvent Date          : %s\n```", GetRPName(playerid), playerid, gangName, TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]), GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), timeStr, dateStr);
	SendDiscordMessage(37, dstr);
	return 1;
}

stock IsAdvancedTurfConfigured(turfid)
{
	if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists]) return 0;
	if(TurfInfo[turfid][tDuration] <= 0) return 0;
	if(TurfInfo[turfid][tConfigMode] == 2) return 1;
	if(TurfInfo[turfid][tConfigMode] == 1)
	{
		if(!IsValidAdvancedTurfGang(TurfInfo[turfid][tDefenderGang])) return 0;
		if(!IsValidAdvancedTurfGang(TurfInfo[turfid][tAttackerGang])) return 0;
		if(TurfInfo[turfid][tDefenderGang] == TurfInfo[turfid][tAttackerGang]) return 0;
		return 1;
	}
	return 0;
}

stock ResetAdvancedTurfConfiguration(turfid)
{
	TurfInfo[turfid][tConfigMode] = 0;
	TurfInfo[turfid][tConfigStatus] = 0;
	TurfInfo[turfid][tDefenderGang] = -1;
	TurfInfo[turfid][tAttackerGang] = -1;
	TurfInfo[turfid][tDuration] = 0;
	TurfInfo[turfid][tActive] = 0;
	TurfInfo[turfid][tPaused] = 0;
	TurfInfo[turfid][tWarTime] = 0;
	TurfInfo[turfid][tAttackers] = 0;
	TurfInfo[turfid][tDefenders] = 0;
	TurfInfo[turfid][tLocked] = 0;
	gTurfStartCountdown[turfid] = 0;
	gTurfStartAdmin[turfid] = INVALID_PLAYER_ID;
	ClearAdvancedTurfLockState(turfid);
	TurfInfo[turfid][tInfluence] = 0;
	TurfInfo[turfid][tInfluenceTime] = 0;
	TurfInfo[turfid][tInfluenceGang] = -1;
	format(TurfInfo[turfid][tConfiguredBy], MAX_PLAYER_NAME, "None");
	format(TurfInfo[turfid][tConfigDate], 16, "N/A");
	format(TurfInfo[turfid][tConfigTime], 16, "N/A");
	return 1;
}

stock FinalizeAdvTurfConfig(playerid, turfid)
{
	if(!IsAdvancedTurfConfigured(turfid))
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "This turf configuration is incomplete.");
	}

	TurfInfo[turfid][tConfigStatus] = 1;
	TurfInfo[turfid][tLocked] = (TurfInfo[turfid][tConfigMode] == 2);
	if(TurfInfo[turfid][tLocked])
	{
		InitializeAdvancedTurfLockState(turfid);
	}
	else
	{
		ClearAdvancedTurfLockState(turfid);
	}
	format(TurfInfo[turfid][tConfiguredBy], MAX_PLAYER_NAME, "%s", GetRPName(playerid));
	format(TurfInfo[turfid][tConfigDate], 16, "%s", GetAdvancedTurfDate());
	format(TurfInfo[turfid][tConfigTime], 16, "%s", GetAdvancedTurfTime());

	SAM(COLOR_LIGHTRED, "AdmCmd: %s configured turf %s (ID %i) as %s mode for %i minutes.",
		GetRPName(playerid), TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), TurfInfo[turfid][tDuration] / 60);
	new dstr[768], dateStr[16], timeStr[24];
	GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
	format(dstr, sizeof(dstr), "```ini\n[TURF MANAGEMENT - CONFIGURATION SAVED]\nAdministrator       : %s (ID: %i)\nTurf                : %s (ID: %i)\nCurrent Owner       : %s\nOperation Mode      : %s\nAttacking Gang      : %s\nDefending Gang      : %s\nDuration            : %i minutes\nConfiguration Time  : %s\nConfiguration Date  : %s\n```",
		GetRPName(playerid), playerid, TurfInfo[turfid][tName], turfid, GetAdvancedTurfGangName(TurfInfo[turfid][tCapturedGang]), GetAdvancedTurfModeName(turfid), GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]), GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), TurfInfo[turfid][tDuration] / 60, timeStr, dateStr);
	SendDiscordMessage(37, dstr);
	SM(playerid, COLOR_GREEN, "Turf %s (ID %i) is ready. Mode: %s | Duration: %i minutes | Start with /tstart %i.",
		TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), TurfInfo[turfid][tDuration] / 60, turfid);
	return 1;
}

stock ShowAdvTurfConfigList(playerid)
{
	new string[2048], line[96], count;
	strcat(string, "Turf ID\tName\tStatus\n");
	for(new i = 0; i < MAX_TURFS && strlen(string) < 1900; i++)
	{
		if(TurfInfo[i][tExists])
		{
			format(line, sizeof(line), "%i\t%s\t%s\n", i, TurfInfo[i][tName], TurfInfo[i][tConfigStatus] ? "Configured" : "Incomplete");
			strcat(string, line);
			count++;
		}
	}
	if(!count) return SendClientMessage(playerid, COLOR_SYNTAX, "No turfs exist.");
	return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_MAIN, DIALOG_STYLE_TABLIST_HEADERS, "Turf Configuration", string, "Select", "Close");
}

stock GetAdvancedTurfByListIndex(index)
{
	new count;
	for(new i = 0; i < MAX_TURFS; i++)
	{
		if(TurfInfo[i][tExists])
		{
			if(count == index) return i;
			count++;
		}
	}
	return -1;
}

stock ShowAdvancedTurfConfigureMenu(playerid, turfid)
{
	if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists])
	{
		pConfiguringTurf[playerid] = -1;
		return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid turf.");
	}

	new string[768], title[64];
	format(title, sizeof(title), "Turf Configuration - %s (ID %i)", TurfInfo[turfid][tName], turfid);

	if(TurfInfo[turfid][tConfigMode] == 0)
	{
		format(string, sizeof(string), "Choose Turf Mode\t%s\nReset Configuration\tIncomplete", GetAdvancedTurfModeName(turfid));
	}
	else if(TurfInfo[turfid][tConfigMode] == 2)
	{
		format(string, sizeof(string),
			"Change Turf Mode\t%s\nSet Duration\t%s\nFinalize Configuration\t%s\nReset Configuration\tClear all",
			GetAdvancedTurfModeName(turfid),
			(TurfInfo[turfid][tDuration] > 0) ? FormatAdvancedTurfClock(TurfInfo[turfid][tDuration]) : "Not Set",
			TurfInfo[turfid][tConfigStatus] ? "Configured" : "Save");
	}
	else
	{
		format(string, sizeof(string),
			"Change Turf Mode\t%s\nSet Defender Gang\t%s\nSet Attacker Gang\t%s\nSet Duration\t%s\nFinalize Configuration\t%s\nReset Configuration\tClear all",
			GetAdvancedTurfModeName(turfid),
			GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]),
			GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]),
			(TurfInfo[turfid][tDuration] > 0) ? FormatAdvancedTurfClock(TurfInfo[turfid][tDuration]) : "Not Set",
			TurfInfo[turfid][tConfigStatus] ? "Configured" : "Save");
	}
	return ShowPlayerDialog(playerid, DIALOG_TCONFIGURE_MODE, DIALOG_STYLE_TABLIST, title, string, "Select", "Back");
}

stock StartAdvancedTurf(playerid, turfid)
{
	if(TurfInfo[turfid][tActive]) return SendClientMessage(playerid, COLOR_SYNTAX, "This turf is already started.");
	if(!TurfInfo[turfid][tConfigStatus] || !IsAdvancedTurfConfigured(turfid))
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "This turf has not passed /tconfigure yet.");
	}

	TurfInfo[turfid][tActive] = 1;
	TurfInfo[turfid][tPaused] = 0;
	TurfInfo[turfid][tWarTime] = TurfInfo[turfid][tDuration];
	TurfInfo[turfid][tInfluenceTime] = TurfInfo[turfid][tDuration];
	TurfInfo[turfid][tInfluence] = (TurfInfo[turfid][tConfigMode] == 1) ? 100 : 50;
	TurfInfo[turfid][tInfluenceGang] = (TurfInfo[turfid][tConfigMode] == 1) ? TurfInfo[turfid][tDefenderGang] : -1;
	TurfInfo[turfid][tAttackers] = 0;
	TurfInfo[turfid][tDefenders] = 0;
	TurfInfo[turfid][tLocked] = 0;
	gTurfStartCountdown[turfid] = 0;
	gTurfStartAdmin[turfid] = INVALID_PLAYER_ID;
	ClearAdvancedTurfLockState(turfid);

	foreach(new i : Player)
	{
		if(gTurfDeathReentryTurf[i] == turfid)
		{
			gTurfDeathReentryTurf[i] = -1;
			gTurfDeathReentryGang[i] = -1;
			gTurfDeathReentryCount[i] = 0;
			gTurfDeathReentryArmed[i] = false;
		}
	}

	SMA(COLOR_YELLOW, "[Turf Management] Territorial conflict has begun in %s. Mode: %s | Duration: %d minutes.", TurfInfo[turfid][tName], GetAdvancedTurfModeName(turfid), TurfInfo[turfid][tDuration] / 60);
	SAM(COLOR_LIGHTRED, "[Turf Management] %s has initiated Turf Operation #%d (%s).", GetRPName(playerid), turfid, TurfInfo[turfid][tName]);
	new dstr[768], dateStr[16], timeStr[24];
	GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
	format(dstr, sizeof(dstr), "```ini\n[TURF MANAGEMENT - OPERATION STARTED]\nTurf                : %s (ID: %i)\nOperation Mode      : %s\nDuration            : %d minutes\nAttacking Gang      : %s\nDefending Gang      : %s\nStarting Influence  : %i%%\nInitiated By        : %s (ID: %i)\nStart Time          : %s\nStart Date          : %s\n```", TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), TurfInfo[turfid][tDuration] / 60, GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]), GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), TurfInfo[turfid][tInfluence], GetRPName(playerid), playerid, timeStr, dateStr);
	SendDiscordMessage(37, dstr);

	foreach(new i : Player)
	{
		if(GetNearbyTurf(i) == turfid)
		{
			HandleTurfEntry(i, turfid, TurfInfo[turfid][tArea]);
		}
		GangZoneFlashForPlayer(i, TurfInfo[turfid][tGangZone], (0xFFf74d4dFF & ~0xff) + 0xAA);
	}
	return 1;
}

stock QueueAdvancedTurfStart(playerid, turfid)
{
	if(TurfInfo[turfid][tActive]) return SendClientMessage(playerid, COLOR_SYNTAX, "This turf is already started.");
	if(gTurfStartCountdown[turfid] > 0) return SendClientMessage(playerid, COLOR_SYNTAX, "This turf already has a start countdown.");
	if(!TurfInfo[turfid][tConfigStatus] || !IsAdvancedTurfConfigured(turfid))
	{
		return SendClientMessage(playerid, COLOR_SYNTAX, "This turf has not passed /tconfigure yet.");
	}

	gTurfStartCountdown[turfid] = TURF_START_COUNTDOWN;
	gTurfStartAdmin[turfid] = playerid;
	if(TurfInfo[turfid][tConfigMode] == 2)
	{
		TurfInfo[turfid][tLocked] = 1;
		InitializeAdvancedTurfLockState(turfid);
	}

	new text[96];
	format(text, sizeof(text), "%s will start in 10 seconds.", TurfInfo[turfid][tName]);
	ShowAdvancedTurfNotification(turfid, text, 1500);
	SMA(COLOR_YELLOW, "[Turf Management] %s will start in 10 seconds.", TurfInfo[turfid][tName]);
	return 1;
}

stock StopAdvancedTurf(playerid, turfid, bool:adminStop = true)
{
	if(gTurfStartCountdown[turfid] > 0)
	{
		gTurfStartCountdown[turfid] = 0;
		gTurfStartAdmin[turfid] = INVALID_PLAYER_ID;
		TurfInfo[turfid][tLocked] = (TurfInfo[turfid][tConfigStatus] && TurfInfo[turfid][tConfigMode] == 2);
		if(TurfInfo[turfid][tLocked]) InitializeAdvancedTurfLockState(turfid);
		else ClearAdvancedTurfLockState(turfid);
		SMA(COLOR_YELLOW, "[Turf Management] The start countdown for %s was cancelled.", TurfInfo[turfid][tName]);
		return 1;
	}
	if(!TurfInfo[turfid][tActive]) return SendClientMessage(playerid, COLOR_SYNTAX, "This turf is not started.");

	TurfInfo[turfid][tActive] = 0;
	TurfInfo[turfid][tPaused] = 0;
	TurfInfo[turfid][tWarTime] = 0;
	TurfInfo[turfid][tInfluenceTime] = 0;
	TurfInfo[turfid][tAttackers] = 0;
	TurfInfo[turfid][tDefenders] = 0;
	TurfInfo[turfid][tLocked] = (TurfInfo[turfid][tConfigStatus] && TurfInfo[turfid][tConfigMode] == 2);
	gTurfStartCountdown[turfid] = 0;
	gTurfStartAdmin[turfid] = INVALID_PLAYER_ID;
	if(TurfInfo[turfid][tLocked]) InitializeAdvancedTurfLockState(turfid);
	else ClearAdvancedTurfLockState(turfid);

	foreach(new i : Player)
	{
		if(gTurfDeathReentryTurf[i] == turfid)
		{
			gTurfDeathReentryTurf[i] = -1;
			gTurfDeathReentryGang[i] = -1;
			gTurfDeathReentryCount[i] = 0;
			gTurfDeathReentryArmed[i] = false;
		}
		if(GetNearbyTurf(i) == turfid || gTurfPovLastTurf[i] == turfid) HideAdvancedTurfPov(i);
		GangZoneStopFlashForPlayer(i, TurfInfo[turfid][tGangZone]);
	}

	if(adminStop)
	{
		SMA(COLOR_YELLOW, "[Turf Management] %s has been stopped by an administrator.", TurfInfo[turfid][tName]);
		SAM(COLOR_LIGHTRED, "[Turf Management] %s stopped turf ID %i.", GetRPName(playerid), turfid);
		new dstr[768], dateStr[16], timeStr[24];
		GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
		format(dstr, sizeof(dstr), "```ini\n[TURF MANAGEMENT - OPERATION STOPPED]\nTurf                : %s (ID: %i)\nOperation Mode      : %s\nStopped By          : %s (ID: %i)\nReason              : Administrative action\nFinal Influence     : %i%%\nStop Time           : %s\nStop Date           : %s\n```", TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), GetRPName(playerid), playerid, TurfInfo[turfid][tInfluence], timeStr, dateStr);
		SendDiscordMessage(37, dstr);
	}
	return 1;
}

stock FinishAdvancedTurf(turfid)
{
	new oldOwner = TurfInfo[turfid][tCapturedGang];
	if(TurfInfo[turfid][tConfigMode] == 1)
	{
		if(TurfInfo[turfid][tInfluence] < 50)
		{
			TurfInfo[turfid][tCapturedGang] = TurfInfo[turfid][tAttackerGang];
			TurfInfo[turfid][tInfluenceGang] = TurfInfo[turfid][tAttackerGang];
			format(TurfInfo[turfid][tCapturedBy], MAX_PLAYER_NAME, "%s", GangInfo[TurfInfo[turfid][tAttackerGang]][gName]);
			SMA(COLOR_GREEN, "[Turf Management] %s captured %s from %s. Final defender influence: %i.",
				GangInfo[TurfInfo[turfid][tAttackerGang]][gName], TurfInfo[turfid][tName], GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), TurfInfo[turfid][tInfluence]);
			new dstr[768], dateStr[16], timeStr[24];
			GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
			format(dstr, sizeof(dstr), "```ini\n[TURF RESULT - CAPTURE SUCCESSFUL]\nTurf                : %s (ID: %i)\nOperation Mode      : %s\nCaptured By         : %s\nPrevious Defender   : %s\nPrevious Owner      : %s\nFinal Influence     : %i%%\nResult Time         : %s\nResult Date         : %s\n```", TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), GangInfo[TurfInfo[turfid][tAttackerGang]][gName], GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), GetAdvancedTurfGangName(oldOwner), TurfInfo[turfid][tInfluence], timeStr, dateStr);
			SendDiscordMessage(37, dstr);
		}
		else if(TurfInfo[turfid][tInfluence] > 50)
		{
			TurfInfo[turfid][tCapturedGang] = TurfInfo[turfid][tDefenderGang];
			TurfInfo[turfid][tInfluenceGang] = TurfInfo[turfid][tDefenderGang];
			format(TurfInfo[turfid][tCapturedBy], MAX_PLAYER_NAME, "%s", GangInfo[TurfInfo[turfid][tDefenderGang]][gName]);
			SMA(COLOR_GREEN, "[Turf Management] %s successfully defended %s. Final influence: %i.",
				GangInfo[TurfInfo[turfid][tDefenderGang]][gName], TurfInfo[turfid][tName], TurfInfo[turfid][tInfluence]);
			new dstr[768], dateStr[16], timeStr[24];
			GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
			format(dstr, sizeof(dstr), "```ini\n[TURF RESULT - DEFENCE SUCCESSFUL]\nTurf                : %s (ID: %i)\nOperation Mode      : %s\nDefended By         : %s\nAttacking Gang      : %s\nFinal Influence     : %i%%\nOwnership Status    : Retained by defender\nResult Time         : %s\nResult Date         : %s\n```", TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), GangInfo[TurfInfo[turfid][tDefenderGang]][gName], GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]), TurfInfo[turfid][tInfluence], timeStr, dateStr);
			SendDiscordMessage(37, dstr);
		}
		else
		{
			TurfInfo[turfid][tCapturedGang] = oldOwner;
			SMA(COLOR_GREEN, "[Turf Management] %s ended in a draw. Ownership remains unchanged.", TurfInfo[turfid][tName]);
			new dstr[768], dateStr[16], timeStr[24];
			GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
			format(dstr, sizeof(dstr), "```ini\n[TURF RESULT - DRAW]\nTurf                : %s (ID: %i)\nOperation Mode      : %s\nAttacking Gang      : %s\nDefending Gang      : %s\nFinal Influence     : %i%%\nOwnership Status    : Unchanged\nResult Time         : %s\nResult Date         : %s\n```", TurfInfo[turfid][tName], turfid, GetAdvancedTurfModeName(turfid), GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]), GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]), TurfInfo[turfid][tInfluence], timeStr, dateStr);
			SendDiscordMessage(37, dstr);
		}
		mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE turfs SET capturedgang = %i, capturedby = '%e' WHERE id = %i", TurfInfo[turfid][tCapturedGang], TurfInfo[turfid][tCapturedBy], turfid);
		mysql_tquery(connectionID, queryBuffer);
		DrugFarmSyncTurf(turfid);
	}
	else
	{
		SMA(COLOR_GREEN, "[Turf Management] Open turf event at %s has concluded. GGWP to all participants.", TurfInfo[turfid][tName]);
		new dstr[768], dateStr[16], timeStr[24];
		GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));
		format(dstr, sizeof(dstr), "```ini\n[TURF RESULT - OPEN EVENT CONCLUDED]\nTurf                : %s (ID: %i)\nOperation Mode      : Open\nFinal Influence     : %i%%\nTotal Attackers     : %i\nTotal Defenders     : %i\nEvent Status        : Completed\nResult Time         : %s\nResult Date         : %s\n```", TurfInfo[turfid][tName], turfid, TurfInfo[turfid][tInfluence], TurfInfo[turfid][tAttackers], TurfInfo[turfid][tDefenders], timeStr, dateStr);
		SendDiscordMessage(37, dstr);
	}

	StopAdvancedTurf(INVALID_PLAYER_ID, turfid, false);
	ReloadTurf(turfid);
	return 1;
}

stock ProcessAdvancedTurfTick()
{
	foreach(new playerid : Player)
	{
		if(!PlayerInfo[playerid][pLogged] || PlayerInfo[playerid][pAdminDuty] || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) continue;

		for(new turfid = 0; turfid < MAX_TURFS; turfid++)
		{
			if(!TurfInfo[turfid][tExists] || !TurfInfo[turfid][tLocked]) continue;
			if(gTurfPersonalUnlock[playerid][turfid]) continue;

			new bool:inside = bool:IsPlayerInsideTurfBoundary(playerid, turfid);
			if(inside)
			{
				if(gTurfExitGrace[playerid][turfid])
				{
					if(gettime() <= gTurfExitGraceExpiry[playerid][turfid])
					{
						// Streamer missed the enter callback, but the coordinate check
						// confirms that the player returned through the virtual wall.
						ConfirmTurfBoundaryReturn(playerid, turfid);
					}
					else
					{
						ExpireTurfBoundaryAccess(playerid, turfid);
					}
				}

				if(!gTurfLockAccess[playerid][turfid] || gTurfLockout[playerid][turfid])
				{
					// Server-side virtual wall fallback for teleports, high-speed
					// vehicles, and any missed dynamic-area callback.
					EnforceTurfBoundaryLock(playerid, turfid, true, true);
				}
			}
			else if(gTurfLockAccess[playerid][turfid] && !gTurfLockout[playerid][turfid])
			{
				if(!gTurfExitGrace[playerid][turfid])
				{
					// The leave callback was missed; start the same protected return
					// window that a normal boundary exit receives.
					BeginTurfExitGrace(playerid, turfid);
				}
				else if(gettime() >= gTurfExitGraceExpiry[playerid][turfid])
				{
					ExpireTurfBoundaryAccess(playerid, turfid);
				}
			}
		}
	}

	for(new turfid = 0; turfid < MAX_TURFS; turfid++)
	{
		if(gTurfStartCountdown[turfid] > 0)
		{
			gTurfStartCountdown[turfid]--;
			if(gTurfStartCountdown[turfid] == 0)
			{
				new starter = gTurfStartAdmin[turfid];
				StartAdvancedTurf(starter, turfid);
			}
			else
			{
				new text[96];
				format(text, sizeof(text), "%s will start in %i seconds.", TurfInfo[turfid][tName], gTurfStartCountdown[turfid]);
				ShowAdvancedTurfNotification(turfid, text, 1200);
			}
		}

		if(!TurfInfo[turfid][tExists] || !TurfInfo[turfid][tActive] || TurfInfo[turfid][tPaused]) continue;

		new attackers, defenders;
		foreach(new playerid : Player)
		{
			if(!IsValidAdvancedTurfMember(playerid) || GetNearbyTurf(playerid) != turfid) continue;
			new gangid = PlayerInfo[playerid][pGang];

			if(TurfInfo[turfid][tConfigMode] == 1)
			{
				if(gangid == TurfInfo[turfid][tAttackerGang]) attackers++;
				else if(gangid == TurfInfo[turfid][tDefenderGang]) defenders++;
			}
			else if(GangInfo[gangid][gSetup])
			{
				attackers++;
			}
		}

		TurfInfo[turfid][tAttackers] = attackers;
		TurfInfo[turfid][tDefenders] = defenders;

		if(TurfInfo[turfid][tConfigMode] == 1)
		{
			new pressure = attackers - defenders;
			if(pressure > 0)
			{
				TurfInfo[turfid][tInfluence] -= pressure;
				if(TurfInfo[turfid][tInfluence] < 0) TurfInfo[turfid][tInfluence] = 0;
			}
			else if(pressure < 0)
			{
				TurfInfo[turfid][tInfluence] += -pressure;
				if(TurfInfo[turfid][tInfluence] > 100) TurfInfo[turfid][tInfluence] = 100;
			}
		}

		TurfInfo[turfid][tWarTime]--;
		TurfInfo[turfid][tInfluenceTime] = TurfInfo[turfid][tWarTime];
		if(TurfInfo[turfid][tWarTime] <= 0)
		{
			FinishAdvancedTurf(turfid);
		}
	}
	return 1;
}

stock UpdateAdvancedTurfPovForPlayer(playerid)
{
	new turfid = GetNearbyTurf(playerid);
	if(turfid < 0)
	{
		if(gTurfPovHideTimer[playerid] != 0)
		{
			turfid = gTurfPovLastTurf[playerid];
			if(!(0 <= turfid < MAX_TURFS) || !TurfInfo[turfid][tExists] || !TurfInfo[turfid][tActive])
			{
				return HideAdvancedTurfPov(playerid);
			}
		}
		else
		{
			return HideAdvancedTurfPov(playerid);
		}
	}
	if(!TurfInfo[turfid][tExists] || !TurfInfo[turfid][tConfigStatus] || TurfInfo[turfid][tPaused])
	{
		return HideAdvancedTurfPov(playerid);
	}
	if(GetNearbyTurf(playerid) == turfid)
	{
		CancelAdvancedTurfPovHide(playerid);
	}
	gTurfPovLastTurf[playerid] = turfid;

	new clock[12], date[16], string[64];
	format(clock, sizeof(clock), "%s", TurfInfo[turfid][tActive] ? FormatAdvancedTurfClock(TurfInfo[turfid][tWarTime]) : FormatAdvancedTurfClock(TurfInfo[turfid][tDuration]));
	format(date, sizeof(date), "%s", TurfInfo[turfid][tConfigDate]);

	PlayerTextDrawSetString(playerid, TURFPLAYERPOV[playerid][1], clock);
	PlayerTextDrawSetString(playerid, TURFPLAYERPOV[playerid][3], TurfInfo[turfid][tName]);
	PlayerTextDrawSetString(playerid, TURFPLAYERPOV[playerid][5], date);
	for(new i = 0; i < 6; i++) PlayerTextDrawShow(playerid, TURFPLAYERPOV[playerid][i]);
	gTurfPlayerPovShown[playerid] = true;

	if(PlayerInfo[playerid][pAdmin] > 0)
	{
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][0], TurfInfo[turfid][tName]);
		if(TurfInfo[turfid][tConfigMode] == 2)
		{
			PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][6], "N/A");
		}
		else
		{
			format(string, sizeof(string), "%i", TurfInfo[turfid][tInfluence]);
			PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][6], string);
		}
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][8], date);
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][11], clock);
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][18], (TurfInfo[turfid][tConfigMode] == 2) ? "Open Event" : GetAdvancedTurfGangName(TurfInfo[turfid][tAttackerGang]));
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][20], (TurfInfo[turfid][tConfigMode] == 2) ? "None" : GetAdvancedTurfGangName(TurfInfo[turfid][tDefenderGang]));
		format(string, sizeof(string), "%i", TurfInfo[turfid][tAttackers]);
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][25], string);
		format(string, sizeof(string), "%i", TurfInfo[turfid][tDefenders]);
		PlayerTextDrawSetString(playerid, TURFADMINPOV[playerid][26], string);

		new Float:attackerBar = 219.0, Float:defenderBar = 418.0;
		if(TurfInfo[turfid][tConfigMode] == 1)
		{
			attackerBar = 219.0 + (float(100 - TurfInfo[turfid][tInfluence]) * 97.0 / 100.0);
			defenderBar = 418.0 - (float(TurfInfo[turfid][tInfluence]) * 97.0 / 100.0);
		}
		PlayerTextDrawTextSize(playerid, TURFADMINPOV[playerid][3], attackerBar, 0.000);
		PlayerTextDrawTextSize(playerid, TURFADMINPOV[playerid][4], defenderBar, 0.000);

		for(new i = 0; i < 29; i++) PlayerTextDrawShow(playerid, TURFADMINPOV[playerid][i]);
		gTurfAdminPovShown[playerid] = true;
	}
	else if(gTurfAdminPovShown[playerid])
	{
		for(new i = 0; i < 29; i++) PlayerTextDrawHide(playerid, TURFADMINPOV[playerid][i]);
		gTurfAdminPovShown[playerid] = false;
	}
	format(string, sizeof(string), "TIME: %s", clock);
	return 1;
}

stock HideAdvancedTurfPov(playerid)
{
	if(gTurfPovHideTimer[playerid] != 0)
	{
		KillTimer(gTurfPovHideTimer[playerid]);
		gTurfPovHideTimer[playerid] = 0;
	}
	if(gTurfPlayerPovShown[playerid])
	{
		for(new i = 0; i < 6; i++) PlayerTextDrawHide(playerid, TURFPLAYERPOV[playerid][i]);
		gTurfPlayerPovShown[playerid] = false;
	}
	if(gTurfAdminPovShown[playerid])
	{
		for(new i = 0; i < 29; i++) PlayerTextDrawHide(playerid, TURFADMINPOV[playerid][i]);
		gTurfAdminPovShown[playerid] = false;
	}
	gTurfPovLastTurf[playerid] = -1;
	return 1;
}

stock ScheduleAdvancedTurfPovHide(playerid)
{
	if(gTurfPovHideTimer[playerid] != 0)
	{
		KillTimer(gTurfPovHideTimer[playerid]);
	}
	gTurfPovHideTimer[playerid] = SetTimerEx("DelayedAdvancedTurfPovHide", 60000, false, "i", playerid);
	return 1;
}

stock CancelAdvancedTurfPovHide(playerid)
{
	if(gTurfPovHideTimer[playerid] != 0)
	{
		KillTimer(gTurfPovHideTimer[playerid]);
		gTurfPovHideTimer[playerid] = 0;
	}
	return 1;
}

forward DelayedAdvancedTurfPovHide(playerid);
public DelayedAdvancedTurfPovHide(playerid)
{
	gTurfPovHideTimer[playerid] = 0;
	if(GetNearbyTurf(playerid) == -1)
	{
		HideAdvancedTurfPov(playerid);
	}
	return 1;
}


forward GagoKaba(playerid);
public GagoKaba(playerid)
{
	for(new i = 0; i < 4; i ++)
	{
		TextDrawHideForPlayer(playerid, UnknownTD[i]);
	}
    return 1;
}

forward DEATHACTOR(playerid);
public DEATHACTOR(playerid)
{
	if(IsValidActor(PlayerInfo[playerid][pDeathActor]))
		DestroyActor(PlayerInfo[playerid][pDeathActor]);
	if(IsValidDynamic3DTextLabel(PlayerInfo[playerid][pDeathInfo]))
		DestroyDynamic3DTextLabel(PlayerInfo[playerid][pDeathInfo]);
    return 1;
}
forward TeleportPlayerFromPoint(playerid);
public TeleportPlayerFromPoint(playerid)
{

	for(new i = 0; i < 39; i++)
	{
		PlayerTextDrawHide(playerid, DEATHTD[playerid][i]);
	}
    CancelSelectTextDraw(playerid);
    
    PlayerInfo[playerid][pInjured] = 0;
    PlayerInfo[playerid][pHunger] = 100;
    PlayerInfo[playerid][pHungerTimer] = 0;
    PlayerInfo[playerid][pThirst] = 100;
    PlayerInfo[playerid][pThirstTimer] = 0;

    TogglePlayerControllable(playerid, true);
    SetPlayerHealth(playerid, 100.0);
    SetPlayerVirtualWorld(playerid, 0);
    ClearAnimations(playerid, SYNC_ALL);
    SetPlayerPos(playerid, 334.949951, -1794.299926, 6.918820);

    SM(playerid, COLOR_AQUA, "You have been send to Garage From Point.");
}

forward TeleportPlayerFromTurf(playerid);
public TeleportPlayerFromTurf(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerInfo[playerid][pLogged] ||
        !GetPVarInt(playerid, "TurfRevivePending"))
    {
        return 0;
    }

    KillTimer(killtimerz[playerid]);
    if(PlayerInfo[playerid][pFreezeTimer] >= 0)
    {
        KillTimer(PlayerInfo[playerid][pFreezeTimer]);
        PlayerInfo[playerid][pFreezeTimer] = -1;
    }

    TogglePlayerControllable(playerid, false);

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerPos(playerid, 1127.864501, -1445.227172, 15.796875);
    SetPlayerFacingAngle(playerid, 90.0);
    SetCameraBehindPlayer(playerid);

    PlayerInfo[playerid][pPosX] = 1127.864501;
    PlayerInfo[playerid][pPosY] = -1445.227172;
    PlayerInfo[playerid][pPosZ] = 15.796875;
    PlayerInfo[playerid][pPosA] = 90.0;
    PlayerInfo[playerid][pInterior] = 0;
    PlayerInfo[playerid][pWorld] = 0;

    SM(playerid, COLOR_AQUA, "You were removed from the active Turf. Reviving in 5 seconds...");
    SetTimerEx("FinalizeTurfTeleport", 5000, false, "i", playerid);
    return 1;
}

forward FinalizeTurfTeleport(playerid);
public FinalizeTurfTeleport(playerid)
{
    if(!IsPlayerConnected(playerid) || !GetPVarInt(playerid, "TurfRevivePending"))
    {
        return 0;
    }

    PlayerInfo[playerid][pInjured] = 0;
    PlayerInfo[playerid][pHospital] = 0;
    PlayerInfo[playerid][pDeathCooldown] = 0;
    PlayerInfo[playerid][pRevCooldown] = 0;
    PlayerInfo[playerid][pAcceptedEMS] = INVALID_PLAYER_ID;
    PlayerInfo[playerid][pHunger] = 100;
    PlayerInfo[playerid][pHungerTimer] = 0;
    PlayerInfo[playerid][pThirst] = 100;
    PlayerInfo[playerid][pThirstTimer] = 0;

    ClearAnimations(playerid, SYNC_ALL);
    for(new i = 0; i < 39; i++)
    {
        PlayerTextDrawHide(playerid, DEATHTD[playerid][i]);
    }
    CancelSelectTextDraw(playerid);

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerPos(playerid, 1127.864501, -1445.227172, 15.796875);
    SetPlayerFacingAngle(playerid, 90.0);
    SetCameraBehindPlayer(playerid);
    SetPlayerHealth(playerid, 100.0);
    return UnfreezePlayerFromTurf(playerid);
}

forward UnfreezePlayerFromTurf(playerid);
public UnfreezePlayerFromTurf(playerid)
{
    if(!IsPlayerConnected(playerid) || !GetPVarInt(playerid, "TurfRevivePending"))
    {
        return 0;
    }

    DeletePVar(playerid, "TurfRevivePending");
    ClearAnimations(playerid, SYNC_ALL);
    SetCameraBehindPlayer(playerid);
    TogglePlayerControllable(playerid, true);
    if(gTurfDeathReentryTurf[playerid] >= 0)
    {
        gTurfDeathReentryArmed[playerid] = true;
    }
    SM(playerid, COLOR_GREEN, "You have been revived. Stay clear of the active Turf.");
    return 1;
}

forward UnfreezeInjuredPlayer(playerid);
public UnfreezeInjuredPlayer(playerid)
{
    if(IsPlayerConnected(playerid) && PlayerInfo[playerid][pInjured])
    {
        TogglePlayerControllable(playerid, true);
    }
    return 1;
}

forward IRevive(playerid);
public IRevive(playerid)
{

	for(new i = 0; i < 39; i++)
	{
		PlayerTextDrawHide(playerid, DEATHTD[playerid][i]);
	}
    CancelSelectTextDraw(playerid);
    
	PlayerInfo[playerid][pInjured] = 0;
	PlayerInfo[playerid][pHunger] = 25;
	PlayerInfo[playerid][pHungerTimer] = 0;
    PlayerInfo[playerid][pThirst] = 25;
	PlayerInfo[playerid][pThirstTimer] = 0;

	PlayerInfo[playerid][pGased] = false;
	PlayerInfo[playerid][pGased1] = false;


    TogglePlayerControllable(playerid, true);
	SetPlayerHealth(playerid, 50.0);
	GivePlayerCash(playerid, -15000);
	ClearAnimations(playerid, SYNC_ALL);

	SendClientMessage(playerid, COLOR_YELLOW, "You have been revived by an Illegal Doctor");
	SendProximityMessage(playerid, 20.0, SERVER_COLOR, "**{C2A2DA} Medic successfully healed %s wound.", GetRPName(playerid));
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET thirst = %i, thirsttimer = %i WHERE uid = %i", PlayerInfo[playerid][pThirst], PlayerInfo[playerid][pThirstTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET hunger = %i, hungertimer = %i WHERE uid = %i", PlayerInfo[playerid][pHunger], PlayerInfo[playerid][pHungerTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);
    return 1;
}

forward OnPlayerEquipVest(playerid);
public OnPlayerEquipVest(playerid)
{
	if(!IsPlayerConnected(playerid) || !PlayerInfo[playerid][pLogged] || !PlayerInfo[playerid][pEquipVest])
	{
		return 1;
	}

	PlayerInfo[playerid][pEquipVest] = false;
	PlayerInfo[playerid][pEquipTimer] = -1;

	// Consume the vest only after the equip completes. This prevents a
	// disconnect during the animation from eating the item without armor.
	if(PlayerInfo[playerid][pVest] <= 0)
	{
		TogglePlayerControllable(playerid, true);
		ClearAnimations(playerid, SYNC_ALL);
		return SendClientMessage(playerid, COLOR_SYNTAX, "The vest could not be equipped because you no longer have one.");
	}

	PlayerInfo[playerid][pVest]--;
	SetScriptArmour(playerid, 100.0);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
		"UPDATE users SET vest = %i, armor = '%f' WHERE uid = %i",
		PlayerInfo[playerid][pVest], PlayerInfo[playerid][pArmor], PlayerInfo[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer);

	TogglePlayerControllable(playerid, true);
	GameTextForPlayer(playerid, "~g~equipped", 2000, 1);
	ClearAnimations(playerid, SYNC_ALL);
	Inventory_Update(playerid);
	return 1;
}
forward OnPlayerEquipHelmet(playerid);
public OnPlayerEquipHelmet(playerid)
{
	if(IsPlayerConnected(playerid))
	{

        // The helmet is currently cosmetic only. A non-zero value marks it as equipped.
        PlayerInfo[playerid][pHelmet] = 1;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET helmet = %i WHERE uid = %i", PlayerInfo[playerid][pHelmet], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        SendClientMessage(playerid, COLOR_GREEN, "Helmet equipped. Bullet protection is currently disabled and will be coming soon.");

		TogglePlayerControllable(playerid, true);
		GameTextForPlayer(playerid, "~g~equipped", 2000, 1);
	}

	ClearAnimations(playerid, SYNC_ALL);

	PlayerInfo[playerid][pEquipHelmet] = false;
	KillTimer(PlayerInfo[playerid][pEquipTimer]);
	PlayerInfo[playerid][pEquipTimer] = -1;

	SendClientMessage(playerid,COLOR_SYNTAX,"/toghelmet To hide helmet");
	return 1;
}


forward HideAnnouncement();
public HideAnnouncement()
{
    foreach(new i : Player)
    {
        for(new x = 0; x < 9; x++)
        {
            TextDrawHideForPlayer(i, ANNOUNCETD[x]);
        }
    }
    AnnouncementActive = false;
    return 1;
}

forward TwtTDHIDE(playerid);
public TwtTDHIDE(playerid)
{
	for(new i = 0; i < 5; i ++)
	{
		TextDrawHideForPlayer(playerid, TwtTD[i]);
	}
    return 1;
}


forward Textdraw2Hide(playerid);
public Textdraw2Hide(playerid)
{
	for(new i = 0; i < 3; i ++)
	{
		TextDrawHideForPlayer(playerid, Textdraw2);
	}
    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
	{
		ShowError(playerid, "Undefined Command, Use /help");
	 	PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
	}
	else
	{
		printf("[cmd] %s: [%s]", GetRPName(playerid), cmd);
	}
	return 1;
}

#define PRESSED(%0) (((newkeys & (%0)) == (%0)) && ((oldkeys & (%0)) != (%0)))
#define RELEASED(%0) (((newkeys & (%0)) != (%0)) && ((oldkeys & (%0)) == (%0)))
public  OnPlayerKeyStateChange(playerid, KEY:newkeys, KEY:oldkeys)
{
	Tactical_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	if(IsPlayerWeaponAccessRestricted(playerid))
	{
	    new WEAPON:weaponid = GetPlayerWeapon(playerid);
	    CheckPlayerWeaponLock(playerid, (weaponid != WEAPON_FIST && (PRESSED(KEY_FIRE) || PlayerLastWeapon[playerid] != weaponid)));
	}

    if(PlayerInfo[playerid][pSkating] && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    // Fire/RMB works on PC; KEY_NO (N) provides a cursor-free mobile option.
	    const KEY:skateKeys = KEY_FIRE | KEY_HANDBRAKE | KEY_NO;
	    SetPlayerArmedWeapon(playerid, 0);

	    if((newkeys & skateKeys) && !(oldkeys & skateKeys))
		{
	        ApplyAnimationEx(playerid, "SKATE","skate_sprint",4.1,1,1,1,1,1);
	        if(!PlayerInfo[playerid][pSkateAct])
			{
                PlayerInfo[playerid][pSkateAct] = true;
                RemovePlayerAttachedObject(playerid, 5);
                if(IsValidDynamicObject(PlayerInfo[playerid][pSkateObj]))
                {
                    DestroyDynamicObject(PlayerInfo[playerid][pSkateObj]);
                }
                PlayerInfo[playerid][pSkateObj] = CreateDynamicObject(19878,0,0,0,0,0,0, .playerid = playerid);
                AttachDynamicObjectToPlayer(PlayerInfo[playerid][pSkateObj], playerid, -0.2,0,-0.9,0,0,90);
	        }
	    }
        else if(!(newkeys & skateKeys) && (oldkeys & skateKeys))
		{
            ApplyAnimationEx(playerid, "CARRY","crry_prtial",4.0,0,0,0,0,0);
            if(PlayerInfo[playerid][pSkateAct])
			{
                PlayerInfo[playerid][pSkateAct] = false;
                if(IsValidDynamicObject(PlayerInfo[playerid][pSkateObj]))
                {
                    DestroyDynamicObject(PlayerInfo[playerid][pSkateObj]);
                }
                PlayerInfo[playerid][pSkateObj] = 0;
                RemovePlayerAttachedObject(playerid, 5);
                SetPlayerAttachedObject(playerid, 5,19878,6,-0.055999,0.013000,0.000000,-84.099983,0.000000,-106.099998,1.000000,1.000000,1.000000);
            }
        }

        // While skating, N belongs to the skate control and must not open nearby interactions.
        if((newkeys | oldkeys) & KEY_NO)
        {
            return 1;
        }
   	}
    if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    new mushroomPlant = GetNearbyDrugFarmPlant(playerid);
	    if(mushroomPlant != -1)
	    {
	        ShowDrugFarmTD(playerid, mushroomPlant);
	        return 1;
	    }
	    if(IsPlayerInRangeOfPoint(playerid, 3.0, 355.7727, -1796.1138, 6.9653) || IsPlayerInRangeOfPoint(playerid, 3.0, 1099.8708, -1347.7694, 13.2078))
	    {
			ShowPublicLocker(playerid);
        }
	}
   	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
        if(IsPlayerInRangeOfPoint(playerid, 3.0, 1178.409057, -1359.016357, 13.722750))
        {
			if(GetFactionType(playerid) != FACTION_MEDIC)
			{
				return SendClientMessage(playerid, COLOR_SYNTAX, "[ERROR]{ffffff} You can't use this command as you aren't a medic.");
			}
			ShowPlayerDialog(playerid, DIALOG_MEDIC, DIALOG_STYLE_LIST, "MEDIC VEHICLES", "Ambulance\nNrg500", "Select", "Close");
		}
	}
	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
        if(IsPlayerInRangeOfPoint(playerid, 1.0, 1940.153442, -1823.597045, 13.586874) || IsPlayerInRangeOfPoint(playerid, 1.0, 1940.144287, -1825.208007, 13.586874))
        {
		   callcmd::vote(playerid);
        }
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
 	{
		callcmd::takejoint(playerid);
	}
	if(PRESSED(KEY_YES) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        new pggid = GetNearbyPGG(playerid);

        if(pggid >= 0)
        {
            if(!(0 <= PlayerInfo[playerid][pGang] < MAX_GANGS) || !GangInfo[PlayerInfo[playerid][pGang]][gSetup])
            {
                return SCMf(playerid, COLOR_SYNTAX, "You must be in a gang to use this public gang garage.");
            }

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world FROM vehicles WHERE gangid = %i", PlayerInfo[playerid][pGang]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_GSTORAGE, playerid);
			return 1;
        }

        new ggid = GetNearbyGG(playerid);

        if(ggid >= 0)
		{
		    if(PlayerInfo[playerid][pGang] != GGInfo[ggid][ggGang])
		    {
		        new gangname[32] = "Unknown";
		        if(0 <= GGInfo[ggid][ggGang] < MAX_GANGS && GangInfo[GGInfo[ggid][ggGang]][gSetup])
		        {
		            format(gangname, sizeof(gangname), "%s", GangInfo[GGInfo[ggid][ggGang]][gName]);
		        }
		        return SCMf(playerid, COLOR_SYNTAX, "This gang garage belongs to %s.", gangname);
		    }

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world FROM vehicles WHERE gangid = %i", GGInfo[ggid][ggGang]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_GSTORAGE, playerid);
			return 1;
		}
	}

	if((newkeys & KEY_YES) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        new fgid = GetNearbyFG(playerid);

        if(fgid != -1)
        {
            switch(FGInfo[fgid][fgFaction])
            {
                case 1:
                {
                    if(GetFactionType(playerid) != FACTION_POLICE)
                    {
                        return SCMf(playerid, -1, "Not police.");
                    }

                    ShowPlayerDialog(playerid, DIALOG_LSPD, DIALOG_STYLE_LIST, "POLICE VEHICLES", "HPV1000\nLSPD\nLVPD\nSFPD\nRanger\nEnforcer\nFBI Ranger\nSultan\nBullet\nMaverick", "Select", "Close");
                }
                case 2:
                {
                    if(GetFactionType(playerid) != FACTION_MEDIC)
                    {
                        return SCMf(playerid, -1, "Not medic.");
                    }

                    ShowPlayerDialog(playerid, DIALOG_MEDIC, DIALOG_STYLE_LIST, "MEDIC VEHICLES", "Ambulance\nBullet\nMaverick", "Select", "Close");
                }
                case 3:
                {
                    if(GetFactionType(playerid) != FACTION_MECHANIC)
                    {
                        return SCMf(playerid, -1, "Not mechanic.");
                    }

                    ShowPlayerDialog(playerid, DIALOG_MECH, DIALOG_STYLE_LIST, "MECHANIC VEHICLES", "Tow Truck", "Select", "Close");
                }
            }
        }
    }

	if(PRESSED(KEY_CROUCH) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(GetNearbyRS(playerid) != -1)
		{
			return RepairAtNearbyStation(playerid);
		}

		// HORN was historically also used to despawn a temporary faction
		// vehicle. Repair stations take priority so the vehicle is not
		// destroyed before the repair can run.
		if(vehicleid == PlayerFactionVeh[playerid])
		{
			return DespawnFactionVehicle(playerid);
		}
	}

	if(PRESSED(KEY_YES) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
        new pggid = GetNearbyPGG(playerid);

        if(pggid >= 0)
        {
            if(!(0 <= PlayerInfo[playerid][pGang] < MAX_GANGS) || !GangInfo[PlayerInfo[playerid][pGang]][gSetup])
            {
                return SCMf(playerid, COLOR_SYNTAX, "You must be in a gang to use this public gang garage.");
            }

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world, impounded FROM vehicles WHERE gangid = %i", PlayerInfo[playerid][pGang]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_GSTORAGE, playerid);
			return 1;
        }

        new ggid = GetNearbyGG(playerid);

        if(ggid >= 0)
		{
		    if(PlayerInfo[playerid][pGang] != GGInfo[ggid][ggGang])
		    {
		        new gangname[32] = "Unknown";
		        if(0 <= GGInfo[ggid][ggGang] < MAX_GANGS && GangInfo[GGInfo[ggid][ggGang]][gSetup])
		        {
		            format(gangname, sizeof(gangname), "%s", GangInfo[GGInfo[ggid][ggGang]][gName]);
		        }
		        return SCMf(playerid, COLOR_SYNTAX, "This gang garage belongs to %s.", gangname);
		    }

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world, impounded FROM vehicles WHERE gangid = %i", GGInfo[ggid][ggGang]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_GSTORAGE, playerid);
			return 1;
		}
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
 	{
		if(GetNearbyBusinessEx(playerid) > 0)
		{
			callcmd::buy(playerid);
		}
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
 	{
		callcmd::deliverjoint(playerid);
	}
	if(newkeys & KEY_CROUCH && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 	{
		callcmd::sr(playerid);
	}
	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(PlayerInfo[playerid][pInjured])
		{
			if(IsPlayerConnected(PlayerInfo[playerid][pAcceptedEMS]) && !PlayerInfo[PlayerInfo[playerid][pAcceptedEMS]][pAFK])
			{
				SCMf(playerid, COLOR_SYNTAX, "There is a medic online and on the way to rescue you.");
			}
			if(PlayerInfo[playerid][pDeathCooldown] > 0)
			{
				SM(playerid, COLOR_SYNTAX, "You need to wait %i more seconds before you can give up.", PlayerInfo[playerid][pDeathCooldown]);
			}

			SCMf(playerid, COLOR_SYNTAX, "You have given up and accepted your fate.");
			DamagePlayer(playerid, 300, playerid, WEAPON_EXPLOSION, BODY_PART_UNKNOWN, false);
		}
	}

	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   callcmd::getflower(playerid);
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   callcmd::dryflower(playerid);
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   callcmd::getcocaine(playerid);
	}
	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(GetNearbyPG(playerid) >= 0)
		{
			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world, impounded, broken FROM vehicles WHERE ownerid = %i", PlayerInfo[playerid][pID]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_STORAGE, playerid);
			return 1;
		}
	}
	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(GetNearbyPG(playerid) >= 0)
		{
			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, modelid, pos_x, pos_y, pos_z, world, impounded, broken FROM vehicles WHERE ownerid = %i", PlayerInfo[playerid][pID]);
			mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CAR_STORAGE, playerid);
			return 1;
		}
	}
   	if(newkeys & KEY_NO)
	{
		for(new i = 0; i < sizeof(jobLocations); i ++)
		{
		    if(IsPlayerInRangeOfPoint(playerid, 3.0, jobLocations[i][jobX], jobLocations[i][jobY], jobLocations[i][jobZ]))
		    {
		        if(PlayerInfo[playerid][pJob] != JOB_NONE)
		        {
		            if(PlayerInfo[playerid][pVIPPackage] >= 1)
		        	{
		        	    if(PlayerInfo[playerid][pSecondJob] != JOB_NONE)
		        	    {
							SendClientMessage(playerid, COLOR_SYNTAX, "You have two jobs already. Please quit one of them before getting another one.");
		        	    }
		        	    if(PlayerInfo[playerid][pJob] == i)
		        	    {
							SendClientMessage(playerid, COLOR_SYNTAX, "You have this job already.");
		        	    }
						if(PlayerInfo[playerid][pIDCard1] == 0)
						{
							SCMf(playerid, COLOR_RED, "You don't own an ID Card. go to cityhall and bough them");
							return 1;
						}
		        	    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET secondjob = %i WHERE uid = %i", i, PlayerInfo[playerid][pID]);
						mysql_tquery(connectionID, queryBuffer);

						PlayerInfo[playerid][pSecondJob] = i;
						SM(playerid, COLOR_AQUA, "You are now a "SVRCLR"%s{CCFFFF}. Use /jobhelp for a list of commands related to your new job.", jobLocations[i][jobName]);
		            }
		            else
		            {
		            	SendClientMessage(playerid, COLOR_SYNTAX, "You have a job already. Please quit your current job before getting another one.");
					}

					return 1;
				}

				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET job = %i WHERE uid = %i", i, PlayerInfo[playerid][pID]);
				mysql_tquery(connectionID, queryBuffer);

				PlayerInfo[playerid][pJob] = i;
				PlayerInfo[playerid][pLastPress] = gettime(); // Prevents spamming. Sometimes keys get messed up and register twice.
				SM(playerid, COLOR_AQUA, "You are now a "SVRCLR"%s{CCFFFF}. Use /jobhelp for a list of commands related to your new job.", jobLocations[i][jobName]);
				return 1;
			}
		}
	}
    if(PRESSED(KEY_NO) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    callcmd::blackmarket(playerid);
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
       if(IsPlayerInRangeOfPoint(playerid, 2.0, -545.220642, -188.894531, 78.406250))
       {
           callcmd::loadsandal(playerid);
	   }
	}
   	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		callcmd::buyfood(playerid);
	}
   	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   if(IsPlayerInRangeOfPoint(playerid, 5.0, 958.208068, -1737.559936, 17.477420))
       {
			callcmd::jobcenter(playerid);
	   }
	}
   	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   if(IsPlayerInRangeOfPoint(playerid, 5.0, 696.514587, -1506.878417, 15.856710))
       {
			callcmd::buyhospitalitems(playerid);
	   }
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	   callcmd::buygun(playerid);
	}
	if((newkeys & KEY_NO) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(PlayerHasJob(playerid, JOB_MINER) && PlayerInfo[playerid][pMiningTime] <= 0 && !(PlayerInfo[playerid][pMiningRock] > 0 && GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CARRY) && IsPlayerInMiningArea(playerid))
		{
			callcmd::mine(playerid);
		}
	}

   	if(newkeys & KEY_NO)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		new closestcar = GetClosestCar(playerid, vehicleid);
		if(IsPlayerInRangeOfVehicle(playerid, closestcar, 3.0) && GetVehicleModel(closestcar) == 508)
		{
		    if(VehicleStatus{closestcar} == 1) return SendClientMessage(playerid, COLOR_WHITE, "You're not allowed to enter this Journey as it's been damaged!");
			SendProximityMessage(playerid, 20.0, COLOR_LE, "* %s enters the Journey as a passenger.", GetRPName(playerid));
			SetFreezePos(playerid, 1589.275634, 1603.419433, 2001.095947);
			SetPlayerPos(playerid, 1589.275634, 1603.419433, 2001.095947);
	     	SetPlayerFacingAngle(playerid, 88.00);
	        SetCameraBehindPlayer(playerid);
			PlayerInfo[playerid][pVW] = closestcar;
			SetPlayerVirtualWorld(playerid, closestcar);
			SetPVarInt(playerid, "DoorID", 50519);
			PlayerInfo[playerid][pInt] = 1;
	        SetPlayerInterior(playerid, 1);
			VehicleInterior[playerid] = closestcar;
			SendClientMessage(playerid, COLOR_WHITE, "Press N to exit the vehicle.");
		}
		if(IsPlayerInRangeOfVehicle(playerid, closestcar, 3.0) && GetVehicleModel(closestcar) == 416)
		{
		    if(VehicleStatus{closestcar} == 1) return SendClientMessage(playerid, COLOR_WHITE, "You're not allowed to enter this Ambulance as it's been damaged!");
			SendProximityMessage(playerid, 20.0, COLOR_LE, "* %s enters the Ambulance as a passenger.", GetRPName(playerid));
			SetFreezePos(playerid, 1597.860229, 1530.246948, 3001.085937);
			SetPlayerPos(playerid, 1597.860229, 1530.246948, 3001.085937);
	     	SetPlayerFacingAngle(playerid, 176.14);
	        SetCameraBehindPlayer(playerid);
			PlayerInfo[playerid][pVW] = closestcar;
			SetPlayerVirtualWorld(playerid, closestcar);
			SetPVarInt(playerid, "DoorID", 50519);
			PlayerInfo[playerid][pInt] = 1;
	        SetPlayerInterior(playerid, 1);
			VehicleInterior[playerid] = closestcar;
			SendClientMessage(playerid, COLOR_WHITE, "Press N to exit the vehicle.");
		}
	 	if(VehicleInterior[playerid] != INVALID_VEHICLE_ID && IsPlayerInRangeOfPoint(playerid,3, 1589.275634, 1603.419433, 2001.095947))
		{
	        if(VehicleInterior[playerid] == INVALID_VEHICLE_ID || GetVehicleModel(VehicleInterior[playerid]) != 508) {
	      		SendProximityMessage(playerid, 20.0, COLOR_LE, "* %s exits the Journey vehicle.", GetRPName(playerid));
	            SetPlayerPos(playerid, 0.000000, 0.000000, 420.000000);
	        }
	        else {
	            new Float:X, Float:Y, Float:Z;
	            GetVehiclePos(VehicleInterior[playerid], X, Y, Z);
	            SetPlayerPos(playerid, X-4, Y-2.3, Z);

	            new Float:XB, Float:YB, Float:ZB;
	            GetVehiclePos(VehicleInterior[playerid], XB, YB, ZB);
	            if(ZB > 50.0) {
	            }
	        }

	        PlayerInfo[playerid][pVW] = 0;
	        SetPlayerVirtualWorld(playerid, 0);
	        PlayerInfo[playerid][pInt] = 0;
	        SetPlayerInterior(playerid, 0);
	        VehicleInterior[playerid] = INVALID_VEHICLE_ID;
		}
		if(VehicleInterior[playerid] != INVALID_VEHICLE_ID && IsPlayerInRangeOfPoint(playerid,3, 1597.860229, 1530.246948, 3001.085937))
		{
	        if(VehicleInterior[playerid] == INVALID_VEHICLE_ID || GetVehicleModel(VehicleInterior[playerid]) != 416) {
	      		SendProximityMessage(playerid, 20.0, COLOR_LE, "* %s exits the Ambulance vehicle.", GetRPName(playerid));
	            SetPlayerPos(playerid, 0.000000, 0.000000, 420.000000);
	        }
	        else {
	            new Float:X, Float:Y, Float:Z;
	            GetVehiclePos(VehicleInterior[playerid], X, Y, Z);
	            SetPlayerPos(playerid, X-4, Y-2.3, Z);

	            new Float:XB, Float:YB, Float:ZB;
	            GetVehiclePos(VehicleInterior[playerid], XB, YB, ZB);
	            if(ZB > 50.0) {
	            }
	        }
	        PlayerInfo[playerid][pVW] = 0;
	        SetPlayerVirtualWorld(playerid, 0);
	        PlayerInfo[playerid][pInt] = 0;
	        SetPlayerInterior(playerid, 0);
	        VehicleInterior[playerid] = INVALID_VEHICLE_ID;
		}
	}
	if(newkeys & KEY_CTRL_BACK && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	 	{
			callcmd::irev(playerid);
		}
	if(newkeys & KEY_SECONDARY_ATTACK)
	{
	    if(IsAtVendor(playerid))
	    {
	        if(gettime() - PlayerInfo[playerid][pLastVendor] < 15)
		    {
		        return SendClientMessage(playerid, COLOR_SYNTAX, "You can only buy streetfoods in every 15 seconds.");
		    }
		    if(PlayerInfo[playerid][pHunger] == 100 && PlayerInfo[playerid][pThirst] == 100)
		    {
		    	return SendClientMessage(playerid, COLOR_SYNTAX, "You are not hungry you don't need to eat or drink.");
		    }
		    PlayerInfo[playerid][pLastVendor] = gettime();
		    PlayerInfo[playerid][pThirst] += 10;
		    if(PlayerInfo[playerid][pThirst] > 100)
		    {
		    	PlayerInfo[playerid][pThirst] = 100;
		    }
		    PlayerInfo[playerid][pHunger] += 10;
		    if(PlayerInfo[playerid][pHunger] > 100)
		    {
		    	PlayerInfo[playerid][pHunger] = 100;
		    }
		    GivePlayerHealth(playerid, 10.0);
		    GivePlayerCash(playerid, -10);
		    ApplyAnimationEx(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0);
		    SendClientMessage(playerid, COLOR_GREY, "You have bought street foods for $10");
	    }
	}

	if(newkeys & KEY_YES)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
    		if(IsPlayerInRangeOfLocker(playerid, PlayerInfo[playerid][pFaction]))
    		{
				switch(FactionInfo[PlayerInfo[playerid][pFaction]][fType])
				{
				    case FACTION_POLICE, FACTION_NPOLICE, FACTION_MEDIC, FACTION_FEDERAL, FACTION_TERRORIST, FACTION_ARMY, FACTION_JAILGUARDS:
				    {
				        ShowPlayerDialog(playerid, DIALOG_FACTIONLOCKER, DIALOG_STYLE_LIST, "Locker", "Toggle duty\nEquipment\nUniforms\nClothings", "Select", "Cancel");
					}
					case FACTION_GOVERNMENT, FACTION_NEWS, FACTION_MECHANIC:
					{
					    ShowPlayerDialog(playerid, DIALOG_FACTIONLOCKER, DIALOG_STYLE_LIST, "Locker", "Toggle duty\nEquipment\nUniforms", "Select", "Cancel");
					}
					case FACTION_HITMAN:
					{
					    ShowPlayerDialog(playerid, DIALOG_FACTIONLOCKER, DIALOG_STYLE_LIST, "Locker", "Order weapons\nChange clothes", "Select", "Cancel");
					}
				}
			}
		}
	}
    if(newkeys & KEY_NO)
	{
		if(GetInsideBusiness(playerid) >= 0)
		{
			return callcmd::buy(playerid);
		}
	}

	if(!pCBugging[playerid] && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && PlayerInfo[playerid][pDueling] == INVALID_PLAYER_ID)
	{
	    if(!PlayerInfo[playerid][pJoinedEvent])
		{
			if(PRESSED(KEY_FIRE))
			{
				switch(GetPlayerWeapon(playerid))
				{
					case WEAPON_DEAGLE, WEAPON_SHOTGUN, WEAPON_SNIPER:
					{
						ptsLastFiredWeapon[playerid] = gettime();
					}
				}
			}
			else if(PRESSED(KEY_CROUCH))
			{
				if((gettime() - ptsLastFiredWeapon[playerid]) < 1)
				{
                 	//ApplyAnimationEx(playerid, "RIOT", "RIOT_ANGRY", 4.1, 0, 0, 0, 0, 0);
					pCBugging[playerid] = true;
					//ApplyAnimation(playerid, "GANGS", "prtial_gngtlkE", 4.1, 1, 0, 0, 0, 1000);
					KillTimer(ptmCBugFreezeOver[playerid]);
					ptmCBugFreezeOver[playerid] = SetTimerEx("CBugFreezeOver", 1500, false, "i", playerid);
				}
			}
		}
	    if(PlayerInfo[playerid][pJoinedEvent] && !EventInfo[eCS])
		{
			if(PRESSED(KEY_FIRE))
			{
				switch(GetPlayerWeapon(playerid))
				{
					case WEAPON_DEAGLE, WEAPON_SHOTGUN, WEAPON_SNIPER:
					{
						ptsLastFiredWeapon[playerid] = gettime();
					}
				}
			}
			else if(PRESSED(KEY_CROUCH))
			{
				if((gettime() - ptsLastFiredWeapon[playerid]) < 1)
				{
				  	new Float:health;
	    			GetPlayerHealth(playerid, health);
		    		SetPlayerHealth(playerid, health - 9.0);
		    		//ApplyAnimationEx(playerid, "RIOT", "RIOT_ANGRY", 4.1, 0, 0, 0, 0, 0);
					pCBugging[playerid] = true;
					ApplyAnimationEx(playerid, "GANGS", "prtial_gngtlkE", 4.1, 1, 0, 0, 0, 1000);
					KillTimer(ptmCBugFreezeOver[playerid]);
					ptmCBugFreezeOver[playerid] = SetTimerEx("CBugFreezeOver", 1500, false, "i", playerid);
				}
			}
		}
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
        callcmd::engine(playerid);
	}
	if(newkeys & KEY_NO)
	{
	    if(PlayerHasJob(playerid, JOB_CONSTRUCTION))
	        {
	        if(IsPlayerInConstructionArea(playerid))
	        {
	        if(PlayerInfo[playerid][pConstructionTime] > 0)
	        {
		        return SCMf(playerid, COLOR_SYNTAX, "Wait until you are done.");
	        }
	        if(PlayerInfo[playerid][pConstruction] > 0 && GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CARRY)
	        {
		        return SCMf(playerid, COLOR_SYNTAX, "You need to drop off your current rock first.");
	        }

	        ApplyAnimation(playerid, "BASEBALL", "BAT_4", 4.1, 1, 0, 0, 0, 0, 1);

	        DisablePlayerCheckpoint(playerid);
		    SetPlayerAttachedObject(playerid, 9, 19631, 6);

		    PlayerInfo[playerid][pConstructionTime] = 6;
		   }
		}
	}
	if(newkeys & KEY_SPRINT)
	{
	    if(PlayerInfo[playerid][pLoopAnim])
	    {
	        PlayerInfo[playerid][pLoopAnim] = 0;

		    ApplyAnimationEx(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0);
		    TextDrawHideForPlayer(playerid, AnimationTD);
		}
	}
	if(newkeys & KEY_WALK && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		callcmd::vpanel(playerid);
	}
 	if((gettime() - PlayerInfo[playerid][pLastPress]) >= 1)
	{
		if(newkeys & KEY_YES)
		{
			if(!EnterCheck(playerid)) ExitCheck(playerid);

			new id = Gate_Nearest(playerid);
			if (id != -1)
			{
				if(PlayerInfo[playerid][pHurt] - 30 > 0)
					return SM(playerid, COLOR_GREY, "You are too hurt to operate/enter anything. Please wait %i seconds before trying again.", (PlayerInfo[playerid][pHurt] - 30));

				if (strlen(GateData[id][gatePass]))
				{
					ShowPlayerDialog(playerid, GatePass, DIALOG_STYLE_INPUT, "Enter Password", "Please enter the password for this gate below:", "Submit", "Cancel");
				}
				else
				{
					if (GateData[id][gateFaction] != -1 && PlayerInfo[playerid][pFaction] != GetFactionByID(GateData[id][gateFaction]))
						return SendClientMessage(playerid, COLOR_SYNTAX, "You can't open this gate/door.");

					Gate_Operate(id);

					switch (GateData[id][gateOpened])
					{
						case 0:
							Dyuze(playerid, "Notice", "You have closed the gate/door!");

						case 1:
							Dyuze(playerid, "Notice", "You have opened the gate/door!");
					}
				}
			}
			PlayerInfo[playerid][pLastPress] = gettime();
		}
		else if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 		{
		  	callcmd::engine(playerid);
			PlayerInfo[playerid][pLastPress] = gettime();
		}
	}
	if(newkeys & KEY_YES && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 3.0, 1481.073242, -1768.236450, 18.810064))
	    {
			new string[1024];
			for(new i = 0; i < sizeof(jobLocations); i++)
			{
				format(string, sizeof(string), "%sApply for %s\n", string, jobLocations[i]);
			}
			ShowPlayerDialog(playerid, DIALOG_CITY_HALL, DIALOG_STYLE_LIST, "Choose your job", string, "Select", "Close");
        }
	}
	if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
 	{
 	    new id = GetNearbyVehicle(playerid);
		if(PlayerHasJob(playerid, JOB_FARMER))
	    {
			if(IsPlayerInHarvestArea(playerid))
			{
				if(Vehicle_WheatCount(id) >= WHEAT_LIMIT)
				{
					SendClientMessage(playerid, COLOR_ERROR, "You can't take a wheat any more.");
				}
				if(PlayerInfo[playerid][pHarvestTime] > 0)
				{
	    		return SendClientMessage(playerid, COLOR_SYNTAX, "You are harvesting already. Wait until you are done.");
				}
				if(PlayerInfo[playerid][pWheat] > 0 && GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CARRY)
				{
			    return SendClientMessage(playerid, COLOR_SYNTAX, "You need to drop off your current rock first.");
				}
                GameTextForPlayer(playerid, "~g~Harvesting...", 6000, 3);
			    ApplyAnimationEx(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);

				DisablePlayerCheckpoint(playerid);

				PlayerInfo[playerid][pHarvestTime] = 6;
			}
		}
	}
   	if(PollOn && PollVoted[playerid] == 0)
	{
	    if(newkeys == KEY_YES)
	    {
			PollY++;
			PollVoted[playerid] = 1;
			SendClientMessage(playerid, COLOR_SYNTAX, "You Have Voted Yes.");
		}
	    if(newkeys & KEY_NO)
	    {
			PollN++;
			PollVoted[playerid] = 1;
			SendClientMessage(playerid, SERVER_COLOR, "** "WHITE" You Have Voted No.");
	    }
	}

	return 1;
}
public OnPlayerStateChange(playerid, PLAYER_STATE:newstate, PLAYER_STATE:oldstate)
{
    if(PlayerInfo[playerid][pKicked])
        return 0;

	AntiVDM_OnPlayerStateChange(playerid, newstate, oldstate);

    // =========================================
    // VEHICLE CACHE
    // =========================================

    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
    {
        if(IsPlayerInAnyVehicle(playerid))
        {
            new vehicleid = GetPlayerVehicleID(playerid);

            if(vehicleid > 0 && vehicleid < MAX_VEHICLES)
            {
                pvehicleid[playerid] = vehicleid;
                pmodelid[playerid] = GetVehicleModel(vehicleid);
            }
        }
    }
    else
    {
        pvehicleid[playerid] = 0;
        pmodelid[playerid] = 0;
    }

    // =========================================
    // DRIVER STATE
    // =========================================

    if(newstate == PLAYER_STATE_DRIVER)
    {
        if(!IsPlayerInAnyVehicle(playerid))
            return 1;

        new vehicleid = GetPlayerVehicleID(playerid);

        if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES)
            return 1;

        // =========================================
        // FARMER VEHICLES
        // =========================================

        if(vehicleid >= FarmerVehicles[0] && vehicleid <= FarmerVehicles[9])
        {
            if(!PlayerHasJob(playerid, JOB_FARMER))
            {
                SCMf(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Farmer.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
        }

        // =========================================
        // OIL EXPORTER VEHICLES
        // =========================================


        if(vehicleid >= OILTranportVehicles[0] && vehicleid <= OILTranportVehicles[9])
        {
            if(!PlayerHasJob(playerid, JOB_FUELEXPORTER))
            {
                SCMf(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Oil Exporter.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
        }

        // =========================================
        // DRIVING TEST VEHICLES
        // =========================================

        if(vehicleid >= testVehicles[0] && vehicleid <= testVehicles[5])
        {
            if(!PlayerInfo[playerid][pDrivingTest])
            {
                SCMf(playerid, COLOR_SYNTAX, "You are not taking the driving test.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
        }

        // =========================================
        //  FUEL EXPORTER
        // =========================================

        if(newstate == PLAYER_STATE_ONFOOT)
        {
            if(FillingFuel[playerid])
            {
                CancelFuelLoading(playerid);
            }
            return 1;
        }


        // =========================================
        // FACTION VEHICLES
        // =========================================

        if(VehicleInfo[vehicleid][vFactionType] != FACTION_NONE)
        {
            if(GetFactionType(playerid) != VehicleInfo[vehicleid][vFactionType])
            {
                SCMf(playerid, COLOR_GREY, "This vehicle doesn't belong to your faction.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
        }

        // =========================================
        // JOB VEHICLES
        // =========================================

        if(VehicleInfo[vehicleid][vJob] >= 0)
        {
            if(PlayerInfo[playerid][pJob] != VehicleInfo[vehicleid][vJob])
            {
                SM(
                    playerid,
                    COLOR_SYNTAX,
                    "You must be a %s to use this vehicle.",
                    GetJobName(VehicleInfo[vehicleid][vJob])
                );

                RemovePlayerFromVehicle(playerid);
                return 1;
            }
        }

        // =========================================
        // ENGINE SYSTEM
        // =========================================

        if(!VehicleHasEngine(vehicleid))
        {
            SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);
        }
        else if(!GetVehicleParams(vehicleid, VEHICLE_ENGINE))
        {
            if(vehicleid >= testVehicles[0] && vehicleid <= testVehicles[5])
            {
                PlayerInfo[playerid][pCP] = CHECKPOINT_TEST;
                PlayerInfo[playerid][pTestVehicle] = vehicleid;
                PlayerInfo[playerid][pTestCP] = 0;

                SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);

                SetPlayerCheckpoint(
                    playerid,
                    drivingTestCPs[0][0],
                    drivingTestCPs[0][1],
                    drivingTestCPs[0][2],
                    3.0
                );

                SCMf(
                    playerid,
                    COLOR_GREEN,
                    "Drive through the checkpoints carefully."
                );
            }
            else
            {
                SCMf(
                    playerid,
                    COLOR_YELLOW,
                    "Press 'N' for engine or 'Y' for vehicle panel."
                );
            }
        }

        // =========================================
        // TICKETS
        // =========================================

        if(IsVehicleOwner(playerid, vehicleid))
        {
            if(VehicleInfo[vehicleid][vTickets] > 0)
            {
                SM(
                    playerid,
                    COLOR_GREEN,
                    "This vehicle has $%i unpaid tickets. Use /paytickets.",
                    VehicleInfo[vehicleid][vTickets]
                );
            }
        }

        // =========================================
        // FUEL SYSTEM
        // =========================================

        if(VehicleHasEngine(vehicleid))
        {
            if(GetVehicleFuelLevel(vehicleid) <= 0)
            {
                GameTextForPlayer(playerid, "~r~OUT OF FUEL", 5000, 3);
            }
        }

        SetPlayerArmedWeapon(playerid, 0);
    }

    // =========================================
    // EXIT DRIVER STATE
    // =========================================

    else if(oldstate == PLAYER_STATE_DRIVER)
    {
        if(PlayerInfo[playerid][pDrivingTest])
        {
            PlayerInfo[playerid][pDrivingTest] = 0;

            if(PlayerInfo[playerid][pTestVehicle] > 0 &&
                PlayerInfo[playerid][pTestVehicle] < MAX_VEHICLES)
            {
                SetVehicleToRespawn(PlayerInfo[playerid][pTestVehicle]);
            }

            SCMf(
                playerid,
                COLOR_LIGHTRED,
                "** You exited the vehicle and failed the driving test."
            );
        }

        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);

        if(PlayerInfo[playerid][pCooking])
        {
            GameTextForPlayer(playerid, "~r~COOKER EXPLODED", 1000, 5);

            SCMf(
                playerid,
                COLOR_LIGHTRED,
                "** You exited the vehicle and the cooker exploded."
            );

            PlayerInfo[playerid][pCooking] = 0;

            CreateExplosion(x, y, z, 6, 6.0);
        }

        new vehicleid = GetNearbyVehicle(playerid);

        if(vehicleid != INVALID_VEHICLE_ID)
        {
            if(vehicleid > 0 && vehicleid < MAX_VEHICLES)
            {
                if(IsVehicleOwner(playerid, vehicleid))
                {
                    if(!VehicleInfo[vehicleid][vLocked])
                    {
                        SCMf(
                            playerid,
                            COLOR_LIGHTRED,
                            "Don't leave your vehicle unlocked."
                        );
                    }
                }
            }
        }
    }

    // =========================================
    // PASSENGER STATE
    // =========================================

    else if(newstate == PLAYER_STATE_PASSENGER)
    {
        switch(GetPlayerWeapon(playerid))
        {
            case 22, 28, 29, 32:
            {
                SetPlayerArmedWeapon(playerid, GetScriptWeapon(playerid));
            }

            default:
            {
                SetPlayerArmedWeapon(playerid, 0);
            }
        }
    }

    return 1;
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	if(!(-3.0 <= fScaleX <= 3.0)) fScaleX = fScaleX < -3.0 ? 0.0 : 3.0;
	if(!(-3.0 <= fScaleY <= 3.0)) fScaleY = fScaleY < -3.0 ? 0.0 : 3.0;
	if(!(-3.0 <= fScaleZ <= 3.0)) fScaleZ = fScaleZ < -3.0 ? 0.0 : 3.0;

	switch(PlayerInfo[playerid][pEditType])
	{
	    case EDIT_CLOTHING_PREVIEW:
	    {
	        RemovePlayerAttachedObject(playerid, 9);

	        if(response)
	        {
	            new businessid = GetInsideBusiness(playerid);
	            if(businessid >= 0 && BusinessInfo[businessid][bType] == BUSINESS_CLOTHES)
	            {
	                if(BusinessInfo[businessid][bProducts] <= 0)
	                {
	                    return SendClientMessage(playerid, COLOR_SYNTAX, "This business is out of stock now.");
					}
	                if(PlayerInfo[playerid][pCash] < BusinessInfo[businessid][bPrices][1])
	                {
	                    return SendClientMessage(playerid, COLOR_SYNTAX, "You couldn't afford to purchase this item.");
	                }

	                for(new i = 0; i < MAX_PLAYER_CLOTHING; i ++)
	                {
	                    if(!ClothingInfo[playerid][i][cExists])
	                    {
	                        ClothingInfo[playerid][i][cModel] = modelid;
	                        ClothingInfo[playerid][i][cBone] = boneid;
	                        ClothingInfo[playerid][i][cPosX] = fOffsetX;
	                        ClothingInfo[playerid][i][cPosY] = fOffsetY;
	                        ClothingInfo[playerid][i][cPosZ] = fOffsetZ;
	                        ClothingInfo[playerid][i][cRotX] = fRotX;
	                        ClothingInfo[playerid][i][cRotY] = fRotY;
	                        ClothingInfo[playerid][i][cRotZ] = fRotZ;
	                        ClothingInfo[playerid][i][cScaleX] = fScaleX;
	                        ClothingInfo[playerid][i][cScaleY] = fScaleY;
	                        ClothingInfo[playerid][i][cScaleZ] = fScaleZ;

	                        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO clothing VALUES(null, %i, '%e', %i, %i, 0, '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f')", PlayerInfo[playerid][pID], clothingArray[PlayerInfo[playerid][pSelected]][clothingName], modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
							mysql_tquery(connectionID, queryBuffer, "OnPlayerBuyClothingItem", "isiii", playerid, clothingArray[PlayerInfo[playerid][pSelected]][clothingName], BusinessInfo[businessid][bPrices][1], businessid, i);
							return 1;
						}
					}

					SendClientMessage(playerid, COLOR_SYNTAX, "You have no more clothing slots available. Therefore you can't buy this.");
	            }
	        }
	        else
	        {
	            ShowDialogToPlayer(playerid, DIALOG_BUYCLOTHING);
			}
		}
		case EDIT_CLOTHING:
		{
		    new clothingid = PlayerInfo[playerid][pSelected];

		    if(response)
		    {
		        ClothingInfo[playerid][clothingid][cPosX] = fOffsetX;
		        ClothingInfo[playerid][clothingid][cPosY] = fOffsetY;
		        ClothingInfo[playerid][clothingid][cPosZ] = fOffsetZ;
		        ClothingInfo[playerid][clothingid][cRotX] = fRotX;
		        ClothingInfo[playerid][clothingid][cRotY] = fRotY;
		        ClothingInfo[playerid][clothingid][cRotZ] = fRotZ;
		        ClothingInfo[playerid][clothingid][cScaleX] = fScaleX;
		        ClothingInfo[playerid][clothingid][cScaleY] = fScaleY;
		        ClothingInfo[playerid][clothingid][cScaleZ] = fScaleZ;

		        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE clothing SET pos_x = '%f', pos_y = '%f', pos_z = '%f', rot_x = '%f', rot_y = '%f', rot_z = '%f', scale_x = '%f', scale_y = '%f', scale_z = '%f' WHERE id = %i", fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ, ClothingInfo[playerid][clothingid][cID]);
		        mysql_tquery(connectionID, queryBuffer);

		        SM(playerid, COLOR_SYNTAX, "Changes saved.");
		    }

			if(!ClothingInfo[playerid][clothingid][cAttached])
	        {
	            RemovePlayerAttachedObject(playerid, 9);
			}
			else
			{
			    RemovePlayerAttachedObject(playerid, ClothingInfo[playerid][clothingid][cAttachedIndex]);
			    SetPlayerAttachedObject(playerid, ClothingInfo[playerid][clothingid][cAttachedIndex], ClothingInfo[playerid][clothingid][cModel], ClothingInfo[playerid][clothingid][cBone], ClothingInfo[playerid][clothingid][cPosX], ClothingInfo[playerid][clothingid][cPosY], ClothingInfo[playerid][clothingid][cPosZ],
					ClothingInfo[playerid][clothingid][cRotX], ClothingInfo[playerid][clothingid][cRotY], ClothingInfo[playerid][clothingid][cRotZ], ClothingInfo[playerid][clothingid][cScaleX], ClothingInfo[playerid][clothingid][cScaleY], ClothingInfo[playerid][clothingid][cScaleZ]);
			}
		}
	}

    return 1;
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	if(response == EDIT_RESPONSE_FINAL)
    {
        if(pEditAtm[playerid] != -1 && AtmInfo[pEditAtm[playerid]][aExists])
        {
            switch(PlayerInfo[playerid][pEditType])
            {
                case 10:
                {
                    new atmid = pEditAtm[playerid];

                    AtmInfo[atmid][aPosX] = x;
                    AtmInfo[atmid][aPosY] = y;
                    AtmInfo[atmid][aPosZ] = z;
                    AtmInfo[atmid][aPosA] = rz;

                    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE atms SET pos_x = '%f', pos_y = '%f', pos_z = '%f', pos_r = '%f' WHERE id = %i", x, y, z, rz, AtmInfo[atmid][aID]);
                    mysql_tquery(connectionID, queryBuffer);
                    ReloadAtm(atmid);
                    SCMf(playerid, COLOR_WHITE, "You have edited the ATM position.");

                    pEditAtm[playerid] = -1;
                    PlayerInfo[playerid][pEditType] = 0;
                }
            }
        }
    }
    else if(response == EDIT_RESPONSE_CANCEL)
    {
        pEditAtm[playerid] = -1;
        PlayerInfo[playerid][pEditType] = 0;
    }
	if(response == EDIT_RESPONSE_FINAL)
	{
		if(pEditFuel[playerid] != -1 && FuelInfo[pEditFuel[playerid]][feExists])
		{
			switch(PlayerInfo[playerid][pEditType])
			{
				case 1:
				{
					new fuelid = pEditFuel[playerid];

					FuelInfo[fuelid][fePosx] = x;
					FuelInfo[fuelid][fePosy] = y;
					FuelInfo[fuelid][fePosz] = z;
					FuelInfo[fuelid][fePosa] = rz;

					mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE fuelstations SET posx = '%f', posy = '%f', posz = '%f', posa = '%f' WHERE id = %i", x, y, z, rz, FuelInfo[fuelid][feID]);
					mysql_tquery(connectionID, queryBuffer);

					ReloadFuel(fuelid);

					SM(playerid, COLOR_WHITE, "You have edited the fuel station position.");

					pEditFuel[playerid] = -1;
					PlayerInfo[playerid][pEditType] = 0;
				}
			}
		}
	}
	else if(response == EDIT_RESPONSE_CANCEL)
	{
		pEditFuel[playerid] = -1;
		PlayerInfo[playerid][pEditType] = 0;
	}
	if(response == EDIT_RESPONSE_FINAL)
	{
	    if (PlayerInfo[playerid][pEditGraffiti] != -1 && GraffitiData[PlayerInfo[playerid][pEditGraffiti]][graffitiExists])
	    {
			GraffitiData[PlayerInfo[playerid][pEditGraffiti]][graffitiPos][0] = x;
			GraffitiData[PlayerInfo[playerid][pEditGraffiti]][graffitiPos][1] = y;
			GraffitiData[PlayerInfo[playerid][pEditGraffiti]][graffitiPos][2] = z;
			GraffitiData[PlayerInfo[playerid][pEditGraffiti]][graffitiPos][3] = rz;

			Graffiti_Refresh(PlayerInfo[playerid][pEditGraffiti]);
			Graffiti_Save(PlayerInfo[playerid][pEditGraffiti]);
		}
		else if (PlayerInfo[playerid][pEditGate] != -1 && GateData[PlayerInfo[playerid][pEditGate]][gateExists])
	    {
	        switch (PlayerInfo[playerid][pEditType])
	        {
	            case 1:
	            {
	                new id = PlayerInfo[playerid][pEditGate];

	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][0] = x;
	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][1] = y;
	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][2] = z;
	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][3] = rx;
	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][4] = ry;
	                GateData[PlayerInfo[playerid][pEditGate]][gatePos][5] = rz;

	                DestroyDynamicObject(GateData[id][gateObject]);
					GateData[id][gateObject] = CreateDynamicObject(GateData[id][gateModel], GateData[id][gatePos][0], GateData[id][gatePos][1], GateData[id][gatePos][2], GateData[id][gatePos][3], GateData[id][gatePos][4], GateData[id][gatePos][5], GateData[id][gateWorld], GateData[id][gateInterior]);

					Gate_Save(id);
                    SM(playerid, COLOR_WHITE, "You have edited the position of gate ID: %d.", id);
				}
				case 2:
	            {
	                new id = PlayerInfo[playerid][pEditGate];

	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][0] = x;
	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][1] = y;
	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][2] = z;
	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][3] = rx;
	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][4] = ry;
	                GateData[PlayerInfo[playerid][pEditGate]][gateMove][5] = rz;

	                DestroyDynamicObject(GateData[id][gateObject]);
					GateData[id][gateObject] = CreateDynamicObject(GateData[id][gateModel], GateData[id][gatePos][0], GateData[id][gatePos][1], GateData[id][gatePos][2], GateData[id][gatePos][3], GateData[id][gatePos][4], GateData[id][gatePos][5], GateData[id][gateWorld], GateData[id][gateInterior]);

					Gate_Save(id);
                    SM(playerid, COLOR_WHITE, "You have edited the moving position of gate ID: %d.", id);
				}
			}
		}
	}
	switch(PlayerInfo[playerid][pEditType])
	{
		case EDIT_OBJECT_PREVIEW:
		{
			if(response == EDIT_RESPONSE_FINAL)
			{
				if (PlayerInfo[playerid][pEditmObject] != -1 && ObjectData[PlayerInfo[playerid][pEditmObject]][mobjExists])
				{
					new string[48];
					new id = PlayerInfo[playerid][pEditmObject];
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][0] = x;
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][1] = y;
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][2] = z;
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][3] = rx;
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][4] = ry;
					ObjectData[PlayerInfo[playerid][pEditmObject]][mobjPos][5] = rz;

					DestroyDynamicObject(ObjectData[id][mobjObject]);
					ObjectData[id][mobjObject] = CreateDynamicObject(ObjectData[id][mobjModel], ObjectData[id][mobjPos][0], ObjectData[id][mobjPos][1], ObjectData[id][mobjPos][2], ObjectData[id][mobjPos][3], ObjectData[id][mobjPos][4], ObjectData[id][mobjPos][5], ObjectData[id][mobjWorld], ObjectData[id][mobjInterior]);

					DestroyDynamic3DTextLabel(ObjectData[id][mobjname2]);
					format(string, sizeof(string), "[%i]\nID: %i", ObjectData[id][mobjModel], id);
					ObjectData[id][mobjname2] = CreateDynamic3DTextLabel(string, COLOR_GREY, ObjectData[id][mobjPos][0], ObjectData[id][mobjPos][1], ObjectData[id][mobjPos][2], 5.0);

					Object_Save(id);
					SM(playerid, COLOR_WHITE, "You have edited the position of object ID: %d.", id);
				}
			}
		}
	    case EDIT_FURNITURE_PREVIEW:
	    {
			if(response != EDIT_RESPONSE_UPDATE)
			{
			    DestroyDynamicObject(PlayerInfo[playerid][pEditObject]);
				PlayerInfo[playerid][pEditObject] = INVALID_OBJECT_ID;

			    if(response == EDIT_RESPONSE_FINAL)
			    {
			        new houseid = GetInsideHouse(playerid);

					if(houseid >= 0 && HasFurniturePerms(playerid, houseid))
					{
					    if(PlayerInfo[playerid][pCash] < furnitureArray[PlayerInfo[playerid][pSelected]][fPrice])
		                {
		                    return SendClientMessage(playerid, COLOR_SYNTAX, "You couldn't afford to purchase this item.");
		                }

					    new
					        string[16];

					    GivePlayerCash(playerid, -furnitureArray[PlayerInfo[playerid][pSelected]][fPrice]);

						mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO furniture VALUES(null, %i, %i, '%e', %i, '%f', '%f', '%f', '%f', '%f', '%f', %i, %i, 0, 0)", HouseInfo[houseid][hID], furnitureArray[PlayerInfo[playerid][pSelected]][fModel], furnitureArray[PlayerInfo[playerid][pSelected]][fName], furnitureArray[PlayerInfo[playerid][pSelected]][fPrice], x, y, z, rx, ry, rz, HouseInfo[houseid][hInterior], HouseInfo[houseid][hWorld]);
						mysql_tquery(connectionID, queryBuffer);
						mysql_tquery(connectionID, "SELECT * FROM furniture WHERE id = LAST_INSERT_ID()", "OnQueryFinished", "ii", THREAD_LOAD_FURNITURE, HouseInfo[houseid][hLabels]);

						format(string, sizeof(string), "~r~-$%i", furnitureArray[PlayerInfo[playerid][pSelected]][fPrice]);
						GameTextForPlayer(playerid, string, 5000, 1);

						if(!strcmp(furnitureArray[PlayerInfo[playerid][pSelected]][fCategory], "Doors & Gates"))
						{
							SendClientMessage(playerid, COLOR_WHITE, "** You can use /lopen to control your door and /lock to unlock or lock it.");
						}
					}
			    }
			    else if(response == EDIT_RESPONSE_CANCEL)
			    {
			        ShowDialogToPlayer(playerid, DIALOG_BUYFURNITURE2);
				}
			}
		}
		case EDIT_FURNITURE:
		{
		    if(response != EDIT_RESPONSE_UPDATE)
			{
				if(response == EDIT_RESPONSE_FINAL)
				{
				    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE furniture SET pos_x = '%f', pos_y = '%f', pos_z = '%f', rot_x = '%f', rot_y = '%f', rot_z = '%f' WHERE id = %i", x, y, z, rx, ry, rz, Streamer_GetExtraInt(objectid, E_OBJECT_INDEX_ID));
					mysql_tquery(connectionID, queryBuffer);
					SendClientMessage(playerid, COLOR_SYNTAX, "Changes saved.");
				}

		        ReloadFurniture(objectid, HouseInfo[PlayerInfo[playerid][pFurnitureHouse]][hLabels]);
			}
		}
		case EDIT_LAND_OBJECT_PREVIEW:
	    {
			if(response != EDIT_RESPONSE_UPDATE)
			{
			    DestroyDynamicObject(PlayerInfo[playerid][pEditObject]);
				PlayerInfo[playerid][pEditObject] = INVALID_OBJECT_ID;

			    if(response == EDIT_RESPONSE_FINAL)
			    {
			        new landid = PlayerInfo[playerid][pObjectLand];

					if(landid >= 0 && HasLandPerms(playerid, landid))
					{
					    if(PlayerInfo[playerid][pCash] < furnitureArray[PlayerInfo[playerid][pSelected]][fPrice])
		                {
		                    return SendClientMessage(playerid, COLOR_SYNTAX, "You couldn't afford to purchase this item.");
		                }
		                if(!IsPointInLand(landid, x, y))
		                {
		                    return SendClientMessage(playerid, COLOR_SYNTAX, "The object has exceeded the boundaries for your land.");
						}

					    new
					        string[16];

					    GivePlayerCash(playerid, -furnitureArray[PlayerInfo[playerid][pSelected]][fPrice]);

						mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO landobjects VALUES(null, %i, %i, '%e', %i, '%f', '%f', '%f', '%f', '%f', '%f', 0, 0, '%f', '%f', '%f', '-1000.0', '-1000.0', '-1000.0')", LandInfo[landid][lID], furnitureArray[PlayerInfo[playerid][pSelected]][fModel], furnitureArray[PlayerInfo[playerid][pSelected]][fName], furnitureArray[PlayerInfo[playerid][pSelected]][fPrice], x, y, z, rx, ry, rz, x, y, z - 10.0);
						mysql_tquery(connectionID, queryBuffer);
						mysql_tquery(connectionID, "SELECT * FROM landobjects WHERE id = LAST_INSERT_ID()", "OnQueryFinished", "ii", THREAD_LOAD_LANDOBJECTS, LandInfo[landid][lLabels]);

						format(string, sizeof(string), "~r~-$%i", furnitureArray[PlayerInfo[playerid][pSelected]][fPrice]);
						GameTextForPlayer(playerid, string, 5000, 1);

						if(!strcmp(furnitureArray[PlayerInfo[playerid][pSelected]][fCategory], "Doors & Gates"))
						{
							if(IsGateModel(furnitureArray[PlayerInfo[playerid][pSelected]][fModel]))
							{
								SendClientMessage(playerid, COLOR_WHITE, "** You can use /lopen to open and close your gate. To change the destination coordinates, use /land and choose 'Edit object'.");
							}
						    else
							{
								SendClientMessage(playerid, COLOR_WHITE, "** You can use /lopen to control your door and /lock to unlock or lock it.");
						    }
						}
					}
			    }
			    else if(response == EDIT_RESPONSE_CANCEL)
			    {
     			    if(PlayerInfo[playerid][pMenuType] == 0)
						ShowObjectSelectionMenu(playerid, MODEL_SELECTION_LANDOBJECTS);
					else
			        ShowDialogToPlayer(playerid, DIALOG_LANDBUILD2);
				}
			}
		}
		case EDIT_LAND_OBJECT:
		{
		    if(response != EDIT_RESPONSE_UPDATE)
			{
				if(response == EDIT_RESPONSE_FINAL)
				{
				    if(!IsPointInLand(PlayerInfo[playerid][pObjectLand], x, y))
        			{
           				SendClientMessage(playerid, COLOR_SYNTAX, "The object has exceeded the boundaries for your land.");
					}
					else
					{
					    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE landobjects SET pos_x = '%f', pos_y = '%f', pos_z = '%f', rot_x = '%f', rot_y = '%f', rot_z = '%f' WHERE id = %i", x, y, z, rx, ry, rz, Streamer_GetExtraInt(objectid, E_OBJECT_INDEX_ID));
						mysql_tquery(connectionID, queryBuffer);
						SendClientMessage(playerid, COLOR_SYNTAX, "Changes saved.");
					}
				}

		        ReloadLandObject(objectid, LandInfo[PlayerInfo[playerid][pObjectLand]][lLabels]);
			}
		}
		case EDIT_LAND_GATE_MOVE:
		{
		    if(response != EDIT_RESPONSE_UPDATE)
			{
				if(response == EDIT_RESPONSE_FINAL)
				{
				    if(!IsPointInLand(PlayerInfo[playerid][pObjectLand], x, y))
        			{
           				SendClientMessage(playerid, COLOR_SYNTAX, "The object has exceeded the boundaries for your land.");
					}
					else
					{
					    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE landobjects SET move_x = '%f', move_y = '%f', move_z = '%f', move_rx = '%f', move_ry = '%f', move_rz = '%f' WHERE id = %i", x, y, z, rx, ry, rz, Streamer_GetExtraInt(objectid, E_OBJECT_INDEX_ID));
						mysql_tquery(connectionID, queryBuffer);
						SendClientMessage(playerid, COLOR_SYNTAX, "Changes saved.");
					}
				}

		        ReloadLandObject(objectid, LandInfo[PlayerInfo[playerid][pObjectLand]][lLabels]);
			}
		}
	}
    if(GetPVarInt(playerid, #CorpsEdit))
	{
		Corpse_OnPlayerEdit(playerid, objectid, response, x, y, z, rz);
	}
	return 1;
}
forward OnPlayerUseValetStorage(playerid);
public OnPlayerUseValetStorage(playerid)
{
	new id;
	cache_get_value_name_int(0, "id", id);
	new vehicleid = GetVehicleLinkedID(id);

	if(vehicleid != INVALID_VEHICLE_ID)
	{

		if(IsVehicleOccupied(vehicleid) && GetVehicleDriver(vehicleid) != playerid)
        {
            SendClientMessage(playerid, COLOR_GREY, "This vehicle is occupied.");
        }
        else
        {
            new
				Float:health;

			GetVehicleHealth(vehicleid, health);

            if(health < 600.0)
            {
                SendClientMessage(playerid, COLOR_GREY, "This vehicle is too damaged to be despawned.");
            }
            else
            {
		        SendClientMessageEx(playerid, COLOR_AQUA, "Your {FF6347}%s{33CCFF} which is located in %s has been despawned.", GetVehicleName(vehicleid), GetVehicleZoneName(vehicleid));
				DespawnVehicle(vehicleid);
			}
		}
	}
	else
	{
	    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM vehicles WHERE id = %i AND ownerid = %i", id, PlayerInfo[playerid][pID]);
		mysql_tquery(connectionID, queryBuffer, "OnPlayerUseValletSystem", "ii", playerid, false);
	}
}
forward OnPlayerUseValletSystem(playerid, parked);
public OnPlayerUseValletSystem(playerid, parked)
{
	if(!cache_num_rows())
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "The slot specified contains no valid vehicle which you can spawn.");
	}
	else
	{
	    new id, impounded;
	    cache_get_value_name_int(0, "id", id);
	    cache_get_value_name_int(0, "impounded", impounded);
        for(new i = 0; i < MAX_VEHICLES; i ++)
	    {
	        if(IsValidVehicle(i) && VehicleInfo[i][vID] == id)
	        {
	            return SendClientMessage(playerid, COLOR_SYNTAX, "This vehicle is spawned already. /findcar to track it.");
	    	}
	    }
	    if(impounded)
		{
			return SendClientMessage(playerid, COLOR_SYNTAX, "This vehicle is impounded. You can release it from the DMV. (/locate > General Location > DMV)");
		}
	    new
			modelid,
			Float:x,
			Float:y,
			Float:z,
			Float:a,
			color1,
			color2,
			vehicleid;
	    cache_get_value_name_int(0, "modelid", modelid);
	    cache_get_value_name_float(0, "pos_x", x);
	    cache_get_value_name_float(0, "pos_y", y);
	    cache_get_value_name_float(0, "pos_z", z);
	    cache_get_value_name_float(0, "pos_a", a);
	    cache_get_value_name_int(0, "color1", color1);
	    cache_get_value_name_int(0, "color2", color2);

		vehicleid = CreateVehicle(modelid, x, y, z, a, color1, color2, -1);
		GetPlayerPos(playerid, x, y, z);
		SetVehiclePos(vehicleid, x + 1, y + 1, z + 2.0);
		PutPlayerInVehicle(playerid, vehicleid, 0);


		if(vehicleid != INVALID_VEHICLE_ID)
		{
		    ResetVehicle(vehicleid);

		    cache_get_value_name(0, "owner", VehicleInfo[vehicleid][vOwner], MAX_PLAYER_NAME);
		    cache_get_value_name(0, "plate", VehicleInfo[vehicleid][vPlate], 32);

		    cache_get_value_name_int(0, "id", VehicleInfo[vehicleid][vID]);
		    cache_get_value_name_int(0, "ownerid", VehicleInfo[vehicleid][vOwnerID]);
			cache_get_value_name_int(0, "ogowner", VehicleInfo[vehicleid][vOgowner]);
		    cache_get_value_name_int(0, "price", VehicleInfo[vehicleid][vPrice]);
		    cache_get_value_name_int(0, "tickets", VehicleInfo[vehicleid][vTickets]);
		    cache_get_value_name_int(0, "locked", VehicleInfo[vehicleid][vLocked]);
		    cache_get_value_name_float(0, "health", VehicleInfo[vehicleid][vHealth]);
		    cache_get_value_name_int(0, "paintjob", VehicleInfo[vehicleid][vPaintjob]);
		    cache_get_value_name_int(0, "interior", VehicleInfo[vehicleid][vInterior]);
	        cache_get_value_name_int(0, "world", VehicleInfo[vehicleid][vWorld]);
	        cache_get_value_name_int(0, "neon", VehicleInfo[vehicleid][vNeon]);
	        cache_get_value_name_int(0, "neonenabled", VehicleInfo[vehicleid][vNeonEnabled]);
	        cache_get_value_name_int(0, "trunk", VehicleInfo[vehicleid][vTrunk]);
	        cache_get_value_name_int(0, "mod_1", VehicleInfo[vehicleid][vMods][0]);
	        cache_get_value_name_int(0, "mod_2", VehicleInfo[vehicleid][vMods][1]);
	        cache_get_value_name_int(0, "mod_3", VehicleInfo[vehicleid][vMods][2]);
	        cache_get_value_name_int(0, "mod_4", VehicleInfo[vehicleid][vMods][3]);
	        cache_get_value_name_int(0, "mod_5", VehicleInfo[vehicleid][vMods][4]);
	        cache_get_value_name_int(0, "mod_6", VehicleInfo[vehicleid][vMods][5]);
	        cache_get_value_name_int(0, "mod_7", VehicleInfo[vehicleid][vMods][6]);
	        cache_get_value_name_int(0, "mod_8", VehicleInfo[vehicleid][vMods][7]);
	        cache_get_value_name_int(0, "mod_9", VehicleInfo[vehicleid][vMods][8]);
	        cache_get_value_name_int(0, "mod_10", VehicleInfo[vehicleid][vMods][9]);
	        cache_get_value_name_int(0, "mod_11", VehicleInfo[vehicleid][vMods][10]);
	        cache_get_value_name_int(0, "mod_12", VehicleInfo[vehicleid][vMods][11]);
	        cache_get_value_name_int(0, "mod_13", VehicleInfo[vehicleid][vMods][12]);
	        cache_get_value_name_int(0, "mod_14", VehicleInfo[vehicleid][vMods][13]);
	        cache_get_value_name_int(0, "cash", VehicleInfo[vehicleid][vCash]);
	        cache_get_value_name_int(0, "materials", VehicleInfo[vehicleid][vMaterials]);
			cache_get_value_name_int(0, "ore", VehicleInfo[vehicleid][vOre]);
			cache_get_value_name_int(0, "metals", VehicleInfo[vehicleid][vMetalCapacity]);
			cache_get_value_name_int(0, "copper", VehicleInfo[vehicleid][vCopper]);
			cache_get_value_name_int(0, "iorn", VehicleInfo[vehicleid][vIorn]);
			cache_get_value_name_int(0, "gold", VehicleInfo[vehicleid][vGold]);
			cache_get_value_name_int(0, "diamond", VehicleInfo[vehicleid][vDiamond]);
	        cache_get_value_name_int(0, "pot", VehicleInfo[vehicleid][vPot]);
	        cache_get_value_name_int(0, "crack", VehicleInfo[vehicleid][vCrack]);
	        cache_get_value_name_int(0, "meth", VehicleInfo[vehicleid][vMeth]);
	        cache_get_value_name_int(0, "painkillers", VehicleInfo[vehicleid][vPainkillers]);
	        cache_get_value_name_int(0, "weapon_1", VehicleInfo[vehicleid][vWeapons][0]);
	        cache_get_value_name_int(0, "weapon_2", VehicleInfo[vehicleid][vWeapons][1]);
	        cache_get_value_name_int(0, "weapon_3", VehicleInfo[vehicleid][vWeapons][2]);
			cache_get_value_name_int(0, "weapon_4", VehicleInfo[vehicleid][vWeapons][3]);
			cache_get_value_name_int(0, "weapon_5", VehicleInfo[vehicleid][vWeapons][4]);
			cache_get_value_name_int(0, "hpammo", VehicleInfo[vehicleid][vHPAmmo]);
            cache_get_value_name_int(0, "poisonammo", VehicleInfo[vehicleid][vPoisonAmmo]);
            cache_get_value_name_int(0, "fmjammo", VehicleInfo[vehicleid][vFMJAmmo]);
		    cache_get_value_name_int(0, "rent", VehicleInfo[vehicleid][vRent]);
            cache_get_value_name_int(0, "renttime", VehicleInfo[vehicleid][vRenttime]);
	        VehicleInfo[vehicleid][vGang] = -1;
			VehicleInfo[vehicleid][vVip] = 0;
	        VehicleInfo[vehicleid][vFactionType] = FACTION_NONE;
	        VehicleInfo[vehicleid][vJob] = JOB_NONE;
	        VehicleInfo[vehicleid][vRespawnDelay] = -1;
	        VehicleInfo[vehicleid][vModel] = modelid;
		    VehicleInfo[vehicleid][vPosX] = x;
		    VehicleInfo[vehicleid][vPosY] = y;
		    VehicleInfo[vehicleid][vPosZ] = z;
		    VehicleInfo[vehicleid][vPosA] = a;
		    VehicleInfo[vehicleid][vColor1] = color1;
		    VehicleInfo[vehicleid][vColor2] = color2;
		    VehicleInfo[vehicleid][vObjects][0] = INVALID_OBJECT_ID;
		    VehicleInfo[vehicleid][vObjects][1] = INVALID_OBJECT_ID;
		    VehicleInfo[vehicleid][vTimer] = -1;
		    cache_get_value_name_int(0, "registered", VehicleInfo[vehicleid][vRegistered]);

			cache_get_value_name_int(0, "fuel", VehicleInfo[vehicleid][vFuel]);
			SetVehicleFuelLevel(vehicleid, VehicleInfo[vehicleid][vFuel]);
			adminVehicle{vehicleid} = false;

			ReloadVehicle(vehicleid);

		    if(!parked)
			{
			    SM(playerid, COLOR_GREEN, "DURP BANK : $2500 payed for the valet service of your vehicle %s", GetVehicleName(vehicleid));
			}
	    }
	}

	return 1;
}

forward OnTopPlayersLoaded(playerid, listtype);
public OnTopPlayersLoaded(playerid, listtype)
{
	if(!IsPlayerConnected(playerid))
	{
		return 1;
	}

	new rows = cache_num_rows();
	new name[MAX_PLAYER_NAME], score, line[96], content[2048], title[64];

	for(new i = 0; i < rows; ++i)
	{
		cache_get_value_name(i, "username", name);
		cache_get_value_name_int(i, "score", score);

		switch(listtype)
		{
			case 0: format(line, sizeof(line), "%s\t%d Crimes\n", name, score);
			case 1: format(line, sizeof(line), "%s\t$%d\n", name, score);
			case 2: format(line, sizeof(line), "%s\t%d Playing Hours\n", name, score);
		}
		strcat(content, line, sizeof(content));
	}

	switch(listtype)
	{
		case 0: format(title, sizeof(title), "Top Crimes");
		case 1: format(title, sizeof(title), "Top Bank Balances");
		case 2: format(title, sizeof(title), "Top Playing Hours");
	}

	if(!rows)
	{
		format(content, sizeof(content), "No records found.");
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST, title, content, "Okay", "");
	return 1;
}


public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(PlayerInfo[playerid][pKicked]) return 0;
	// This is a fix to a known exploit where inserting '%' in the dialog box would crash the server.
	for(new i = 0, l = strlen(inputtext); i < l; i ++)
	{
	    if(inputtext[i] == '%') inputtext[i] = '#';
	}
	switch(dialogid)
	{
		case DIALOG_WF_WEAPON:
		{
			if(!response) return 1;
			WeaponFactoryPlayer[playerid][wfpWeapon] = (listitem == 0) ? FACTORY_WEAPON_DEAGLE : FACTORY_WEAPON_M4;
			ShowPlayerDialog(playerid, DIALOG_WF_AMOUNT, DIALOG_STYLE_LIST, "Select Manufacturing Quantity", "15 Weapons\n30 Weapons\n50 Weapons\n75 Weapons", "Select", "Back");
			return 1;
		}
		case DIALOG_WF_AMOUNT:
		{
			if(!response)
			{
				ShowPlayerDialog(playerid, DIALOG_WF_WEAPON, DIALOG_STYLE_LIST, "Select Weapon", "Desert Eagle\nM4 Rifle", "Select", "Cancel");
				return 1;
			}
			new amounts[] = {15, 30, 50, 75};
			WeaponFactoryPlayer[playerid][wfpAmount] = amounts[listitem];
			return FactoryShowConfirmDialog(playerid);
		}
		case DIALOG_WF_CONFIRM:
		{
			if(!response) return 1;
			return FactoryStartInitialization(playerid);
		}
		case DIALOG_WF_LOCKER:
		{
			if(!response) return 1;
			if(listitem == 2) return FactoryShowLocker(playerid);
			WeaponFactoryPlayer[playerid][wfpWithdrawWeapon] = (listitem == 0) ? FACTORY_WEAPON_M4 : FACTORY_WEAPON_DEAGLE;
			ShowPlayerDialog(playerid, DIALOG_WF_WITHDRAW_AMOUNT, DIALOG_STYLE_INPUT, "Withdraw Weapon", "Enter amount to withdraw:", "Withdraw", "Cancel");
			return 1;
		}
		case DIALOG_WF_WITHDRAW_AMOUNT:
		{
			if(!response) return 1;
			new amount = strval(inputtext);
			return FactoryWithdrawWeapon(playerid, amount);
		}
		case DIALOG_WF_REPAIR:
		{
			if(!response) return 1;
			return FactoryDoRepair(playerid);
		}
		case DIALOG_WF_INFO:
		{
			return 1;
		}
	}
	if(dialogid != DIALOG_REGISTER && dialogid != DIALOG_CONFIRMPASS && dialogid != DIALOG_LOGIN && dialogid != DIALOG_CHANGEPASS)
	{
	    new dcDialogLog[256];
	    if(inputtext[0] != EOS)
	    {
	        format(dcDialogLog, sizeof(dcDialogLog), "[dialog] %s (uid: %i) dialogid: %i response: %i listitem: %i input: %s", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], dialogid, response, listitem, inputtext);
	    }
	    else
	    {
	        format(dcDialogLog, sizeof(dcDialogLog), "[dialog] %s (uid: %i) dialogid: %i response: %i listitem: %i", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], dialogid, response, listitem);
	    }
	    SendDiscordMessage(34, dcDialogLog);
	}
	if(dialogid == DIALOG_VALETSTORAGE)
    {
       if(response)
       {
		  if(listitem != -1)
		  {
				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id FROM vehicles WHERE ownerid = %i LIMIT %i, 1", PlayerInfo[playerid][pID], listitem);
                mysql_tquery(connectionID, queryBuffer, "OnPlayerUseValetStorage", "i", playerid);
		  }

       }
	   return 1;
    }
	if(dialogid == INVENTORY_PICKUP)
	{
		if(response)
		{
			new itemid = NearestItems[playerid][listitem];
			PickupItem(playerid, itemid);
		}
	}
	if(dialogid == LOAD_DIALOG)
	{
		if(response)
		{
			new
				loadCost,
				loadAmount,
				loadDuration,
				remaining,
				days,
				hours,
				minutes,
				string[512];

			// =========================================
			// CHECK ACTIVE RECHARGE
			// =========================================

			if(PlayerInfo[playerid][pLoad] > 0 && PlayerInfo[playerid][pLoadExpiry] > gettime())
			{
				remaining = PlayerInfo[playerid][pLoadExpiry] - gettime();

				days = remaining / 86400;
				hours = (remaining % 86400) / 3600;
				minutes = ((remaining % 86400) % 3600) / 60;

				format(string, sizeof(string),
				"{FF0000}You already have an active recharge pack.\n\n\
	{FFFFFF}Current Load: {32CD32}%d Calls\n\
	{FFFFFF}Expires In: {FFD700}%d Days %d Hours %d Minutes",
				PlayerInfo[playerid][pLoad],
				days,
				hours,
				minutes);

				ShowPlayerDialog(playerid, 9998, DIALOG_STYLE_MSGBOX,
				"Recharge Already Active",
				string,
				"Close",
				"");

				return 1;
			}

			switch(listitem)
			{
				case 0:
				{
					loadCost = 500;
					loadAmount = 20;
					loadDuration = 1;
				}

				case 1:
				{
					loadCost = 1500;
					loadAmount = 40;
					loadDuration = 3;
				}

				case 2:
				{
					loadCost = 3000;
					loadAmount = 70;
					loadDuration = 7;
				}

				case 3:
				{
					loadCost = 5000;
					loadAmount = 150;
					loadDuration = 15;
				}

				case 4:
				{
					loadCost = 10000;
					loadAmount = 300;
					loadDuration = 30;
				}
			}

			if(PlayerInfo[playerid][pCash] < loadCost)
			{
				return SendClientMessage(playerid, COLOR_RED, "[MOBSHOP] {FFFFFF}You don't have enough money to purchase this recharge pack.");
			}

			PlayerInfo[playerid][pLoad] = loadAmount;
			PlayerInfo[playerid][pLoadExpiry] = gettime() + (loadDuration * 86400);

			GivePlayerMoney(playerid, -loadCost);

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
			"UPDATE users SET `load` = %d, `loadtime` = %d, `sim` = %d WHERE uid = %d",
			PlayerInfo[playerid][pLoad],
			PlayerInfo[playerid][pLoadExpiry],
			PlayerInfo[playerid][pSIM],
			PlayerInfo[playerid][pID]);

			mysql_tquery(connectionID, queryBuffer);

			format(string, sizeof(string),
			"{32CD32}Recharge Pack Purchased Successfully!\n\n\
	{FFFFFF}Calls Added: {32CD32}%d\n\
	{FFFFFF}Validity: {00BFFF}%d Day(s)\n\
	{FFFFFF}Cost: {FFD700}$%d",
			loadAmount,
			loadDuration,
			loadCost);

			ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_MSGBOX,
			"Recharge Successful",
			string,
			"Close",
			"");

			return 1;
		}

		return 1;
	}
	if(dialogid == DIALOG_RADIOCHAT)
	{
		if(response)
		{
			if(listitem == 0)
			{
				if(PlayerInfo[playerid][pFaction] == -1)
				{
					return SendClientMessage(playerid, COLOR_SYNTAX, "You can't use this command as you're not apart of any faction.");
				}
				if(PlayerInfo[playerid][pFactionRadio] == 0)
				{
					PlayerInfo[playerid][pFactionRadio] = 1;

					CallRemoteFunction("JoinFgVoiceChannel", "iii", PlayerInfo[playerid][pFaction], playerid, 1);
					callcmd::radiochat(playerid);
					SetPVarInt(playerid,"radiostat",1);
					SM(playerid, COLOR_GREY, "Succesfuly connected to %s radio channel.", FactionInfo[PlayerInfo[playerid][pFaction]][fName]);
				}
				else if(PlayerInfo[playerid][pFactionRadio] == 1)
				{
					PlayerInfo[playerid][pFactionRadio] = 0;
					CallRemoteFunction("LeaveFgVoiceChannel", "ii", playerid, 1);
					callcmd::radiochat(playerid);
					SetPVarInt(playerid,"radiostat",0);
					SM(playerid, COLOR_GREY, "You have disconnected on %s radio channel.", FactionInfo[PlayerInfo[playerid][pFaction]][fName]);
				}
			}
			if(listitem == 1)
			{
				if(PlayerInfo[playerid][pGang] == -1)
			    {
			        return SendClientMessage(playerid, COLOR_SYNTAX, "You are not apart of any gang at the moment.");
				}
				if(PlayerInfo[playerid][pGangRadio] == 0)
				{
					PlayerInfo[playerid][pGangRadio] = 1;
					CallRemoteFunction("JoinFgVoiceChannel", "iii", PlayerInfo[playerid][pGang] , playerid, 0);
					callcmd::radiochat(playerid);
					SetPVarInt(playerid,"radiostat",2);
					SM(playerid, COLOR_GREY, "Succesfuly connected to %s radio channel.", GangInfo[PlayerInfo[playerid][pGang]][gName]);
				}
				else if(PlayerInfo[playerid][pGangRadio] == 1)
				{
					PlayerInfo[playerid][pGangRadio] = 0;
					CallRemoteFunction("LeaveFgVoiceChannel", "ii", playerid, 0);
					callcmd::radiochat(playerid);
					SetPVarInt(playerid,"radiostat",0);
					SM(playerid, COLOR_GREY, "You have disconnected on %s radio channel.", GangInfo[PlayerInfo[playerid][pGang]][gName]);
				}
			}
		}
	}
	if(dialogid == DIALOG_RADIO)
	{
		if(response)
		{
			if(listitem == 0)
			{

				if(PlayerInfo[playerid][pRadioUse] == 0)
				{
					PlayerInfo[playerid][pRadioUse] = 1;

					SetPVarInt(playerid,"talkStats",3);
					SM(playerid, COLOR_GREY, "Succesfuly connected to Public radio channel. /frequency or /fq");
				}
				else
				{
					PlayerInfo[playerid][pRadioUse] = 0;
				    SetPVarInt(playerid,"talkStats",0);
					CallRemoteFunction("LeaveGroupVoiceChannel", "i", playerid);
                    isUsingRadioVoip[playerid] = false;
					SM(playerid, COLOR_GREY, "You have disconnected on public radio channel.");
				}
			}

		}
	}
   	if(dialogid == CorpseInfo)
	{
		if (!response)	return 1;

	    new dlg[90], i = GetNearestCorpse(playerid);

	    switch(CorpInfo[i][cType]) {
	        case 0: {//??????? = 0
	            dlg="Drag into vehicle\nPut in a bag\nBury";
	        }
	        case 1: { //???????
	            dlg="Remove the corpse from the wheelchair";
	        }
	        case 2: { //????? ?????
	            dlg="Drag into vehicle\nGet the corpse out of the bag";
	        }
	        case 3:{ //??????????
	            dlg="Unearth a corpse";
	        }
	    }

	    if (!CorpInfo[i][cType] && PlayerInfo[playerid][pDuty] == 1 && (GetFactionType(playerid) == FACTION_MEDIC))
	        strcat(dlg,"\nPut on a gurney");

	    if (PlayerInfo[playerid][pAdmin] || (PlayerInfo[playerid][pDuty] == 1 && (GetFactionType(playerid) == FACTION_MEDIC)))
	        strcat(dlg,"\nRemove corpse object");

	    ShowPlayerDialog(playerid, CorpseInfo2, DIALOG_STYLE_LIST, "Dead body", dlg, "Select", "Return");
	    return 1;
	}
	if(dialogid == CorpseInfo2)
	{
		if (!response)	return callcmd::corpse(playerid);

	    if(PlayerInfo[playerid][pTazedTime] > 0 || PlayerInfo[playerid][pInjured] > 0 || PlayerInfo[playerid][pHospital] > 0 || PlayerInfo[playerid][pTied] > 0 || PlayerInfo[playerid][pCuffed] > 0 || PlayerInfo[playerid][pJailTime] > 0 || PlayerInfo[playerid][pJoinedEvent] > 0)
		{
		    return SendClientMessage(playerid, COLOR_SYNTAX, "You can't use this command at the moment.");
		}

	    if(!PlayerInfo[playerid][pLogged])
		{
		    return SendClientMessage(playerid, COLOR_GREY, "You are not logged in yet.");
		}

		new i = GetNearestCorpse(playerid);

	    switch(listitem) {
	        case 0: {
	            switch(CorpInfo[i][cType]) {
	                case 0: listitem=0;
	                case 1: listitem=1;
	                case 2: listitem=0;
	                case 3: listitem=2;
	            }
	        }
	        case 1: {
	            switch(CorpInfo[i][cType]) {
	                case 0: listitem=5;
	                case 1: listitem=7;
	                case 2: listitem=2;
	                case 3: listitem=7;
	            }
	        }
	        case 2: {
	            switch(CorpInfo[i][cType]) {
	                case 0: listitem=6;
	                case 2: listitem=7;
	            }
	        }
	        case 3: listitem=4;
	        case 4: listitem=7;
	    }

	    switch(listitem)
	    {
	        case 0:
	        {
	            new vehicle = GetNearbyVehicle(playerid);
	            if (vehicle == -1)                         return SendClientMessage(playerid, COLOR_GRAD1, "You are not near vehicle.");
	            if (!IsNearTrunk(vehicle, playerid, 2.0))  return SendClientMessage(playerid, COLOR_GRAD1, "You are not near the trunk! ");
	            new engine, lights, alarm, doors, bonnet, boot, objective;
		        GetVehicleParamsEx(vehicle, engine, lights, alarm, doors, bonnet, boot, objective);

		        if(boot == VEHICLE_PARAMS_OFF || boot == VEHICLE_PARAMS_UNSET)
		        {
		            SendClientMessageEx(playerid, COLOR_GRAD2, "The vehicle's trunk must be opened to load corpse.");
		            return 1;
		        }

	            if (VehicleInfo[vehicle][vCorp] > 0 && CorpInfo[VehicleInfo[vehicle][vCorp]][cUsed] == 1)
	                return SendClientMessage(playerid, COLOR_GRAD1, "There is already a corpse in the trunk!");

	            new mes[128];
	            format(mes, sizeof(mes), "drags a corpse %s in the trunk.", CorpInfo[i][cName]);
	            callcmd::me(playerid, mes);

	            SendClientMessage(playerid, COLOR_GRAD1, "You put your body in the trunk. (( /car corpse - to pull out ))");

	            CorpInfo[i][cTime] = gettime();
	            CorpInfo[i][cVeh]=vehicle;
	            VehicleInfo[vehicle][vCorp]=i+1;

	            CorpInfo[i][cX] =
	            CorpInfo[i][cY] =
	            CorpInfo[i][cZ] = 0.0;


	            DestroyDynamic3DTextLabel(CorpInfo[i][cText]);
	            if (!CorpInfo[i][cType] && IsValidActor(CorpInfo[i][cBody])) DestroyActor(CorpInfo[i][cBody]);
	            else if (CorpInfo[i][cType] && IsValidDynamicObject(CorpInfo[i][cBody])) DestroyDynamicObject(CorpInfo[i][cBody]);
	        }
	        case 1: {
	            new Float:x, Float:y, Float:z;
	            GetPlayerPos(playerid, x, y, z);

	            CorpInfo[i][cType] = 0;
	            CorpInfo[i][cX] = x+0.75;
	            CorpInfo[i][cY] = y;
	            CorpInfo[i][cZ] = z-0.5;
	            CorpInfo[i][cTime] = gettime();

	            CorpInfo[i][cText]=CreateDynamic3DTextLabel("(( DEAD BODY ))\npress '~k~~GROUP_CONTROL_BWD~'", COLOR_LIGHTRED, CorpInfo[i][cX], CorpInfo[i][cY], CorpInfo[i][cZ]-0.5, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 50.0);

	            pTemp[playerid][UsingCorpse] = 0;

	            SetActorPos(CorpInfo[i][cBody], CorpInfo[i][cX], CorpInfo[i][cY], CorpInfo[i][cZ]);
	            SendClientMessage(playerid, COLOR_GRAD1, "You removed the body from the wheelchair.");
	        }
	        case 2: {
	            if (IsValidDynamicObject(CorpInfo[i][cBody]))        DestroyDynamicObject(CorpInfo[i][cBody]);
	            if (IsValidDynamic3DTextLabel(CorpInfo[i][cText]))   DestroyDynamic3DTextLabel(CorpInfo[i][cText]);

	            new Float:x, Float:y, Float:z;
	            GetPlayerPos(playerid, x, y, z);

	            CorpInfo[i][cType] = 0;
	            CorpInfo[i][cX] = x+0.75;
	            CorpInfo[i][cY] = y;
	            CorpInfo[i][cZ] = z-0.5;
	            CorpInfo[i][cTime] = gettime();

	            CorpInfo[i][cBody]=CreateActor(CorpInfo[i][cSkin], x+0.75-0.5, y, z, 0.0);
	            SetActorInvulnerable(CorpInfo[i][cBody], true);
	            ApplyActorAnimation(CorpInfo[i][cBody], "PED", "KO_shot_stom", 4.0, false, false, false, true, false);

	            CorpInfo[i][cText]=CreateDynamic3DTextLabel("(( DEAD BODY ))\npress '~k~~GROUP_CONTROL_BWD~'", COLOR_LIGHTRED, CorpInfo[i][cX], CorpInfo[i][cY], CorpInfo[i][cZ]-0.5, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 50.0);

	            if (CorpInfo[i][cType] == 3) SendClientMessage(playerid, COLOR_GRAD1, "You have unearthed the body.");
	            else                        SendClientMessage(playerid, COLOR_GRAD1, "You got the body out of the bag.");
	        }
	        case 4:
	        {
	            if (!pTemp[playerid][UsingBort])  return SendClientMessage(playerid, COLOR_GRAD1, "Take the wheelchair first! (/stretcher)");
	            if (pTemp[playerid][UsingCorpse]) return SendClientMessage(playerid, COLOR_GRAD1, "You already have a body on a gurney!");

	            if (IsValidDynamic3DTextLabel(CorpInfo[i][cText]))   DestroyDynamic3DTextLabel(CorpInfo[i][cText]);

	            pTemp[playerid][UsingCorpse] = i;
	            CorpInfo[i][cType] = 1;

	            SendClientMessage(playerid, COLOR_GRAD1, "You put the body on a wheelchair.");
	        }
	        case 5:
	        {
	            if (PlayerInfo[playerid][pBodyBag] == 0) return SendClientMessage(playerid, COLOR_GRAD1, "You don't have a body bag.");

	            new Float:posZs;
	            GetActorFacingAngle(CorpInfo[i][cBody], posZs);

	            if (IsValidActor(CorpInfo[i][cBody]))  DestroyActor(CorpInfo[i][cBody]);

	            SetPVarInt(playerid, #CorpsEdit, i+1);

	            CorpInfo[i][cType] = 2;
	            CorpInfo[i][cBody]=CreateDynamicObject(19944, CorpInfo[i][cX], CorpInfo[i][cY], CorpInfo[i][cZ]-0.5, 0.0, 0.0, posZs, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));

	            EditDynamicObject(playerid, CorpInfo[i][cBody]);

	            SM(playerid, COLOR_GRAD1, "You put the body in a bag. [ID:%i]", i);
				new mes[128];
	            format(mes, sizeof(mes), "packs the body in a bag.");
	            callcmd::me(playerid, mes);
	        }
	        case 6:
	        {
	            if (GetPlayerVirtualWorld(playerid) || GetPlayerInterior(playerid)) return SendClientMessage(playerid, COLOR_GRAD1, "You cannot bury a body here!");
	            new weaponid = GetScriptWeapon(playerid);
	            if(weaponid != 6) return SendClientMessage(playerid, COLOR_GRAD1, "The shovel should be in hand!");

	            new Float:posZs;
	            GetActorFacingAngle(CorpInfo[i][cBody], posZs);

	            if (IsValidActor(CorpInfo[i][cBody]))  DestroyActor(CorpInfo[i][cBody]);
	            if (IsValidDynamicObject(CorpInfo[i][cBody]))  DestroyDynamicObject(CorpInfo[i][cBody]);

	            SetPVarInt(playerid, #CorpsEdit, i+1);

	            CorpInfo[i][cType] = 3;
	            CorpInfo[i][cBody]=CreateDynamicObject(19944 , CorpInfo[i][cX], CorpInfo[i][cY], CorpInfo[i][cZ]-0.5, 0.0, 0.0, posZs, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	            SetObjectMaterial(CorpInfo[i][cBody], 0, 10101, "2notherbuildsfe", "Bow_Abpave_Gen", 0x00000000);

	            EditDynamicObject(playerid, CorpInfo[i][cBody]);

	            SM(playerid, COLOR_GRAD1, "You buried the corpse. [ID:%i]", i);
				new mes[128];
	            format(mes, sizeof(mes), "buries the corpse.");
	            callcmd::me(playerid, mes);
	        }
	        case 7:
	        {
	            SM(playerid, COLOR_GRAD1, "You have deleted the corpse object. [ID:%i]", i);
	            RemoveCorpse(i);
	            return 1;
	        }
	    }
	}
	if(dialogid == DIALOG_AMOUNT)
	{
		if (response)
		{
			new str[125];

			PlayerInfo[playerid][pGiveAmount] = strval(inputtext);
			format(str, sizeof(str), "%d", strval(inputtext));
			DynamicPlayerTextDrawSetString(playerid, INVINFO[playerid][6], str);
		}
	}
	if(dialogid == ANTICHEAT_SETTINGS)
	{
		if(!response)
	    {
	        pAntiCheatSettingsPage{playerid} = 0;
	        return 1; // ????????? ??????
	    }

	    if (!strcmp(inputtext, AC_DIALOG_NEXT_PAGE_TEXT))
	    {
	        pAntiCheatSettingsPage{playerid}++;
	    }
	    else if (!strcmp(inputtext, AC_DIALOG_PREVIOUS_PAGE_TEXT))
	    {
	        pAntiCheatSettingsPage{playerid}--;
	    }
	    else // ???? ????? ?????? ?????-???? ?? ????? ????-????
	    {
	        pAntiCheatSettingsEditCodeId[playerid] = pAntiCheatSettingsMenuListData[playerid][listitem];
	        return ShowPlayer_AntiCheatEditCode(playerid, pAntiCheatSettingsEditCodeId[playerid]);
	    }
	    return ShowPlayer_AntiCheatSettings(playerid);
	}
	if(dialogid == ANTICHEAT_EDIT_CODE)
	{
		if (!response) // ???? ????? ?????? ??????
	    {
	        pAntiCheatSettingsEditCodeId[playerid] = -1;
	        return ShowPlayer_AntiCheatSettings(playerid);
	    }

	    new
	        item = pAntiCheatSettingsEditCodeId[playerid];

	    if (AC_CODE_TRIGGER_TYPE[item] == listitem)
	        return ShowPlayer_AntiCheatSettings(playerid);

	    if (AC_CODE_TRIGGER_TYPE[item] == AC_CODE_TRIGGER_TYPE_DISABLED && listitem != AC_CODE_TRIGGER_TYPE_DISABLED)
	        EnableAntiCheat(item, 1);

	    AC_CODE_TRIGGER_TYPE[item] = listitem;

	    new
	        sql_query[101 - 4 + 1 + 2];

	    format(sql_query, sizeof(sql_query), "UPDATE "AC_TABLE_SETTINGS" SET `"AC_TABLE_FIELD_TRIGGER"` = '%d' WHERE `"AC_TABLE_FIELD_CODE"` = '%d'",
	        listitem,
	        item);

	    mysql_tquery(connectionID, sql_query); // ?????????? ?????? ? ???? ??????
	    return ShowPlayer_AntiCheatSettings(playerid); // ?????????? ??????? ???? ???????? ????-????
	}
 	if(dialogid == DIALOG_GIVE)
	{
		if (response)
		{
  			new p2 = GetPlayerListitemValue(playerid, listitem);
			new itemid = PlayerInfo[playerid][pSelectItem];
			new value = PlayerInfo[playerid][pGiveAmount];

            if (strlen(InventoryData[playerid][itemid][invItem]) == 0)
            {
               printf("Error: InventoryData for playerid (%d) and itemid (%d) is an empty string", playerid, itemid);
               return 0;
            }


            OnPlayerGiveInvItem(playerid, p2, itemid, InventoryData[playerid][itemid][invItem], value);
		}
	}
	if(dialogid == DIALOG_METH_QUESTION_1)
	{
		if(response)
		{
			if(listitem == 0)
			{
				PlayerInfo[playerid][pMethScore] ++;
 			}
	 		GameTextForPlayer(playerid, "~g~COOKING", 1000, 5);
		}
	}
	if(dialogid == DIALOG_METH_QUESTION_2)
	{
		if(response)
		{
			if(listitem == 1)
			{
				PlayerInfo[playerid][pMethScore] ++;
  			}
	  		GameTextForPlayer(playerid, "~g~COOKING", 1000, 5);
		}
	}
	if(dialogid == DIALOG_METH_QUESTION_3)
	{
		if(response)
		{
		    GameTextForPlayer(playerid, "~g~COOKING", 1000, 5);
			if(listitem == 2)
			{
				PlayerInfo[playerid][pMethScore] ++;
			}
		}
	}
	if(dialogid == DIALOG_METH_QUESTION_4)
	{
		if(response)

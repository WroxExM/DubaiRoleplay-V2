		case DIALOG_BANK_TRANSFER:
		{
			if(response)
			{
				new id;

				if(sscanf(inputtext, "u", id))
				{
					return ShowPlayerDialog(playerid, DIALOG_BANK_TRANSFER, DIALOG_STYLE_INPUT, "{3B82F6}OKOK Banking {FFFFFF}- Transfer", "{FFFFFF}Enter player ID or name.", "Select", "Cancel");
				}
				if(id == INVALID_PLAYER_ID || !IsPlayerConnected(id))
				{
					return SCMf(playerid, COLOR_GREY, "[OKOK BANKING] Player not connected.");
				}
				if(id == playerid)
				{
					return SCMf(playerid, COLOR_GREY, "[OKOK BANKING] You cannot transfer money to yourself.");
				}

				SetPVarInt(playerid, "transfer_id", id);

				ShowPlayerDialog(playerid, DIALOG_BANK_TRANSFER2, DIALOG_STYLE_INPUT, "{3B82F6}OKOK Banking {FFFFFF}- Amount", "{FFFFFF}Enter transfer amount.", "Transfer", "Cancel");
			}

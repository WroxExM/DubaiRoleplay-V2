public OnPlayerDisconnect(playerid, reason)
{
	if(PlayerInfo[playerid][pEquipVest] || PlayerInfo[playerid][pEquipHelmet])
	{
		KillTimer(PlayerInfo[playerid][pEquipTimer]);
		PlayerInfo[playerid][pEquipVest] = false;
		PlayerInfo[playerid][pEquipHelmet] = false;
		PlayerInfo[playerid][pEquipTimer] = -1;
	}

	StopTurfKillLogAnimators(playerid);
	TurfKillLogTDReady[playerid] = false;

	// Discord disconnect log embed
	if(PlayerConnectTick[playerid] > 0)
	{
		new dcHour, dcMinute, dcSecond, dcYear, dcMonth, dcDay;
		gettime(dcHour, dcMinute, dcSecond);
		getdate(dcYear, dcMonth, dcDay);

		// IST offset (UTC+5:30)
		dcMinute += 30;
		dcHour += 5;
		if(dcMinute >= 60) { dcMinute -= 60; dcHour++; }
		if(dcHour >= 24) { dcHour -= 24; dcDay++; }

		new period[] = "AM";
		new dispHour = dcHour;
		if(dispHour >= 12) { period = "PM"; if(dispHour > 12) dispHour -= 12; }
		if(dispHour == 0) dispHour = 12;

		new dcTime[16], dcDate[16];
		format(dcTime, sizeof(dcTime), "%02d:%02d:%02d %s IST", dispHour, dcMinute, dcSecond, period);
		format(dcDate, sizeof(dcDate), "%02d/%02d/%d", dcDay, dcMonth, dcYear);

		// Calculate session played
		new sessionSeconds = gettime() - PlayerConnectTick[playerid];
		new sessionHours = sessionSeconds / 3600;
		new sessionMinutes = (sessionSeconds % 3600) / 60;
		new sessionSecs = sessionSeconds % 60;

		new sessionStr[64];
		format(sessionStr, sizeof(sessionStr), "%d Hours %d Minutes %d Seconds", sessionHours, sessionMinutes, sessionSecs);

		new embedDescription[512];
		format(embedDescription, sizeof(embedDescription),
			"```ansi\nServer Disconnect Time : %s\nDisconnect Date       : %s\nConnection Username   : %s\nConnection IP         : %s\nSession Played        : %s\n```",
			dcTime, dcDate, GetPlayerNameEx(playerid), GetPlayerIP(playerid), sessionStr);

		if(g_DiscordConnectLog)
		{
			new DCC_Embed:embed = DCC_CreateEmbed("", embedDescription, "", "", 0xE74C3C, "Dubai Roleplay V2", "", "https://i.imgur.com/yourlogo.png", "");
			DCC_SendChannelEmbedMessage(g_DiscordConnectLog, embed);
		}
		else
		{
			SendDiscordMessage(17, embedDescription);
		}

		PlayerConnectTick[playerid] = 0;
	}

	if(WeaponFactoryPlayer[playerid][wfpCarrying])
	{
		FactoryDestroyCrate(WeaponFactoryPlayer[playerid][wfpCrate], 2);
		FactoryClearPlayerCarry(playerid);
	}
	WeaponFactoryPlayer[playerid][wfpFactory] = -1;
	ResetPointCardActivity(playerid);
	Tactical_OnPlayerDisconnect(playerid);
	PlayerWeaponLock[playerid] = false;
	PlayerWeaponLockMessageTick[playerid] = 0;
	PlayerLastWeapon[playerid] = WEAPON_FIST;
	PlayerNewbieWeaponUnlockTick[playerid] = 0;
	PlayerWeaponRestrictionTDShown[playerid] = false;
	AntiVDM_OnPlayerDisconnect(playerid, reason);
	ResetDealershipPlayer(playerid, true);
	if(gTurfPovHideTimer[playerid] != 0)
	{
		KillTimer(gTurfPovHideTimer[playerid]);
		gTurfPovHideTimer[playerid] = 0;
	}
	HideAdvancedTurfPov(playerid);
	RevokePLockerTarget(playerid);
	ClearPublicLockerAccess(playerid);
	CreateLeave(playerid, reason);
	TerminateInfo(playerid, reason);
    ResetCharacterSetup(playerid);
	
	for(new i = 0; i < 4; i ++)
	{
	    if(IsValidDynamicPickup(PlayerInfo[playerid][pZonePickups][i]))
	    {
			Streamer_SetIntData(STREAMER_TYPE_PICKUP, PlayerInfo[playerid][pZonePickups][i], E_STREAMER_WORLD_ID, 99999);
	        DestroyDynamicPickup(PlayerInfo[playerid][pZonePickups][i]);
	    }
	}
	if(PlayerFactionVeh[playerid] != INVALID_VEHICLE_ID)
    {
        if(IsValidVehicle(PlayerFactionVeh[playerid]))
        {
            DestroyVehicle(PlayerFactionVeh[playerid]);
        }
    }

	Player_Fire_Enabled[playerid] = false;
	Player_Key_Sprint_Time[playerid] = 0;
	if(PlayerInfo[playerid][pGangRadio] == 1)
	{
		CallRemoteFunction("LeaveFgVoiceChannel", "ii", playerid, 0);
	}
    if(PlayerInfo[playerid][pFactionRadio] == 1)
	{
		CallRemoteFunction("LeaveFgVoiceChannel", "ii", playerid, 1);
	}

	DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "IndiHome"));
	DeletePVar(playerid, "IndiHome");

	for(new i = 0; i < 13; i ++)
	{
	    PlayerTextDrawHide(playerid, HUNGERTD[playerid][i]);
	}

    CancelFuelLoading(playerid);
    FuelLoaded[playerid] = 0;
    FuelCheckpoint[playerid] = INVALID_FUELCP;


	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    if(!PlayerInfo[playerid][pLogged] && !PlayerIntroStarted[playerid])
    {
		PlayerIntroStarted[playerid] = true;
        ClearChat(playerid);
        for(new i = 0; i < 5; i ++)
        {
            SendClientMessage(playerid, -1, " ");
        }

        TogglePlayerSpectating(playerid, 1);
        SetPlayerColor(playerid, 0xFFFFFF00);

        SetTimerEx("IntroTimer9", 1500, false, "ii", playerid, PlayerTextDrawInitGeneration[playerid]);
        // Due to a SA-MP bug, you can't apply camera coordinates directly after enabling spectator mode (to hide HUD).
        // In this case, we'll use a timer to defer this action.
        //SetTimerEx("AnimationEntryPhases", 2000, false, "ii", playerid, 0);
        //SetTimerEx("AnimationEntryPhases", 3000, false, "ii", playerid, 1);
    }

    return 1;
}



public OnPlayerSpawn(playerid)
{
    if(PlayerInfo[playerid][pKicked]) return 0;

	if(PlayerInfo[playerid][pSetup])
	{
		Streamer_ApplyPlayerSettings(playerid);
		Streamer_QueueAreaRefreshes(playerid);
	}
	else
	{
		Streamer_WarmupPlayerArea(playerid);
	}

    if(!PlayerInfo[playerid][pPreloaded])
	{

		PreloadAnims(playerid);
	}

    if(PlayerInfo[playerid][pSetup])
    {
        if(PlayerInfo[playerid][pTutorial])
        {
            KillTimer(PlayerInfo[playerid][pTutorialTimer]);
            PlayerInfo[playerid][pTutorial] = 0;
        }

        TogglePlayerControllable(playerid, false);

        InsideTut[playerid] = 1;
        SetPlayerVirtualWorld(playerid, 0);
        TogglePlayerSpectating(playerid, false);
        InsideTut[playerid] = 1;


        SetPlayerVirtualWorld(playerid, playerid);


        SetFreezePos(playerid, 1822.430541, -1285.807983, 55.025260);
        SetPlayerFacingAngle(playerid, 353.16);
        ApplyAnimation(playerid, "SMOKING", "M_smkstnd_loop", 4.1, 1, 1, 1, 1, 0, 1);

		SetPlayerCameraPos(playerid, 1823.260375, -1273.091796, 54.906250);
		SetPlayerCameraLookAt(playerid, 1823.028564, -1280.230957, 55.027259);
        TogglePlayerControllable(playerid, 0);
		
        new string[44];

        format(string, sizeof(string), "%s", GetRPName(playerid));
        PlayerTextDrawSetString(playerid, SKINSETUP[playerid][24], string);

        format(string, sizeof(string), "%d", PlayerInfo[playerid][pAge]);
        PlayerTextDrawSetString(playerid, SKINSETUP[playerid][22], string);

        new gendertext[8];
        if(PlayerInfo[playerid][pGender] == 1)
        {
            format(gendertext, sizeof(gendertext), "Male");
        }
        else
        {
            format(gendertext, sizeof(gendertext), "Female");
        }
        PlayerTextDrawSetString(playerid, SKINSETUP[playerid][23], gendertext);

		for(new i = 0; i < 41; i++)
		{
			PlayerTextDrawShow(playerid, SKINSETUP[playerid][i]);
		}

		SelectTextDraw(playerid, COLOR_WHITE);
    }
	else if(PlayerInfo[playerid][pJailTime] > 0)
	{
	    SetPlayerInJail(playerid);
	    if(PlayerInfo[playerid][pJailType] == 2)
	    {
	        SM(playerid, COLOR_LIGHTRED, "** You were placed in admin prison by %s, reason: %s", PlayerInfo[playerid][pPrisonedBy], PlayerInfo[playerid][pPrisonReason]);
		}
		else
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "** You havent completed your jail sentence yet.");
		}
	}
	else if(PlayerInfo[playerid][pPaintball] > 0)
	{
	    SetPlayerInPaintball(playerid, PlayerInfo[playerid][pPaintball]);
	}
	else
	{
	    PlayerInfo[playerid][pJoinedEvent] = 0;

	    if(PlayerInfo[playerid][pInjured])
	    {
	        SetPlayerHealth(playerid, 100.0);
	        SetPlayerArmour(playerid, 0.0);

			if(gDeathPositionValid[playerid])
			{
				SetPlayerInterior(playerid, gDeathInterior[playerid]);
				SetPlayerVirtualWorld(playerid, gDeathWorld[playerid]);
				SetPlayerPos(playerid, gDeathPosition[playerid][0], gDeathPosition[playerid][1], gDeathPosition[playerid][2]);
				SetPlayerFacingAngle(playerid, gDeathPosition[playerid][3]);
			}
			else
			{
				SetPlayerInterior(playerid, PlayerInfo[playerid][pInterior]);
				SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pWorld]);
				SetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
				SetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);
			}

            ApplyAnimation(playerid, "SWEET", "SWEET_INJUREDLOOP", 4.1, true, false, false, true, 0, SYNC_OTHER);

	        SendClientMessage(playerid, COLOR_DOCTOR, "[!] >> You are badly injured.You can wait for and ambulance by entering '/call 911'");
	        SendClientMessage(playerid, COLOR_DOCTOR, "You have been Brutally Wounded, Now if a medic or somebody doesn't help you. you will die.");

			new string[128];
			format(string, sizeof(string), "(( Has been wounded ))");

			for(new i = 0; i < 39; i++)
			{
				PlayerTextDrawShow(playerid, DEATHTD[playerid][i]);
			}
            SelectTextDraw(playerid, COLOR_RED);

			killtimerz[playerid] = SetTimerEx("Dcstart", 1000, true, "i", playerid);
			TogglePlayerControllable(playerid, 0);
			if(!GetPVarInt(playerid, "TurfRevivePending"))
			{
				SetTimerEx("UnfreezeInjuredPlayer", 5000, false, "i", playerid);
			}

            if(PlayerInfo[playerid][pTagType] == TAG_MASK)
			{
			 	SetPlayerSpecialTag(playerid, TAG_NORMAL);
			}
		   	Maskara[playerid] = 0;
		   	MaskaraID[playerid] = 0;
	        PlayerInfo[playerid][pDeathCooldown] = 360;
	        PlayerInfo[playerid][pRevCooldown] = 30;
	    }
	    else if(PlayerInfo[playerid][pHospital])
	    {
	        if(PlayerInfo[playerid][pInsurance] == 0)
     	   		SetPlayerInHospital(playerid);
	        else
				SetPlayerInHospital(playerid, .type = PlayerInfo[playerid][pInsurance]);

			ResetPlayerWeaponsEx(playerid);
	    }
	    else
		{
		    SetPlayerHealth(playerid, PlayerInfo[playerid][pHealth]);
		    SetScriptArmour(playerid, PlayerInfo[playerid][pArmor]);

		    //SetTimerEx("DURP", 4000, false, "ii", playerid, 0);
		}

		if(!PlayerInfo[playerid][pHospital])
		{
		    if(PlayerInfo[playerid][pDueling] != INVALID_PLAYER_ID)
			{
				PlayerInfo[PlayerInfo[playerid][pDueling]][pDueling] = INVALID_PLAYER_ID;
				PlayerInfo[playerid][pDueling] = INVALID_PLAYER_ID;
			}
            if(PlayerInfo[playerid][pLastlog] == 0)
            {
			   SetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
               SetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);
			   SetPlayerWeapons(playerid);
			}
			SetPlayerWeapons(playerid);
			PlayerInfo[playerid][pLastlog] = 0;

		}
	}
	SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
	RefreshNewbieWeaponRestriction(playerid);
	PlayerLastWeapon[playerid] = GetPlayerWeapon(playerid);
	SetPlayerFightingStyle(playerid, PlayerInfo[playerid][pFightStyle]);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 998);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL, 998);
 	SetPlayerSkillLevel(playerid, WEAPONSKILL_SAWNOFF_SHOTGUN, 998);
	SetPlayerClothing(playerid);


	#if defined Christmas
    	PlayerTextDrawShow(playerid, EventTextdraw[playerid]);
	#endif

	// Dubai V2 Logo 
	for(new i = 0; i < 7; i++)
    {
        TextDrawShowForPlayer(playerid, DUBAIV2LOGO[i]);
    }
	for(new i = 0; i < 13; i ++)
	{
	    PlayerTextDrawShow(playerid, HUNGERTD[playerid][i]);
	}

	TextDrawShowForPlayer(playerid, TextdrawTD);
   	TextDrawShowForPlayer(playerid, Textdraw2);
	if(GetPVarInt(playerid, "TurfRevivePending") && PlayerInfo[playerid][pInjured])
	{
		TeleportPlayerFromTurf(playerid);
	}
	return 1;
}



#define CAMERA_LEFT 0
#define CAMERA_CENTER 1
#define CAMERA_RIGHT 2
public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
	new title[68], string[500], ip[32];
	GetPlayerIp(clickedplayerid, ip, 32);
    format(string, sizeof(string), "Report Player\nPrivate Message\n");
	if(PlayerInfo[playerid][pAdmin] >= 2)
	{
		format(string, sizeof(string), "%sKick Player\nBan Player\nSpectate Player\nBring Player\nGoto Player\nNewbie Mute Player\nFreeze Player\nUnfreeze Player\nSlap Player\nRevive Player\nCheck Player\nNon-Roleplay Name\nShow Rules\nCheck Player's Gun\nCheck Player's Vehicles\nBan Ip\n{00FF5C}IP Address: {FFFFFF}%s", string, ip);
	}
	SetPVarInt(playerid, "pClickedID", clickedplayerid);
	format(title, sizeof(title), "{00FF5C}"SERVER_NAME" Panel {FFFFFF}ID: %d", clickedplayerid);
	ShowPlayerDialog(playerid, DIALOG_PCP,DIALOG_STYLE_LIST,title,string,"Select","Cancel");
	return 1;
}
public OnClickDynamicTextDraw(playerid, Text:clickedid)
{

	if(clickedid == VEHICLEPANEL[6])
	{
		callcmd::engine(playerid);
		TogglePlayerControllable(playerid, 1);
	}
	if(clickedid == VEHICLEPANEL[7])
	{
		SCMf(playerid, COLOR_RED, "UNDER MAINTANANCE");
		TogglePlayerControllable(playerid, 1);
	}
	if(clickedid == VEHICLEPANEL[9])
	{
		ShowPlayerDialog(playerid, DIALOG_GIVEKEYS, DIALOG_STYLE_INPUT, "Give Vehicle Keys", "Enter Player ID:", "Give", "Close" );
		TogglePlayerControllable(playerid, 1);
	}
	if(clickedid == VEHICLEPANEL[8])
	{
		for(new x = 0; x < 20; x++)
		{
			TextDrawHideForPlayer(playerid, VEHICLEPANEL[x]);
		}
		CancelSelectTextDraw(playerid);
		TogglePlayerControllable(playerid, 1);
	}
		
	return 0;
}

// 26 farmer
// 38 oil 
// 50 construction
// 62 cleaner
// 74 electric tech
// 86 atm
// 92 close


public OnClickDynamicPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(gDrugFarmTDShown[playerid])
	{
		if(playertextid == TURFDRUGFARMINGTD[playerid][1]) return HideDrugFarmTD(playerid);
		if(playertextid == TURFDRUGFARMINGTD[playerid][3]) return DrugFarmMaintain(playerid, 0);
		if(playertextid == TURFDRUGFARMINGTD[playerid][4]) return DrugFarmMaintain(playerid, 1);
		if(playertextid == TURFDRUGFARMINGTD[playerid][7])
		{
			ApplyAnimationEx(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);
			return DrugFarmDestroyPlant(gSelectedDrugFarmPlant[playerid], true);
		}
		if(playertextid == TURFDRUGFARMINGTD[playerid][22]) return DrugFarmHarvest(playerid);
	}

	// Showroom By Wrox Development
	if(playertextid == SHOWROOMTD[playerid][22])
    {
        if(!pDealershipViewing[playerid]) return 0;
        BuyDealershipVehicle(playerid);
		
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][23])
    {
        if(!pDealershipViewing[playerid]) return 0;
        StartDealershipTestDrive(playerid);
		ShowTDN(playerid, "Vehicle TestDrive Started, 30 Secounds Reminder.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][24])
    {
        if(!pDealershipViewing[playerid]) return 0;
        ExitDealershipShowroom(playerid, true);
		ShowTDN(playerid, "Vehicle purchase failed. Your money was refunded.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][25])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SelectDealershipVehicle(playerid, 1);
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][26])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SelectDealershipVehicle(playerid, -1);
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][4])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 1);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][5])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 126);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][6])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 6);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][7])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 79);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][8])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 86);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }
    if(playertextid == SHOWROOMTD[playerid][9])
    {
        if(!pDealershipViewing[playerid]) return 0;
        SetDealershipColor(playerid, 3);
		ShowTDN(playerid, "Vehicle Color Applied.");
        return 1;
    }

	// weapon lic
	if(playertextid == WEAPONLIC[playerid][17])
	{
		for(new i = 0; i < 21; i ++)
		{
			PlayerTextDrawDestroy(playerid, WEAPONLIC[playerid][i]);
			CancelSelectTextDraw(playerid);
		}
		return 1;
	}


	// Player Registration Textdraw
    if(playertextid == REGISTERTD[playerid][18]) // PLAYER DATE OF BIRTH
    {
        if(PlayerRegisterStep[playerid] != REGISTER_STEP_DOB)
        {
            SCMf(playerid, COLOR_RED, "Complete previous registration steps first.");
            return 1;
        }

        ShowPlayerDialog(playerid, DIALOG_DATE_DAY, DIALOG_STYLE_INPUT, "Character Date Of Birth", "Enter Character Birth Day (1 - 31)", "Submit", "Cancel");
        return 1;
    }
    if(playertextid == REGISTERTD[playerid][23]) // PLAYER EMAIL
    {
        if(PlayerRegisterStep[playerid] != REGISTER_STEP_EMAIL)
        {
            SCMf(playerid, COLOR_RED, "Complete Date Of Birth first.");
            return 1;
        }

        ShowPlayerDialog(playerid, DIALOG_EMAIL,  DIALOG_STYLE_INPUT, "" SVRCLR"Email Address", ""WHITE"Enter your valid email address:\nExample: example@gmail.com", "Submit", "Back");
        return 1;
    }
    if(playertextid == REGISTERTD[playerid][33]) // PLAYER SEX
    {
        if(PlayerRegisterStep[playerid] != REGISTER_STEP_GENDER)
        {
            SCMf(playerid, COLOR_RED, "Complete Email first.");
            return 1;
        }

        ShowPlayerDialog(playerid, DIALOG_GENDER, DIALOG_STYLE_INPUT, ""SVRCLR"Character Gender",  ""WHITE"Select your gender:\n\n1 - Male\n2 - Female", "Submit","Back");
        return 1;
    }
	if(playertextid == REGISTERTD[playerid][24]) // REGISTER PASSWORD BUTTON
	{
        if(PlayerRegisterStep[playerid] != REGISTER_STEP_PASSWORD)
        {
            SCMf(playerid, COLOR_RED, "Complete Gender first.");
            return 1;
        }

        ShowDialogToPlayer(playerid, DIALOG_REGISTER);
        return 1;
	}
    if(playertextid == REGISTERTD[playerid][27]) // REGISTER COMPLETE BUTTON
    {
        if(PlayerRegisterStep[playerid] != REGISTER_STEP_FINISH)
        {
            SCMf(playerid, COLOR_RED, "Complete Password first.");
            return 1;
        }

        gTotalRegistered++;
        SaveServerInfo();
        for(new i = 0; i < 34; i ++)
        {
            PlayerTextDrawDestroy(playerid, REGISTERTD[playerid][i]);
            CancelSelectTextDraw(playerid);
        }


        SendClientMessage(playerid, COLOR_GREEN,"[DUBAI REGISTRATION] Registration completed successfully.");
		mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO users (username, password, birth_day, birth_month, birth_year, age, date_of_birth, email, gender, regdate, lastlogin, ip) VALUES('%e', '%e', %i, %i, %i, %i, '%e', '%e', %i, NOW(), NOW(), '%s')", GetPlayerNameEx(playerid), PlayerInfo[playerid][pPassword], PlayerInfo[playerid][pBirthDay], PlayerInfo[playerid][pBirthMonth], PlayerInfo[playerid][pBirthYear], PlayerInfo[playerid][pAge], PlayerInfo[playerid][pDateOfBirth], PlayerInfo[playerid][pEmail], PlayerInfo[playerid][pGender], GetPlayerIP(playerid));
		mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_ACCOUNT_REGISTER, playerid);

    }

	if(playertextid == JOBCENTERTD[playerid][26]) // farmer
	{
		PlayerInfo[playerid][pCP] = CHECKPOINT_MISC;
	    SetPlayerCheckpoint(playerid, jobLocations[JOB_FARMER][jobX], jobLocations[JOB_FARMER][jobY], jobLocations[JOB_FARMER][jobZ], 3.0);
	    SendClientMessage(playerid, COLOR_WHITE, "** Checkpoint marked at the location of the Farmer job.");
	}
	if(playertextid == JOBCENTERTD[playerid][38]) // oil exporter
	{

static GetSpeedColorZone(Float:s)
{
    if(s > 155.0) return 5;
    if(s > 140.0) return 4;
    if(s > 110.0) return 3;
    if(s > 80.0)  return 2;
    if(s > 50.0)  return 1;
    return 0;
}


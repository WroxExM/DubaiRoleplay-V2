forward OnAdminBan(playerid, username[], reason[], days);
public OnAdminBan(playerid, username[], reason[], days)
{
    if(cache_num_rows())
    {
        new
            uid,
            adminlevel,
            ip[32];

        cache_get_value_name_int(0, "uid", uid);
        cache_get_value_name_int(0, "adminlevel", adminlevel);

        cache_get_value_name(0, "ip", ip);

        if(adminlevel > PlayerInfo[playerid][pAdmin])
        {
            return SCMf(playerid, COLOR_SYNTAX, "You cannot ban higher admin.");
        }

        new unban = gettime() + (days * 86400);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET banned=1, banreason='%e', bantime='%d' WHERE uid='%d'", reason, unban, uid);
        mysql_tquery(connectionID, queryBuffer);


        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO bans (username, ip, bannedby, date, permanent, reason, days) VALUES ('%e', '%e', '%e', NOW(), '0', '%e', '%d')", username, ip, GetPlayerNameEx(playerid), reason, days);
        mysql_tquery(connectionID, queryBuffer);

        foreach(new i : Player)
        {
            if(!strcmp(GetPlayerNameEx(i), username, true))
            {
                new str[256];

                format(str, sizeof(str), "You have been banned by %s.\nDuration: %d day(s)\nReason: %s", GetPlayerNameEx(playerid), days, reason);
                SendClientMessage(i, COLOR_LIGHTRED, str);
                KickPlayer(i);

                break;
            }
        }



        SAM(COLOR_LIGHTRED, "AdmCmd: %s banned %s (%d days), reason: %s", GetPlayerNameEx(playerid), username, days, reason);

        // ========================================
        // DISCORD LOG
        // ========================================

        new
            DCC_Channel:channel,
            DCC_Embed:embed,
            desc[1024];

        format(desc, sizeof(desc),
		"```yaml\n\
			Ban Information\n\
			??????????????????????????\n\
			Banned Player       : %s\n\
			Player IP           : %s\n\
			Responsible Admin   : %s\n\
			Ban Duration        : %d Day(s)\n\
			Ban Reason          : %s\n\
			??????????????????????????\
			```",
        username,
        ip,
        GetPlayerNameEx(playerid),
        days,
        reason);

        channel = DCC_FindChannelById("1375346740546240585");
        embed = DCC_CreateEmbed("Ban Logs", desc);
        DCC_SetEmbedColor(embed, 0xFF0000);
        DCC_SetEmbedFooter(embed, "Administration System");

        DCC_SendChannelEmbedMessage(channel, embed);
    }
    else
    {
        SCMf(playerid, COLOR_SYNTAX, "Account does not exist.");
    }

    return 1;
}



forward OnAdminOfflineBan(playerid, username[], reason[]);
public OnAdminOfflineBan(playerid, username[], reason[])
{
	if(cache_num_rows())
	{
	    new
	        adminlevel,
	        uid,
	        ip[32];

	    cache_get_value_name_int(0, "adminlevel", adminlevel);
	    cache_get_value_name_int(0, "uid", uid);

	    cache_get_value_name(0, "ip", ip);

	    if(adminlevel > PlayerInfo[playerid][pAdmin])
	    {
	        return SendClientMessage(playerid, COLOR_SYNTAX,
	        "You cannot offline ban a higher level admin.");
	    }

	    // ADD BAN
	    AddBan(username, ip, GetPlayerNameEx(playerid), reason);

	    // UPDATE DATABASE
	    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),  "UPDATE users SET banned = 1, banreason = '%e' WHERE uid = %d",  reason, uid);
	    mysql_tquery(connectionID, queryBuffer);

	    SAM(COLOR_LIGHTRED, "AdmCmd: %s was offline banned by %s, reason: %s", username, GetPlayerNameEx(playerid), reason);

	    // DISCORD LOG SYSTEM
	    new
	        DCC_Channel:channel,
	        DCC_Embed:embed,
	        desc[1024],
	        timeStr[64],
	        dateStr[64];

	    GetISTDateTime(dateStr, sizeof(dateStr), timeStr, sizeof(timeStr));

		format(desc, sizeof(desc),
			"```yaml\n\
			Offline Ban Information\n\
			??????????????????????????\n\
			Banned Player       : %s\n\
			Player IP           : %s\n\
			Responsible Admin   : %s\n\
			Ban Reason          : %s\n\
			Ban Duration        : Permanent\n\
			Ban Time            : %s\n\
			Ban Date            : %s\n\
			??????????????????????????\
			```",
			username,
			ip,
			GetPlayerNameEx(playerid),
			reason,
			timeStr,
			dateStr
		);

	    channel = DCC_FindChannelById("1375346740546240585");
	    embed = DCC_CreateEmbed("Offline Ban Logs", desc);

	    // RED COLOR
	    DCC_SetEmbedColor(embed, 0xFF0000);
	    DCC_SetEmbedFooter(embed, "Administration System");
	    DCC_SendChannelEmbedMessage(channel, embed);
	}
	else
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "That account does not exist.");
	}

	return 1;
}

forward OnAdminOfflinePrison(playerid, username[], minutes, reason[]);

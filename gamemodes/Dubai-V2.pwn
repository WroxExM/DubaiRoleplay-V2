CMD:pl(playerid, params[])
{
	return ShowPublicLocker(playerid);
}

CMD:accesslocker(playerid, params[])
{
	new targetid;

	if(!IsLawEnforcement(playerid))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You are not law enforcement.");
	}
	if(!PlayerInfo[playerid][pDuty])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You are not on duty.");
	}
	if(sscanf(params, "u", targetid))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "Usage: /accesslocker [playerid]");
	}
	if(!IsPlayerConnected(targetid))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "Invalid player.");
	}
	if(targetid == playerid)
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You can't access your own locker this way.");
	}
	if(!PlayerInfo[targetid][pCuffed])
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "That player is not cuffed.");
	}
	if(!IsPlayerInRangeOfPlayer(playerid, targetid, 6.0))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You are too far away.");
	}

	SetPVarInt(playerid, "PublicLockerAccess", targetid);
	SetPVarInt(playerid, "PublicLockerAccessUID", PlayerInfo[targetid][pID]);
	SetPublicLockerOwner(playerid, targetid);

	SM(playerid, COLOR_LIGHTBLUE, "You now have temporary access to %s's public locker. Use /pl or press Y at a public locker.", GetRPName(targetid));
	return 1;
}

CMD:revokeaccess(playerid, params[])
{
	ClearPublicLockerAccess(playerid);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, "Locker access revoked.");
	return 1;
}


cmd:getweaponlic(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, 2060.582519, -1402.042968, 19.021265))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "You are not in range of the desk at Police Department.");
	}
	if(PlayerInfo[playerid][pWeaponLicense] == 1) 
	{
		return SendClientMessage(playerid, COLOR_GREY2, "You already Have an a weapon license.");
	}
	if(PlayerInfo[playerid][pCash] <300000)
	{
		return SendClientMessage(playerid, COLOR_GREY2, "You don't have 3 lakhs to buy the weapon license.");
	}

	PlayerInfo[playerid][pWeaponLicense] = 1;
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET gunlicense = %i WHERE uid = %i", PlayerInfo[playerid][pWeaponLicense], PlayerInfo[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer);
	GivePlayerMoney(playerid, -250000);

    new string[32];
    format(string, sizeof(string), "%s", PlayerInfo[playerid][pIDCard]);
    PlayerTextDrawSetString(playerid, WEAPONLIC[playerid][10], string);

    PlayerTextDrawSetString(playerid, WEAPONLIC[playerid][9], GetRPName(playerid));

    for(new i = 0; i < 21; i++)
    {
        PlayerTextDrawShow(playerid, WEAPONLIC[playerid][i]);
    }
    SelectTextDraw(playerid, COLOR_RED);

	SCMf(playerid, COLOR_WHITE, "** You Have Purchased a weapon license from the Police Station.", GetRPName(playerid));

	return 1;
}

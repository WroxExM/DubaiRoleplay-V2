        {
            return i;
        }
    }
    return -1;
}

stock DestroyGG(id)
{
    if(!(0 <= id < MAX_GGARAGE))
        return 0;

    if(GGInfo[id][ggText] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(GGInfo[id][ggText]);
        GGInfo[id][ggText] = Text3D:INVALID_3DTEXT_ID;
    }
    if(GGInfo[id][ggPickup] != -1)
    {
        DestroyDynamicPickup(GGInfo[id][ggPickup]);
        GGInfo[id][ggPickup] = -1;
    }
    if(GGInfo[id][ggMapIcon] != -1)
    {
        DestroyDynamicMapIcon(GGInfo[id][ggMapIcon]);
        GGInfo[id][ggMapIcon] = -1;
    }
    return 1;
}

stock GetNearbyGG(playerid)
{
    for(new i; i < MAX_GGARAGE; i++)
    {
        if(GGInfo[i][ggExists] && IsPlayerInRangeOfPoint(playerid, GGInfo[i][ggSize], GGInfo[i][ggPosX], GGInfo[i][ggPosY], GGInfo[i][ggPosZ]))
        {
            return i;
        }
    }
    return -1;
}

stock ReloadGG(id)
{
    if(!(0 <= id < MAX_GGARAGE) || !GGInfo[id][ggExists])
        return 0;

    DestroyGG(id);

    new gangid = GGInfo[id][ggGang], gangname[32] = "Unknown", string[500];

    if(0 <= gangid < MAX_GANGS && GangInfo[gangid][gSetup])
    {
        format(gangname, sizeof(gangname), "%s", GangInfo[gangid][gName]);
    }

    new colorhex[16];
    format(colorhex, sizeof(colorhex), "{%06x}", GangInfo[gangid][gColor] >>> 8);
    format(string, sizeof(string), "{9900FF}[Gang Garage]\n{FFFFFF}Gang: %s%s\n{FFFFFF}Press Y\nRadius: %.1fm", colorhex, gangname, GGInfo[id][ggSize]);
    GGInfo[id][ggText] = CreateDynamic3DTextLabel(string, -1, GGInfo[id][ggPosX], GGInfo[id][ggPosY], GGInfo[id][ggPosZ] + 0.5, 20.0);
    GGInfo[id][ggPickup] = CreateDynamicPickup(19133, 1, GGInfo[id][ggPosX], GGInfo[id][ggPosY], GGInfo[id][ggPosZ]);
    GGInfo[id][ggMapIcon] = CreateDynamicMapIcon(GGInfo[id][ggPosX], GGInfo[id][ggPosY], GGInfo[id][ggPosZ], 55, 0, -1, -1, -1, 300.0);

    return 1;
}


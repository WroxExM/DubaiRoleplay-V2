		case DIALOG_FUEL_EDITPRICE:
		{
			if(response)
			{
				new fuelid = GetNearbyFuelStation(playerid);
				new amount;

				if(sscanf(inputtext, "i", amount))
				{
					return SCMf(playerid, COLOR_SYNTAX, "Usage: Enter valid fuel price.");
				}

				if(amount < 1)
				{
					return SCMf(playerid, COLOR_SYNTAX, "Fuel price cannot be below $1.");
				}

				FuelInfo[fuelid][feFuelPrice] = amount;

				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE fuelstations SET fuelprice = %i WHERE id = %i", FuelInfo[fuelid][feFuelPrice], FuelInfo[fuelid][feID]);
				mysql_tquery(connectionID, queryBuffer);

				ReloadFuel(fuelid);

				ShowFuelControlUI(playerid, fuelid);

				SM(playerid, COLOR_AQUA, "Fuel litre price updated to $%s.", AddCommas(amount));
			}
		}
		case DIALOG_FUEL_WITHDRAW:
		{
			if(response)
			{
				new fuelid = GetNearbyFuelStation(playerid);
				new amount;

				if(sscanf(inputtext, "i", amount))
				{
					return SCMf(playerid, COLOR_SYNTAX, "Usage: Enter valid withdraw amount.");
				}

				if(amount < 1 || amount > FuelInfo[fuelid][feVault])
				{
					return SCMf(playerid, COLOR_SYNTAX, "Invalid withdraw amount.");
				}

				FuelInfo[fuelid][feVault] -= amount;

				GivePlayerCash(playerid, amount);

				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE fuelstations SET vault = %i WHERE id = %i", FuelInfo[fuelid][feVault], FuelInfo[fuelid][feID]);
				mysql_tquery(connectionID, queryBuffer);

				ShowFuelControlUI(playerid, fuelid);

				SM(playerid, COLOR_AQUA, "You withdrew $%s from the fuel station vault.", AddCommas(amount));
			}
		}

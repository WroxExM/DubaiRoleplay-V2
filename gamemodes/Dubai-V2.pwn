CMD:repairfactory(playerid, params[])
{
	new fid = GetNearbyFactory(playerid);
	if (fid == -1) return SM(playerid, COLOR_ERROR, "[Factory] You are not near a weapon factory.");
	if (!FactoryHasGangAccess(playerid, fid)) return SM(playerid, COLOR_ERROR, "[Factory] Your gang does not own this factory.");

	new missing = 100 - WeaponFactory[fid][wfHealth];
	if (missing <= 0) return SM(playerid, COLOR_ERROR, "[Factory] This factory is already fully repaired.");

	new kits  = (missing + 4) / 5;
	new parts = (missing + 9) / 10;
	new cost  = missing * 8000;

	new text[256];
	format(text, sizeof text,
		"Current Health: %d%%\nMissing Health: %d%%\n\n" \
		"Required Repair Kits: %d\nRequired Industrial Parts: %d\nRepair Cost: $%d\n\n" \
		"Restore factory to 100%%?",
		WeaponFactory[fid][wfHealth], missing, kits, parts, cost);
	WeaponFactoryPlayer[playerid][wfpFactory] = fid;
	ShowPlayerDialog(playerid, DIALOG_WF_REPAIR, DIALOG_STYLE_MSGBOX,
		"Factory Repair", text, "Repair", "Cancel");
	return 1;
}


CMD:createweaponfactory(playerid, params[])
{
	if (PlayerInfo[playerid][pAdmin] < 6) return SM(playerid, COLOR_ERROR, "Unauthorized.");

	new gangid;
	if (sscanf(params, "i", gangid)) return SM(playerid, COLOR_SYNTAX, "Usage: /createweaponfactory [gang_id]");
	if (!(0 <= gangid < MAX_GANGS)) return SM(playerid, COLOR_ERROR, "Invalid gang ID.");

	for (new i; i < MAX_WEAPON_FACTORIES; i++)
	{
		if (WeaponFactory[i][wfExists]) continue;

		GetPlayerPos(playerid, WeaponFactory[i][wfPosX], WeaponFactory[i][wfPosY], WeaponFactory[i][wfPosZ]);
		GetPlayerFacingAngle(playerid, WeaponFactory[i][wfPosA]);
		WeaponFactory[i][wfGangID] = gangid;
		format(WeaponFactory[i][wfOwnerName], 32, "%s", GangInfo[gangid][gName]);

		new q[384];
		mysql_format(connectionID, q, sizeof q,
			"INSERT INTO weapon_factories (gang_id,owner_name,pos_x,pos_y,pos_z,pos_a,health,status) \
			 VALUES (%d,'%e',%f,%f,%f,%f,%d,%d)",
			gangid, WeaponFactory[i][wfOwnerName],
			WeaponFactory[i][wfPosX], WeaponFactory[i][wfPosY], WeaponFactory[i][wfPosZ], WeaponFactory[i][wfPosA],
			100, STATUS_IDLE);
		mysql_tquery(connectionID, q, "CreateFactory", "ii", playerid, i);
		return 1;
	}
	return SM(playerid, COLOR_ERROR, "[Factory] Factory slots are full.");
}

CMD:setcratepos(playerid, params[])
{
	if (PlayerInfo[playerid][pAdmin] < 6) return SM(playerid, COLOR_ERROR, "Unauthorized.");

	new fid, slot, option[8];
	if (sscanf(params, "iiS()[8]", fid, slot, option))
		return SM(playerid, COLOR_SYNTAX, "Usage: /setcratepos [factory_id] [slot 1-3] [clear]");
	if (!(0 <= fid < MAX_WEAPON_FACTORIES) || !WeaponFactory[fid][wfExists]
	||  !(1 <= slot <= 3))
		return SM(playerid, COLOR_ERROR, "Invalid factory or slot.");

	slot--;
	if (!strcmp(option, "clear", true))
	{
		WeaponFactory[fid][wfCrateX][slot] = 0.0;
		WeaponFactory[fid][wfCrateY][slot] = 0.0;
		WeaponFactory[fid][wfCrateZ][slot] = 0.0;
	}
	else GetPlayerPos(playerid,
		WeaponFactory[fid][wfCrateX][slot],
		WeaponFactory[fid][wfCrateY][slot],
		WeaponFactory[fid][wfCrateZ][slot]);

	FactorySaveFactory(fid);
	SM(playerid, COLOR_GREEN, "[Factory] Crate slot %d updated for factory %d.", slot + 1, fid);
	return 1;
}

CMD:setweaponlocker(playerid, params[])
{
	return FactorySetWeaponLockerCommand(playerid, params);
}

CMD:createweaponlocker(playerid, params[])
{
	return FactorySetWeaponLockerCommand(playerid, params);

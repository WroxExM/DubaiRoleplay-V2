stock ClearPublicLockerAccess(playerid, bool:clearowner = true)
{
	DeletePVar(playerid, "PublicLockerAccess");
	DeletePVar(playerid, "PublicLockerAccessUID");
	if(clearowner)
	{
		DeletePVar(playerid, "PublicLockerOwner");
		DeletePVar(playerid, "PublicLockerOwnerUID");
	}
	return 1;
}

stock SetPublicLockerOwner(playerid, lockerid)
{
	SetPVarInt(playerid, "PublicLockerOwner", lockerid);
	SetPVarInt(playerid, "PublicLockerOwnerUID", PlayerInfo[lockerid][pID]);
	return 1;
}

stock RevokePLockerTarget(targetid)
{
	for(new i = 0; i < MAX_PLAYERS; i ++)
	{
	    if(IsPlayerConnected(i) && GetPVarType(i, "PublicLockerAccess") && GetPVarInt(i, "PublicLockerAccess") == targetid)
	    {
	        ClearPublicLockerAccess(i, false);
	        SendClientMessage(i, COLOR_SYNTAX, "Locker access removed. Suspect is no longer available.");
	    }
	}
	return 1;
}

stock GetPublicLockerOwner(playerid, bool:notify = true)
{
	if(GetPVarType(playerid, "PublicLockerAccess"))
	{
		new targetid = GetPVarInt(playerid, "PublicLockerAccess");

		if(!IsPlayerConnected(targetid) || PlayerInfo[targetid][pID] != GetPVarInt(playerid, "PublicLockerAccessUID"))
		{
			ClearPublicLockerAccess(playerid);
			if(notify) SendClientMessage(playerid, COLOR_SYNTAX, "Locker access removed. Suspect disconnected.");
			return INVALID_PLAYER_ID;
		}
		if(!PlayerInfo[targetid][pCuffed])
		{
			ClearPublicLockerAccess(playerid);
			if(notify) SendClientMessage(playerid, COLOR_SYNTAX, "Locker access removed. Suspect uncuffed.");
			return INVALID_PLAYER_ID;
		}
		if(!IsPlayerInRangeOfPlayer(playerid, targetid, 6.0))
		{
			ClearPublicLockerAccess(playerid);
			if(notify) SendClientMessage(playerid, COLOR_SYNTAX, "Locker access removed. You are too far away.");
			return INVALID_PLAYER_ID;
		}

		SetPublicLockerOwner(playerid, targetid);
		return targetid;
	}

	if(GetPVarType(playerid, "PublicLockerOwner") && GetPVarInt(playerid, "PublicLockerOwner") != playerid)
	{
		DeletePVar(playerid, "PublicLockerOwner");
		DeletePVar(playerid, "PublicLockerOwnerUID");
		if(notify) SendClientMessage(playerid, COLOR_SYNTAX, "Locker access removed.");
		return INVALID_PLAYER_ID;
	}

	SetPublicLockerOwner(playerid, playerid);
	return playerid;
}

stock IsPolicePublicLockerAccess(playerid, lockerid)
{
	return lockerid != INVALID_PLAYER_ID && lockerid != playerid && GetPVarType(playerid, "PublicLockerAccess") && GetPVarInt(playerid, "PublicLockerAccess") == lockerid;
}

stock SendPublicLockerAccessMessage(playerid, lockerid, const action[], const item[], amount = 0)
{
	if(!IsPolicePublicLockerAccess(playerid, lockerid))
	{
	    return 1;
	}

	if(amount > 0)
	{
		SendProximityMessage(playerid, 20.0, COLOR_GREEN, "[LOCKER ACCESS] %s %s %i %s from %s's public locker.", GetRPName(playerid), action, amount, item, GetRPName(lockerid));
	}
	else
	{
		SendProximityMessage(playerid, 20.0, COLOR_GREEN, "[LOCKER ACCESS] %s %s %s from %s's public locker.", GetRPName(playerid), action, item, GetRPName(lockerid));
	}
	return 1;
}

#define PUBLIC_LOCKER_RENT_7DAYS 5000
#define PUBLIC_LOCKER_RENT_15DAYS 50000
#define PUBLIC_LOCKER_RENT_30DAYS 100000

stock GetPublicLockerRentInfo(listitem, &days, &price)
{
	switch(listitem)
	{
		case 0:
		{
			days = 7;
			price = PUBLIC_LOCKER_RENT_7DAYS;
		}
		case 1:
		{
			days = 15;
			price = PUBLIC_LOCKER_RENT_15DAYS;
		}
		case 2:
		{
			days = 30;
			price = PUBLIC_LOCKER_RENT_30DAYS;
		}
		default:
		{
			days = 0;
			price = 0;
		}
	}
	return days > 0;
}

stock PublicLockerRentDaysLeft(playerid)
{
	if(PlayerInfo[playerid][pPublicLockerExpire] <= gettime())
	{
		return 0;
	}
	return ((PlayerInfo[playerid][pPublicLockerExpire] - gettime()) / 86400) + 1;
}

stock SavePublicLockerRent(playerid, days, price)
{
	new now = gettime(), base = PlayerInfo[playerid][pPublicLockerExpire];

	if(base < now)
	{
		base = now;
	}

	PlayerInfo[playerid][pPublicLockerExpire] = base + (days * 86400);
	GivePlayerCash(playerid, -price);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO publiclocker (uid, expiredate) VALUES(%i, %i) ON DUPLICATE KEY UPDATE expiredate = %i",
		PlayerInfo[playerid][pID], PlayerInfo[playerid][pPublicLockerExpire], PlayerInfo[playerid][pPublicLockerExpire]);
	mysql_tquery(connectionID, queryBuffer);

	SM(playerid, COLOR_LIGHTBLUE, "Public locker rented for %i day(s). You now have %i day(s) remaining.", days, PublicLockerRentDaysLeft(playerid));
	return ShowPublicLockerMenu(playerid, playerid);
}

forward OnPublicLockerRentLoaded(playerid, uid);
public OnPublicLockerRentLoaded(playerid, uid)
{
	if(!IsPlayerConnected(playerid) || PlayerInfo[playerid][pID] != uid)
	{
		return 1;
	}

	new rows, fields;
	cache_get_row_count(rows);
	cache_get_field_count(fields);

	if(rows)
	{
		cache_get_value_name_int(0, "expiredate", PlayerInfo[playerid][pPublicLockerExpire]);
	}
	else
	{
		PlayerInfo[playerid][pPublicLockerExpire] = 0;
	}

	if(PlayerInfo[playerid][pPublicLockerExpire] <= gettime())
	{
		return ShowPublicLockerRentDialog(playerid);
	}

	return ShowPublicLockerMenu(playerid, playerid);
}


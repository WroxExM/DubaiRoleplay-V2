	if(playertextid == FUELUI[playerid][6])
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        new fuelid = GetNearbyFuelStation(playerid);

        if(fuelid == -1)
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "You moved away from the fuel station.");
        }
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "You are not driving a vehicle.");
        }
        if(!VehicleHasEngine(vehicleid))
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "This vehicle cannot be refueled.");
        }
        if(GetVehicleFuelLevel(vehicleid) >= 100)
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "This vehicle already has full fuel.");
        }
        if(FuelInfo[fuelid][feStock] <= 0)
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "This fuel station is out of stock.");
        }
        if(GetVehicleParams(vehicleid, VEHICLE_ENGINE))
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "Turn off the engine first.");
        }
        if(PlayerInfo[playerid][pCash] < FuelInfo[fuelid][feFuelPrice])
        {
            HideFuelUI(playerid);
            return SCMf(playerid, COLOR_SYNTAX, "You don't have enough cash.");
        }
        if(PlayerInfo[playerid][pRefuel] != INVALID_VEHICLE_ID)
        {
            return SCMf(playerid, COLOR_SYNTAX, "You are already refueling.");
        }

        PlayerInfo[playerid][pRefuel] = vehicleid;
        PlayerInfo[playerid][pRefuelAmount] = 0;

        SendProximityMessage(playerid, 20.0, SERVER_COLOR, "** %s begins refueling their vehicle.", GetRPName(playerid));
        Dyuze(playerid, "Notice", "Refueling started.");
    }

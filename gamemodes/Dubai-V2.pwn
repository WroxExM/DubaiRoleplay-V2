			                return ShowDialogToPlayer(playerid, DIALOG_GANGAMMOBUY);
			            }
			            if(PlayerInfo[playerid][pHPAmmo] + amount > GetPlayerCapacity(playerid, CAPACITY_HPAMMO))
			            {

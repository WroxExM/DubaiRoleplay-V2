// Anti Cheat  Drizzy - Enhanced & Optimized

// Centralized exemption check for anticheat - returns 1 if player should be EXEMPT
stock IsPlayerACExempt(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(PlayerInfo[playerid][pAdmin] >= 2) return 1;           // Admins exempt
    if(PlayerInfo[playerid][pKicked]) return 1;                // Already being kicked
    if(!PlayerInfo[playerid][pLogged]) return 1;               // Not logged in
    if(PlayerInfo[playerid][pJoinedEvent]) return 1;           // In event
    if(PlayerInfo[playerid][pPaintball] > 0) return 1;        // In paintball
    if(PlayerInfo[playerid][pDueling] != INVALID_PLAYER_ID) return 1; // Dueling
    if(PlayerInfo[playerid][pAdminDuty]) return 1;             // Admin on duty
    if(PlayerInfo[playerid][pSpectating] != INVALID_PLAYER_ID) return 1; // Spectating
    if(InsideTut[playerid]) return 1;                          // In tutorial
    if(PlayerInfo[playerid][pJailTime] > 0) return 1;         // In jail
    if(PlayerInfo[playerid][pInjured]) return 1;               // Injured/respawning
    if(PlayerInfo[playerid][pHospital]) return 1;              // In hospital
    return 0;
}

// Helper: increment AC warning and kick/ban when threshold reached
stock AC_HandleWarning(playerid, const reason[], code)
{
    PlayerInfo[playerid][pACWarns]++;

    new str[256];
    format(str, sizeof(str), "[Nex-AC] %s[%d] cheat warning #%d: %s [code: %03d]", GetRPName(playerid), playerid, PlayerInfo[playerid][pACWarns], reason, code);
    SendAdminMessage(COLOR_RED, str);

    // Discord log
    new dcStr[256];
    format(dcStr, sizeof(dcStr), "[AC-WARN] %s (uid: %d) - %s [code: %03d] (warnings: %d/%d)", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], reason, code, PlayerInfo[playerid][pACWarns], MAX_ANTICHEAT_WARNINGS);
    SendDiscordMessage(2, dcStr);

    if(PlayerInfo[playerid][pACWarns] >= MAX_ANTICHEAT_WARNINGS)
    {
        // Ban for repeated cheating
        format(str, sizeof(str), "%s[%d] was banned by %s for repeated cheating: %s [code: %03d]", GetRPName(playerid), playerid, SERVER_BOT, reason, code);
        SendAdminMessage(COLOR_LIGHTRED, str);

        format(dcStr, sizeof(dcStr), "[AC-BAN] %s (uid: %d) banned for repeated cheating: %s [code: %03d]", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], reason, code);
        SendDiscordMessage(2, dcStr);

        format(str, sizeof(str), "Anti-Cheat: %s [code: %03d]", reason, code);
        BanPlayer(playerid, SERVER_BOT, str);
    }
    return 1;
}

stock loadAntiCheatSettings()
{
	printf("[LoadAntiCheat] Loading data from database...");
    mysql_tquery(connectionID, "SELECT `ac_code`, `ac_code_trigger_type` FROM `anticheat_settings`", "UploadAntiCheat");
}

forward UploadAntiCheat();
public UploadAntiCheat()
{
    new rows = cache_num_rows(), tick = GetTickCount();

	if (!rows)
	{
        print("[MySQL]: Anti-cheat settings were not found in the database. Loading of the mod stopped - configure anti-cheat. ");
        return GameModeExit();
    }

    // Missing settings are safest when disabled. Map rows by ac_code instead of
    // relying on MySQL returning them in array order.
    for(new code = 0; code < AC_MAX_CODES; code++)
    {
        AC_CODE_TRIGGER_TYPE[code] = AC_CODE_TRIGGER_TYPE_DISABLED;
        EnableAntiCheat(code, 0);
    }

    for(new row = 0; row < rows; row++)
    {
        new code, trigger_type;
        cache_get_value_name_int(row, "ac_code", code);
        cache_get_value_name_int(row, "ac_code_trigger_type", trigger_type);

        if(code < 0 || code >= AC_MAX_CODES)
        {
            printf("[ANTICHEAT]: Ignoring invalid database code %i (row %i).", code, row);
            continue;
        }

        if(trigger_type < AC_CODE_TRIGGER_TYPE_DISABLED || trigger_type >= AC_MAX_TRIGGER_TYPES)
        {
            printf("[ANTICHEAT]: Invalid trigger type %i for code %03i; disabling it.", trigger_type, code);
            trigger_type = AC_CODE_TRIGGER_TYPE_DISABLED;
        }

        AC_CODE_TRIGGER_TYPE[code] = trigger_type;
        EnableAntiCheat(code, trigger_type != AC_CODE_TRIGGER_TYPE_DISABLED);
    }

    new mes[128];
    format(mes, sizeof(mes), "[ANTICHEAT]: Anti-cheat settings loaded successfully (loaded: %i). Time: %i ??.", rows, GetTickCount() - tick);
    print(mes);

    return 1;
}

forward OnCheatDetected(playerid, const ip_address[], type, code);
public OnCheatDetected(playerid, const ip_address[], type, code)
{
    if(code < 0 || code >= AC_MAX_CODES)
    {
        printf("[ANTICHEAT]: Ignored out-of-range detection code %i (type %i, player %i).", code, type, playerid);
        return 1;
    }

    // IP-based detections (type == 1): always act - block the IP
    if(type == AC_GLOBAL_TRIGGER_TYPE_IP)
    {
        AC_CODE_TRIGGERED_COUNT[code]++;
        new str[196];
        format(str, sizeof(str), "<AC-BAN-IP> IP address %s was blocked for 60s: %s [code: %03d].", ip_address, AC_CODE_NAME[code], code);
        SendAdminMessage(COLOR_RED, str);

        new dcStr[256];
        format(dcStr, sizeof(dcStr), "[AC-IP-BLOCK] IP %s blocked: %s [code: %03d]", ip_address, AC_CODE_NAME[code], code);
        SendDiscordMessage(2, dcStr);

        BlockIpAddress(ip_address, 60 * 1000);
        return 1;
    }

    // === Player-based detections (type == 0) ===

    // Exempt players: admins, events, paintball, duels, spectating, tutorial, jail, injured
    if(IsPlayerACExempt(playerid)) return 1;

    // Check DB trigger setting for this code
    new trigger_type = AC_CODE_TRIGGER_TYPE[code];

    // Specific code exemptions (codes that commonly false-positive)
    switch(code)
    {
        case 5: return 1;   // Teleport (vehicle to player) - too many false positives
        case 6: return 1;   // Teleport (pickups) - legit pickup positions vary
        case 22: return 1;  // Lagcomp-spoof - common with open.mp
        case 33: return 1;  // UnFreeze - legitimate unfreeze calls
    }

    // Anti-flood: don't process same code too rapidly
    if(gettime() - pAntiCheatLastCodeTriggerTime[playerid][code] < AC_TRIGGER_ANTIFLOOD_TIME)
        return 1;

    pAntiCheatLastCodeTriggerTime[playerid][code] = gettime();
    AC_CODE_TRIGGERED_COUNT[code]++;

    switch(trigger_type)
    {
        case AC_CODE_TRIGGER_TYPE_DISABLED: return 1;

        case AC_CODE_TRIGGER_TYPE_WARNING:
        {
            AC_HandleWarning(playerid, AC_CODE_NAME[code], code);
        }

        case AC_CODE_TRIGGER_TYPE_KICK:
        {
            new str[196], dcStr[256];

            format(str, sizeof(str), "%s[%d] was kicked by %s: %s [code: %03d].", GetRPName(playerid), playerid, SERVER_BOT, AC_CODE_NAME[code], code);
            SendAdminMessage(COLOR_RED, str);

            format(dcStr, sizeof(dcStr), "[AC-KICK] %s (uid: %d) kicked: %s [code: %03d]", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], AC_CODE_NAME[code], code);
            SendDiscordMessage(2, dcStr);

            SM(playerid, -1, "You were kicked on suspicion of using cheat programs: %s [code: %03d].", AC_CODE_NAME[code], code);
            AntiCheatKickWithDesync(playerid, code);
        }

        case AC_CODE_TRIGGER_TYPE_BAN:
        {
            new str[196], dcStr[256];

            format(str, sizeof(str), "%s[%d] was banned by %s: %s [code: %03d].", GetRPName(playerid), playerid, SERVER_BOT, AC_CODE_NAME[code], code);
            SendAdminMessage(COLOR_RED, str);

            format(dcStr, sizeof(dcStr), "[AC-BAN] %s (uid: %d) banned: %s [code: %03d]", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], AC_CODE_NAME[code], code);
            SendDiscordMessage(2, dcStr);

            format(str, sizeof(str), "Anti-Cheat: %s [code: %03d]", AC_CODE_NAME[code], code);
            BanPlayer(playerid, SERVER_BOT, str);
        }
    }
    return 1;
}




stock ShowPlayer_AntiCheatSettings(playerid)
{
    static
        dialog_string[42 + 19 - 8 + (AC_MAX_CODE_LENGTH + AC_MAX_CODE_NAME_LENGTH + AC_MAX_TRIGGER_TYPE_NAME_LENGTH + 10)*AC_MAX_CODES_ON_PAGE] = EOS;

    new
        triggeredCount = 0,
        page = pAntiCheatSettingsPage{playerid},
        next = 0,
        index = 0;

    dialog_string = "Name\tPunishment\tNumber of positives\n";

    for(new i = 0; i < AC_MAX_CODES; i++)
    {
        if (i >= (page * AC_MAX_CODES_ON_PAGE) && i < (page * AC_MAX_CODES_ON_PAGE) + AC_MAX_CODES_ON_PAGE)
            next++;

        if (i >= (page - 1) * AC_MAX_CODES_ON_PAGE && i < ((page - 1) * AC_MAX_CODES_ON_PAGE) + AC_MAX_CODES_ON_PAGE)
        {
            triggeredCount = AC_CODE_TRIGGERED_COUNT[i];

            format(dialog_string, sizeof(dialog_string), "%s[%s] %s\t%s\t%d\n",
                dialog_string,
                AC_CODE[i],
                AC_CODE_NAME[i],
                AC_TRIGGER_TYPE_NAME[AC_CODE_TRIGGER_TYPE[i]],
                triggeredCount);

            pAntiCheatSettingsMenuListData[playerid][index++] = i;
        }
    }

    if (next)
        strcat(dialog_string, ""AC_DIALOG_NEXT_PAGE_TEXT"\n");

    if (page > 1)
        strcat(dialog_string, AC_DIALOG_PREVIOUS_PAGE_TEXT);

    return ShowPlayerDialog(playerid, ANTICHEAT_SETTINGS, DIALOG_STYLE_TABLIST_HEADERS, "Anti-cheat settings", dialog_string, "Select", "Cancel");
}

//The function of showing the menu for editing the type of triggering of a certain code in anti-cheat
stock ShowPlayer_AntiCheatEditCode(playerid, code)
{
    new
        dialog_header[22 - 4 + AC_MAX_CODE_LENGTH + AC_MAX_CODE_NAME_LENGTH],
        dialog_string[AC_MAX_TRIGGER_TYPE_NAME_LENGTH*AC_MAX_TRIGGER_TYPES];

    format(dialog_header, sizeof(dialog_header), "Code: %s | Name: %s", AC_CODE[code], AC_CODE_NAME[code]); //????????

    for(new i = 0; i < AC_MAX_TRIGGER_TYPES; i++)
    {
        strcat(dialog_string, AC_TRIGGER_TYPE_NAME[i]);

        if (i + 1 != AC_MAX_TRIGGER_TYPES)
            strcat(dialog_string, "\n");
    }

    return ShowPlayerDialog(playerid, ANTICHEAT_EDIT_CODE, DIALOG_STYLE_LIST, dialog_header, dialog_string, "Select", "Return");
}


public OnPlayerOfflineKickGang(playerid, username[])
{
	new kickGang, kickGangRank;
	if(cache_num_rows())
	{
		cache_get_value_index_int(0, 1, kickGang);
		cache_get_value_index_int(0, 2, kickGangRank);
	}

    if(!cache_num_rows())
	{
	    SendClientMessage(playerid, COLOR_SYNTAX, "The player specified doesn't exist.");

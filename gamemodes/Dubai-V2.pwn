					return ShowPlayerDialog(playerid, DIALOG_BANKDEPOSIT, DIALOG_STYLE_INPUT, "{3B82F6}OKOK Banking {FFFFFF}- Deposit", "{FFFFFF}Enter deposit amount.", "Deposit", "Cancel");

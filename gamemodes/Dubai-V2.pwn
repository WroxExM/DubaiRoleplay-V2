    }
    if(PlayerInfo[playerid][pAdmin] >= 6)
    {
        strcat(str, "\n{FF7A59}[GRAND-6] Grand Administrator:");
        strcat(str, "\n{FFC0B0} /makehelper, /omakeadmin, /omakehelper, /setmotd, /forceaduty, /oadmins");
        strcat(str, "\n{FFC0B0} /olisthelpers, /sellinactive, /changelist, /fixplayerid, /reloadlands");
    }
    if(PlayerInfo[playerid][pAdmin] >= 7)
    {
        strcat(str, "\n{00D4AA}[MAP-7] Mappers:");
        strcat(str, "\n{A6FFF0} /forcepayday, /anticheat, /doublexp, /setformeradmin, /dre");
    }
    if(PlayerInfo[playerid][pAdmin] >= 8)
    {
        strcat(str, "\n{00A86B}[LDEV-8] Lead Developers:");
        strcat(str, "\n{A2FFD8} /deleteaccount, /forcepayday, /setstat, /anticheat, /doublexp, /setstaff, /settitle, /makeadmin, /omakeadmin, /setformeradmin");
    }
    if(PlayerInfo[playerid][pAdmin] >= 9)
    {
        strcat(str, "\n{FFD166}[DOF-9] Dept. of Faction:");
        strcat(str, "\n{FFF1B8} /entirecheck, /createbog, /togobb, /cpuload, /setcode");
    }
    if(PlayerInfo[playerid][pAdmin] >= 10)
    {
        strcat(str, "\n{EF476F}[DOG-10] Dept. of Gang:");
        strcat(str, "\n{FFB3C5} /citysf, /doublexp, /dumpprofiler, /seepass, /listadmins");

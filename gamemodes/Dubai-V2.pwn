    if(playertextid == PHONEDAILER[playerid][67])     // DAILER CALL BUTTON
    {
        PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

        new number = strval(DialerNumber[playerid]);

        if(number < 1)
        {
            return SendClientMessage(playerid, -1, "Invalid Number");
        }
        if(PlayerInfo[playerid][pCallLine] != INVALID_PLAYER_ID)
        {
            return SendClientMessage(playerid, -1, "You are already in a call.");
        }
        if(number == PlayerInfo[playerid][pPhone])
        {
            return SendClientMessage(playerid, -1, "Invalid Number.");
        }
		if(PlayerInfo[playerid][pSIM] == SIM_NONE)
		{
			return SendClientMessage(playerid, COLOR_SYNTAX, "You don't have a SIM card.");
		}
		if(PlayerInfo[playerid][pLoad] <= 0 || PlayerInfo[playerid][pLoadExpiry] < gettime())
		{
			return SendClientMessage(playerid, COLOR_SYNTAX, "You don't have enough load or your load has expired.");
		}
        foreach(new i : Player)
		{
			if(PlayerInfo[i][pPhone] == number)
			{
				if(PlayerInfo[i][pSIM] == SIM_NONE)
				{
					return SendClientMessage(playerid, COLOR_SYNTAX, "That player doesn't have a SIM card.");
				}
				if(PlayerInfo[i][pLoad] <= 0 || PlayerInfo[i][pLoadExpiry] < gettime())
				{
					return SendClientMessage(playerid, COLOR_SYNTAX, "That player's SIM has no active recharge.");
				}
				if(PlayerInfo[i][pTogglePhone])
				{
					return SendClientMessage(playerid, -1, "That player's phone is switched off.");
				}

				PlayerInfo[playerid][pCallLine] = i;
				PlayerInfo[playerid][pCallStage] = 0;

				PlayerInfo[i][pCallLine] = playerid;
				PlayerInfo[i][pCallStage] = 1;

				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
				SendProximityMessage(playerid, 20.0, SERVER_COLOR, "** %s dials a number on their keypad and begins a call.", GetRPName(playerid));


				PlayerTextDrawSetString(playerid, BANKTD[playerid][89], str);

				SendProximityMessage(playerid, 20.0, COLOR_GLOBAL, "** %s deposits some cash into their OKOK bank account.", GetRPName(playerid));
				SCMf(playerid, COLOR_LIGHTBLUE, "[OKOK BANKING] You deposited %s. New bank balance: %s.", FormatNumber(amount), FormatNumber(PlayerInfo[playerid][pBank]));

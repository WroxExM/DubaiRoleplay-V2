				SendProximityMessage(playerid, 20.0, COLOR_GLOBAL, "** %s transfers some money using OKOK Banking.", GetRPName(playerid));

				SCMf(playerid, COLOR_LIGHTBLUE, "[OKOK BANKING] You transferred %s to %s.", FormatNumber(amount), GetRPName(id));
				SCMf(id, COLOR_LIGHTBLUE, "[OKOK BANKING] %s transferred %s to your account.", GetRPName(playerid), FormatNumber(amount));

				DeletePVar(playerid, "transfer_id");
			}

	if(dialogid == DIALOG_GETIDCARD)
	{
		if(!response)
			return 1;

		if(GetPlayerMoney(playerid) < 10000)
		{
			SCMf(playerid, COLOR_RED, "You don't have enough money.");
			return 1;
		}
		if(PlayerInfo[playerid][pIDCard1] == 1)
		{
			SCMf(playerid, COLOR_RED, "You already own an ID Card.");
			return 1;
		}

		GivePlayerMoney(playerid, -10000);
		static const chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
		for(new i = 0; i < 8; i++)
		{
			PlayerInfo[playerid][pIDCard][i] = chars[random(sizeof(chars) - 1)];
		}
		PlayerInfo[playerid][pIDCard][8] = '\0';

		new year, month, day;
		getdate(year, month, day);
		format(PlayerInfo[playerid][pIDCardDate], 32, "%02d/%02d/%d", day, month, year );

		PlayerInfo[playerid][pIDCard1] = 1;

		mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET pIDCard1='%d', idcard='%e', idcard_date='%e' WHERE uid='%d'", PlayerInfo[playerid][pIDCard1], PlayerInfo[playerid][pIDCard], PlayerInfo[playerid][pIDCardDate], PlayerInfo[playerid][pID]);
		mysql_tquery(connectionID, queryBuffer);

		printf("Saved ID Card -> %s | %s | HasCard: %d | SQL ID: %d", PlayerInfo[playerid][pIDCard], PlayerInfo[playerid][pIDCardDate], PlayerInfo[playerid][pIDCard1], PlayerInfo[playerid][pID]);

		// Message
		new string[256];
		format(string, sizeof(string), "You purchased an ID Card.\nID: %s\nIssued Date: %s", PlayerInfo[playerid][pIDCard], PlayerInfo[playerid][pIDCardDate]);
		SCMf(playerid, COLOR_GREEN, string);

		Inventory_Set(playerid, "IDCard", 1581, PlayerInfo[playerid][pIDCard1]);
		return 1;
	}


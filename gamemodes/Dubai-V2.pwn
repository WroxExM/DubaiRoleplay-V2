CMD:getcocaine(playerid) {
	if(!IsPlayerInRangeOfPoint(playerid, 6.0, 1542.924194, 1667.241088, 700.968017))	return 1;
	if(gettime() - PlayerInfo[playerid][pLastSell] < 15)
	{

new tmpobjid;
new bool:gMappingsLoaded;
new bool:gMappingsLoading;

forward LoadMappings_Batch(batchid);

stock LoadMappings()
{
    if(gMappingsLoaded || gMappingsLoading)
    {
        return 1;
    }

    gMappingsLoading = true;
    SetTimerEx("LoadMappings_Batch", 250, false, "i", 1);
    return 1;
}

public LoadMappings_Batch(batchid)
{
    // Flush queued objects into the streamer between batches so the next
    // batch does not stack on top of an unprocessed backlog.  Without this
    // the streamer's internal queue grows to thousands of pending items and
    // players see objects pop in long after the loading phase is "done".
    Streamer_ProcessActiveItems();

    switch(batchid)
    {
        case 1: LoadMappings1();
        case 2: LoadMappings2();
        case 3: LoadMappings3();
        case 4: LoadMappings4();
        case 5: LoadMappings5();
        case 6: LoadMappings6();
        case 7: LoadMappings7();
        case 8: LoadMappings8();
        case 9: LoadMappings9();
        case 10: LoadMappings10();
        case 11: LoadMappings11();
        default:
        {
            gMappingsLoading = false;
            gMappingsLoaded = true;
            Streamer_ProcessActiveItems();
            return 1;
        }
    }

    if(batchid < 11)
    {
        SetTimerEx("LoadMappings_Batch", 250, false, "i", batchid + 1);
    }
    else
    {
        gMappingsLoading = false;
        gMappingsLoaded = true;
        Streamer_ProcessActiveItems();
    }

    return 1;
}

